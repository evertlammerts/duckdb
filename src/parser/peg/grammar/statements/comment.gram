CommentStatement <- 'COMMENT' 'ON' CommentOnEntry 'IS' CommentValue

CommentOnEntry <- CommentOnTableMacroEntry / CommentOnFunctionEntry / CommentOnTypeEntry / CommentOnObjectEntry
CommentOnTableMacroEntry <- CommentMacroTable CommentTableMacroTarget
CommentOnFunctionEntry <- CommentOnFunctionType CommentFunctionTarget
CommentOnTypeEntry <- CommentType CommentTypeTarget
CommentOnObjectEntry <- CommentOnObjectType CommentTarget

CommentTarget <- DottedIdentifier / CommentStringLiteralIdentifier
CommentStringLiteralIdentifier <- StringLiteralIdentifier
CommentFunctionTarget <- CommentTarget / CommentFunctionName
CommentFunctionName <- FunctionName
CommentTableMacroTarget <- CommentTarget / CommentTableFunctionName
CommentTableFunctionName <- TableFunctionName
CommentTypeTarget <- CommentTarget / CommentTypeName
CommentTypeName <- TypeName

CommentOnFunctionType <- CommentFunction / CommentMacro
CommentOnObjectType <- CommentTable / CommentSequence / CommentView / CommentDatabase / CommentIndex / CommentSchema / CommentColumn

CommentTable <- 'TABLE'
CommentSequence <- 'SEQUENCE'
CommentFunction <- 'FUNCTION'
CommentMacroTable <- 'MACRO' 'TABLE'
CommentMacro <- 'MACRO'
CommentView <- 'VIEW'
CommentDatabase <- 'DATABASE'
CommentIndex <- 'INDEX'
CommentSchema <- 'SCHEMA'
CommentType <- 'TYPE'
CommentColumn <- 'COLUMN'

CommentValue <- NullLiteral / StringLiteralValue
StringLiteralValue <- StringLiteral
