CreateTypeStmt <- 'TYPE' IfNotExists? CreateTypeName 'AS' CreateType
CreateTypeName <- QualifiedName / TypeNameAsQualifiedName
CreateType <- EnumSelectType / EnumStringLiteralList / CreateTypeFromType
CreateTypeFromType <- Type
EnumSelectType <- 'ENUM' Parens(SelectStatementInternal)
EnumStringLiteralList <- 'ENUM' Parens(List(StringLiteral)?) ArrayBounds*
