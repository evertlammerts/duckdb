query III
SELECT type, count(*), bool_and(ok) FROM (
SELECT type, finalize(to_aggregate_state({'count': count, 'value': value::BIGINT}, 'avg', ['SMALLINT'])) = expected::DOUBLE AS ok FROM imported_states WHERE type = 'SMALLINT'
UNION ALL
SELECT type, finalize(to_aggregate_state({'count': count, 'value': value::BIGINT}, 'avg', ['DECIMAL(4,2)'])) = expected::DOUBLE AS ok FROM imported_states WHERE type = 'DECIMAL(4,2)'
UNION ALL
SELECT type, finalize(to_aggregate_state({'count': count, 'value': value::HUGEINT}, 'avg', ['INTEGER'])) = expected::DOUBLE AS ok FROM imported_states WHERE type = 'INTEGER'
UNION ALL
SELECT type, finalize(to_aggregate_state({'count': count, 'value': value::HUGEINT}, 'avg', ['DECIMAL(9,4)'])) = expected::DOUBLE AS ok FROM imported_states WHERE type = 'DECIMAL(9,4)'
UNION ALL
SELECT type, finalize(to_aggregate_state({'count': count, 'value': value::HUGEINT}, 'avg', ['BIGINT'])) = expected::DOUBLE AS ok FROM imported_states WHERE type = 'BIGINT'
UNION ALL
SELECT type, finalize(to_aggregate_state({'count': count, 'value': value::HUGEINT}, 'avg', ['DECIMAL(18,6)'])) = expected::DOUBLE AS ok FROM imported_states WHERE type = 'DECIMAL(18,6)'
UNION ALL
SELECT type, finalize(to_aggregate_state({'count': count, 'value': value::HUGEINT}, 'avg', ['HUGEINT'])) = expected::DOUBLE AS ok FROM imported_states WHERE type = 'HUGEINT'
UNION ALL
SELECT type, finalize(to_aggregate_state({'count': count, 'value': value::HUGEINT}, 'avg', ['DECIMAL(38,0)'])) = expected::DOUBLE AS ok FROM imported_states WHERE type = 'DECIMAL(38,0)'
UNION ALL
SELECT type, finalize(to_aggregate_state({'count': count, 'value': value::HUGEINT}, 'avg', ['DECIMAL(38,10)'])) = expected::DOUBLE AS ok FROM imported_states WHERE type = 'DECIMAL(38,10)'
UNION ALL
SELECT type, finalize(to_aggregate_state({'count': count, 'value': value::HUGEINT}, 'avg', ['DECIMAL(38,15)'])) = expected::DOUBLE AS ok FROM imported_states WHERE type = 'DECIMAL(38,15)'
UNION ALL
SELECT type, finalize(to_aggregate_state({'count': count, 'value': value::HUGEINT}, 'avg', ['DECIMAL(38,16)'])) = expected::DOUBLE AS ok FROM imported_states WHERE type = 'DECIMAL(38,16)'
UNION ALL
SELECT type, finalize(to_aggregate_state({'count': count, 'value': value::HUGEINT}, 'avg', ['DECIMAL(38,19)'])) = expected::DOUBLE AS ok FROM imported_states WHERE type = 'DECIMAL(38,19)'
UNION ALL
