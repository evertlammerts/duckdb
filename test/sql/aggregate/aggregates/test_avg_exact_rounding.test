# name: test/sql/aggregate/aggregates/test_avg_exact_rounding.test
# description: avg over an integer or decimal sum is the DOUBLE nearest to sum / (count * 10^scale), rounded once
# group: [aggregates]

# Results are compared as text, because the test runner accepts a DOUBLE result within a tolerance. Every avg here is
# grouped, windowed or finalized from a state, since an ungrouped avg is planned as sum / count.

# 2**126 + 2**73 + 1 is just above a DOUBLE midpoint, so one row averages to the value rounded up, as the cast does
statement ok
CREATE TABLE single(v HUGEINT);

statement ok
INSERT INTO single VALUES
	(85070591730234625310576617597232480257),
	(-85070591730234625310576617597232480257),
	(170141183460469231731687303715884105727),
	(-170141183460469231731687303715884105728),
	(9007199254740993),
	(0),
	(NULL);

query III
SELECT v, avg(v)::VARCHAR, avg(v) = v::DOUBLE FROM single GROUP BY v ORDER BY v
----
-170141183460469231731687303715884105728	-1.7014118346046923e+38	true
-85070591730234625310576617597232480257	-8.507059173023463e+37	true
0	0.0	true
9007199254740993	9007199254740992.0	true
85070591730234625310576617597232480257	8.507059173023463e+37	true
170141183460469231731687303715884105727	1.7014118346046923e+38	true
NULL	NULL	NULL

query II
SELECT v, avg(TRY_CAST(v AS DECIMAL(38,0)))::VARCHAR FROM single GROUP BY v ORDER BY v
----
-170141183460469231731687303715884105728	NULL
-85070591730234625310576617597232480257	-8.507059173023463e+37
0	0.0
9007199254740993	9007199254740992.0
85070591730234625310576617597232480257	8.507059173023463e+37
170141183460469231731687303715884105727	NULL
NULL	NULL

# The exact averages are 2**125 + 2**72 + 1/2 and its negation, just past the midpoint 2**125 + 2**72
query II
SELECT g, avg(v)::VARCHAR
FROM (VALUES
	(1, 42535295865117312655288308798616240128::HUGEINT),
	(1, 42535295865117312655288308798616240129::HUGEINT),
	(2, -42535295865117312655288308798616240128::HUGEINT),
	(2, -42535295865117312655288308798616240129::HUGEINT)
) t(g, v)
GROUP BY g ORDER BY g
----
1	4.253529586511732e+37
2	-4.253529586511732e+37

# One DECIMAL row averages to its cast: 2**91 + 2**38 is a midpoint, the scale 28 values need 10**28 exactly
query III
SELECT x, avg(x)::VARCHAR, avg(x) = x::DOUBLE
FROM (VALUES
	('2475880078570760824676155392.0000000001'::DECIMAL(38,10)),
	('-2475880078570760824676155392.0000000001'::DECIMAL(38,10))
) t(x)
GROUP BY x ORDER BY x
----
-2475880078570760824676155392.0000000001	-2.475880078570761e+27	true
2475880078570760824676155392.0000000001	2.475880078570761e+27	true

query III
SELECT x, avg(x)::VARCHAR, avg(x) = x::DOUBLE
FROM (VALUES
	('0.0000000000000000000000049976'::DECIMAL(38,28)),
	('-7195106750.2323783214747598745883015072'::DECIMAL(38,28))
) t(x)
GROUP BY x ORDER BY x
----
-7195106750.2323783214747598745883015072	-7195106750.232378	true
0.0000000000000000000000049976	4.9976e-24	true

# Three BIGINT rows whose sum passes 2**64 go through the HUGEINT state; rounding the sum to a DOUBLE first, or the
# quotient to a 64 bit long double first, gives 9.223372036854333e+18
query I
SELECT avg(v)::VARCHAR FROM (VALUES (1, 9223372036853847642), (1, 9223372036854550076), (1, 9223372036854601065)) t(g, v)
GROUP BY g
----
9.223372036854332e+18

# An INTEGER state repeated past 2**53 rows
query I
SELECT finalize(combine_aggr(st, 9007199254740993))::VARCHAR
FROM (SELECT avg(v) EXPORT_STATE st FROM (VALUES (2147483647), (2147483647), (0)) t(v) GROUP BY ALL)
----
1431655764.6666667

# Counts past 2**53: 2**53 rows of 1 and one of 0 average to 1 - 2**-53, also for SMALLINT and DECIMAL(4, s)
statement ok
CREATE TABLE counts AS SELECT * FROM (VALUES (1, 9007199254740992), (0, 1)) v(x, n);

query IIIII
SELECT (SELECT finalize(combine_aggr(st, n))::VARCHAR FROM (SELECT avg(x::SMALLINT) EXPORT_STATE st, n FROM counts GROUP BY ALL)),
       (SELECT finalize(combine_aggr(st, n))::VARCHAR FROM (SELECT avg(x::DECIMAL(4,2)) EXPORT_STATE st, n FROM counts GROUP BY ALL)),
       (SELECT finalize(combine_aggr(st, n))::VARCHAR FROM (SELECT avg(x::BIGINT) EXPORT_STATE st, n FROM counts GROUP BY ALL)),
       (SELECT finalize(combine_aggr(st, n))::VARCHAR FROM (SELECT avg(x::HUGEINT) EXPORT_STATE st, n FROM counts GROUP BY ALL)),
       (SELECT finalize(combine_aggr(st, n))::VARCHAR FROM (SELECT avg(x::DECIMAL(38,10)) EXPORT_STATE st, n FROM counts GROUP BY ALL))
----
0.9999999999999999	0.9999999999999999	0.9999999999999999	0.9999999999999999	0.9999999999999999

# A state of 2**53 + 1 rows whose average is just above the midpoint (2**53 + 1) * 2**20, and one just below it
query II
SELECT finalize(to_aggregate_state({'count': 9007199254740993, 'value': 85070591730234634755309583336523956225::HUGEINT}, 'avg', ['HUGEINT']))::VARCHAR,
       finalize(to_aggregate_state({'count': 9007199254740993, 'value': 85070591730234634755309583336523956223::HUGEINT}, 'avg', ['HUGEINT']))::VARCHAR
----
9.444732965739293e+21	9.44473296573929e+21

# The largest count and the largest sum, with a divisor of up to (2**64 - 1) * 10**38
query IIII
SELECT finalize(to_aggregate_state({'count': 18446744073709551615, 'value': 170141183460469231731687303715884105727::HUGEINT}, 'avg', ['HUGEINT']))::VARCHAR,
       finalize(to_aggregate_state({'count': 18446744073709551615, 'value': '-170141183460469231731687303715884105728'::HUGEINT}, 'avg', ['DECIMAL(38,0)']))::VARCHAR,
       finalize(to_aggregate_state({'count': 18446744073709551615, 'value': 170141183460469231731687303715884105727::HUGEINT}, 'avg', ['DECIMAL(38,38)']))::VARCHAR,
       finalize(to_aggregate_state({'count': 18446744073709551615, 'value': 1::HUGEINT}, 'avg', ['DECIMAL(38,38)']))::VARCHAR
----
9.223372036854776e+18	-9.223372036854776e+18	9.223372036854775e-20	5.421010862427522e-58

# Only the remainder of the first factor (count * 10**1 against 10**19) or of the middle one shows the fraction past a
# midpoint, so every remainder counts
query II
SELECT (SELECT avg(v)::VARCHAR FROM (VALUES ('18014398509481986.00000000000000000001'::DECIMAL(38,20))) t(v) GROUP BY v),
       finalize(to_aggregate_state({'count': 2, 'value': '195312500000000021684043449710088681'::HUGEINT}, 'avg', ['DECIMAL(38,38)']))::VARCHAR
----
1.8014398509481988e+16	0.0009765625000000002

# Empty and NULL groups stay NULL
query II
SELECT g, avg(v) FROM (VALUES (1, NULL::HUGEINT), (1, NULL), (2, 5::HUGEINT), (2, NULL)) t(g, v) GROUP BY g ORDER BY g
----
1	NULL
2	5.0

query III
SELECT finalize(to_aggregate_state({'count': 0, 'value': 0::HUGEINT}, 'avg', ['HUGEINT'])),
       finalize(to_aggregate_state({'count': 0, 'value': 0}, 'avg', ['SMALLINT'])),
       finalize(to_aggregate_state({'count': 0, 'value': 0::HUGEINT}, 'avg', ['DECIMAL(38,10)']))
----
NULL	NULL	NULL

# A windowed avg, over a partition and over a moving frame, takes the same finalizer
query III
SELECT i, avg(v) OVER (PARTITION BY g)::VARCHAR, avg(v) OVER (ORDER BY i ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)::VARCHAR
FROM (VALUES
	(1, 1, 42535295865117312655288308798616240128::HUGEINT),
	(2, 1, 42535295865117312655288308798616240129::HUGEINT),
	(3, 2, NULL),
	(4, 3, '-85070591730234625310576617597232480257'::HUGEINT)
) t(i, g, v)
ORDER BY i
----
1	4.253529586511732e+37	4.253529586511731e+37
2	4.253529586511732e+37	4.253529586511732e+37
3	NULL	4.253529586511732e+37
4	-8.507059173023463e+37	-8.507059173023463e+37

# Values next to a DOUBLE midpoint at every bit length, both signs: one row averages to the cast, two rows v and
# v + 1 to v + 1/2, three rows v, v and v + 1 to v + 1/3 (where their sum fits); the reference parses the exact
# average as text
statement ok
CREATE TABLE near_midpoint AS
SELECT row_number() OVER () AS id, b, ((m << (b - 53)) + (1::HUGEINT << (b - 54)) + delta) AS v, sign
FROM (VALUES (1::HUGEINT << 52), ((1::HUGEINT << 52) + 1), ((1::HUGEINT << 53) - 1)) t1(m),
     range(55, 127) t2(b),
     (VALUES (-1), (0), (1)) t3(delta),
     (VALUES (1), (-1)) t4(sign);

query I
SELECT count(*) FROM near_midpoint
----
1296

query IIII
SELECT count(a3),
       count(*) FILTER (a1 <> (v * sign)::DOUBLE),
       count(*) FILTER (a2 <> (v::VARCHAR || '.5')::DOUBLE * sign),
       count(*) FILTER (a3 <> (v::VARCHAR || '.' || repeat('3', 60))::DOUBLE * sign)
FROM (
	SELECT n.id, any_value(n.v) AS v, any_value(n.sign) AS sign,
	       avg(x) FILTER (k = 0) AS a1, avg(x) FILTER (k < 2) AS a2, avg(x) FILTER (k IN (1, 2, 3) AND n.b < 126) AS a3
	FROM near_midpoint n,
	     LATERAL (VALUES (0, n.v * n.sign), (1, (n.v + 1) * n.sign), (2, n.v * n.sign), (3, n.v * n.sign)) r(k, x)
	GROUP BY n.id
)
----
1278	0	0	0

# The same values as DECIMAL(38, s) units, all below 10**38, against the text of the exact value
statement ok
CREATE MACRO decimal_text(a, s) AS (
	SELECT CASE WHEN a < 0 THEN '-' ELSE '' END || t[1:length(t) - s] || '.' || t[length(t) - s + 1:]
	FROM (SELECT lpad(abs(a)::VARCHAR, greatest(length(abs(a)::VARCHAR), s + 1)::INTEGER, '0') AS t)
);

query IIIII
SELECT count(*),
       count(*) FILTER (avg_10 <> decimal_text(u, 10)::DOUBLE),
       count(*) FILTER (avg_28 <> decimal_text(u, 28)::DOUBLE),
       count(*) FILTER (avg_38 <> decimal_text(u, 38)::DOUBLE),
       count(*) FILTER (avg_10 <> decimal_text(u, 10)::DECIMAL(38,10)::DOUBLE)
FROM (
	SELECT id, any_value(v * sign) AS u,
	       avg(decimal_text(v * sign, 10)::DECIMAL(38,10)) AS avg_10,
	       avg(decimal_text(v * sign, 28)::DECIMAL(38,28)) AS avg_28,
	       avg(decimal_text(v * sign, 38)::DECIMAL(38,38)) AS avg_38
	FROM near_midpoint
	GROUP BY id
)
----
1296	0	0	0	0

# Imported states of every physical width with counts up to 2**64 - 1, against Python's Fraction reference: three per
# type that the long double finalizer got wrong, then states at the scales where the divisor changes shape (10**15 and
# 10**16 around the exact DOUBLE division, 10**19 and 10**20 around a third factor) and states whose long division
# corrects a quotient digit estimate twice
statement ok
CREATE TABLE imported_states(type VARCHAR, count UBIGINT, value VARCHAR, expected VARCHAR);

statement ok
