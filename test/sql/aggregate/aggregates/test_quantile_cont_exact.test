# name: test/sql/aggregate/aggregates/test_quantile_cont_exact.test
# description: quantile_cont, median and mad interpolate integer backed values exactly and round once
# group: [aggregates]

# The value at a fractional position p between neighbours lo and hi is lo + (hi - lo) * p, with p the double the
# position has, rounded once: to the nearest DOUBLE for integer inputs, to the nearest unit for DECIMAL and
# temporal results, ties to even. DOUBLE results are compared as text, since the test runner accepts a DOUBLE
# within a tolerance.

statement ok
SET threads=4;

statement ok
CREATE TABLE big(g INTEGER, v BIGINT);

statement ok
INSERT INTO big VALUES (1, 1000000000000000060), (1, 1000000000000000070), (2, (-1000000000000000060)::BIGINT), (2, (-1000000000000000070)::BIGINT), (3, (-9223372036854775808)::BIGINT), (3, 9223372036854775807), (4, 1000000000000000060), (4, 1000000000000000065), (4, 1000000000000000070), (5, NULL), (5, NULL), (6, 1000000000000000060), (6, NULL), (6, 1000000000000000070), (7, 1000000000000000001), (7, 1000000000000000200), (7, 1000000000000000330), (7, 1000000000000000064);

# 10**18 + 65 is above the midpoint of the DOUBLE neighbours 10**18 and 10**18 + 128; group 3 averages to -0.5,
# group 4 lands on its middle value at 0.5, and group 7 has four values
query IIIII
SELECT g, quantile_cont(v, 0.5)::VARCHAR, median(v)::VARCHAR, quantile_cont(v, [0.1, 0.5, 0.75])::VARCHAR,
	quantile_cont(v, -0.3)::VARCHAR
FROM big GROUP BY g ORDER BY g
----
1	1.0000000000000001e+18	1.0000000000000001e+18	[1e+18, 1.0000000000000001e+18, 1.0000000000000001e+18]	1.0000000000000001e+18
2	-1.0000000000000001e+18	-1.0000000000000001e+18	[-1.0000000000000001e+18, -1.0000000000000001e+18, -1e+18]	-1e+18
3	-0.5	-0.5	[-7.378697629483821e+18, -0.5, 4.611686018427388e+18]	3.6893488147419105e+18
4	1.0000000000000001e+18	1.0000000000000001e+18	[1e+18, 1.0000000000000001e+18, 1.0000000000000001e+18]	1.0000000000000001e+18
5	NULL	NULL	NULL	NULL
6	1.0000000000000001e+18	1.0000000000000001e+18	[1e+18, 1.0000000000000001e+18, 1.0000000000000001e+18]	1.0000000000000001e+18
7	1.0000000000000001e+18	1.0000000000000001e+18	[1e+18, 1.0000000000000001e+18, 1.0000000000000003e+18]	1.0000000000000003e+18

# the ungrouped aggregate agrees with the grouped one
query IIII
SELECT quantile_cont(v, 0.5)::VARCHAR, median(v)::VARCHAR, quantile_cont(v, [0.1, 0.5, 0.75])::VARCHAR,
	quantile_cont(v, -0.3)::VARCHAR
FROM big WHERE g = 1
----
1.0000000000000001e+18	1.0000000000000001e+18	[1e+18, 1.0000000000000001e+18, 1.0000000000000001e+18]	1.0000000000000001e+18

query IIII
SELECT quantile_cont(v, 0.5)::VARCHAR, median(v)::VARCHAR, quantile_cont(v, [0.1, 0.5, 0.75])::VARCHAR,
	quantile_cont(v, -0.3)::VARCHAR
FROM big WHERE g = 3
----
-0.5	-0.5	[-7.378697629483821e+18, -0.5, 4.611686018427388e+18]	3.6893488147419105e+18

query IIII
SELECT quantile_cont(v, 0.5)::VARCHAR, median(v)::VARCHAR, quantile_cont(v, [0.1, 0.5, 0.75])::VARCHAR,
	quantile_cont(v, -0.3)::VARCHAR
FROM big WHERE g = 7
----
1.0000000000000001e+18	1.0000000000000001e+18	[1e+18, 1.0000000000000001e+18, 1.0000000000000003e+18]	1.0000000000000003e+18

query III
SELECT quantile_cont(v, 0.5), median(v), quantile_cont(v, [0.5]) FROM big WHERE g = 5
----
NULL	NULL	NULL

query III
SELECT quantile_cont(v, 0.5), median(v), quantile_cont(v, [0.5]) FROM big WHERE false
----
NULL	NULL	NULL

# every integer width, at its limits and at pairs the DOUBLE route rounded wrong
query IIIIII
SELECT quantile_cont(v, 0.3)::VARCHAR, quantile_cont(v, 0.7)::VARCHAR, quantile_cont(v, 0.9)::VARCHAR, median(v)::VARCHAR, quantile_cont(v, [0.3, 0.7, 0.9])::VARCHAR,
	typeof(quantile_cont(v, 0.5))
FROM (VALUES ((-128)::TINYINT), ((127)::TINYINT)) t(v)
----
-51.5	50.499999999999986	101.5	-0.5	[-51.5, 50.499999999999986, 101.5]	DOUBLE

query IIIII
SELECT quantile_cont(v, 0.3)::VARCHAR, quantile_cont(v, 0.7)::VARCHAR, median(v)::VARCHAR, quantile_cont(v, [0.3, 0.7])::VARCHAR,
	typeof(quantile_cont(v, 0.5))
FROM (VALUES ((-32768)::SMALLINT), ((32767)::SMALLINT)) t(v)
