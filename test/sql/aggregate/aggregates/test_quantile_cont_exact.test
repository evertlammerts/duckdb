# fractions that cancel, vanish below the result's precision, or reach the subnormal range
# the offset cancels the value down to 2**-121
query I
SELECT quantile_cont(v, 1.128474576789396e-36)::VARCHAR FROM (VALUES ((-1)::HUGEINT), ((886151997189943915269204706853563050)::HUGEINT)) t(v)
----
3.76158192263132e-37

# a result between -1 and 0
query I
SELECT quantile_cont(v, 0.3)::VARCHAR FROM (VALUES ((-1)::HUGEINT), ((0)::HUGEINT)) t(v)
----
-0.7

# a result just above -1, from a position below 2**-200
query I
SELECT quantile_cont(v, 5.527147875260445e-76)::VARCHAR FROM (VALUES ((-1)::HUGEINT), ((85070591730234615865843651857942052864)::HUGEINT)) t(v)
----
-1.0

# a fraction below the lowest bit of a large result
query I
SELECT quantile_cont(v, 1e-30)::VARCHAR FROM (VALUES ((-5)::HUGEINT), ((1267650600228229401496703205376)::HUGEINT)) t(v)
----
-3.7323493997717705

# a subnormal result
query I
SELECT quantile_cont(v, 5e-324)::VARCHAR FROM (VALUES ((0)::HUGEINT), ((1)::HUGEINT)) t(v)
----
5e-324

# the minimum and a tiny position
query I
SELECT quantile_cont(v, 1e-30)::VARCHAR FROM (VALUES ((-170141183460469231731687303715884105728)::HUGEINT), ((0)::HUGEINT)) t(v)
----
-1.7014118346046923e+38

# DECIMAL results round to the nearest unit, ties to even, at every width
query IIII
SELECT (SELECT median(v) FROM (VALUES (1::DECIMAL(4,0)), (2::DECIMAL(4,0))) t(v)), (SELECT median(v) FROM (VALUES (2::DECIMAL(4,0)), (3::DECIMAL(4,0))) t(v)), (SELECT median(v) FROM (VALUES (-1::DECIMAL(4,0)), (-2::DECIMAL(4,0))) t(v)), (SELECT median(v) FROM (VALUES (-2::DECIMAL(4,0)), (-3::DECIMAL(4,0))) t(v))
----
2	2	-2	-2

query IIII
SELECT (SELECT median(v) FROM (VALUES (1::DECIMAL(9,0)), (2::DECIMAL(9,0))) t(v)), (SELECT median(v) FROM (VALUES (2::DECIMAL(9,0)), (3::DECIMAL(9,0))) t(v)), (SELECT median(v) FROM (VALUES (-1::DECIMAL(9,0)), (-2::DECIMAL(9,0))) t(v)), (SELECT median(v) FROM (VALUES (-2::DECIMAL(9,0)), (-3::DECIMAL(9,0))) t(v))
----
2	2	-2	-2

query IIII
