# mad rounds its median, then the median of the deviations from it
query I
SELECT mad(v) FROM (VALUES ((0)::DECIMAL(38,0)), ((1)::DECIMAL(38,0)), ((30000000000000000000000000000000000005)::DECIMAL(38,0)), ((30000000000000000000000000000000000008)::DECIMAL(38,0)), ((10000000000000000000000000000000000003)::DECIMAL(38,0))) t(v)
----
10000000000000000000000000000000000003

query I
SELECT mad(v) FROM (VALUES ((-9999999999999999.99)::DECIMAL(18,2)), ((9999999999999999.99)::DECIMAL(18,2)), ((0.03)::DECIMAL(18,2)), ((0.04)::DECIMAL(18,2))) t(v)
----
4999999999999999.98

query I
SELECT mad(v) FROM (VALUES ((-999.9)::DECIMAL(4,1)), ((999.9)::DECIMAL(4,1)), ((0.1)::DECIMAL(4,1)), ((0.2)::DECIMAL(4,1))) t(v)
----
499.9

# window frames, sliding and whole partition, scalar and list, with NULLs in the frames
statement ok
CREATE TABLE series AS SELECT * FROM (VALUES (0, (1000000000000000060)::BIGINT), (1, (1000000000000000070)::BIGINT), (2, (1000000000000000061)::BIGINT), (3, NULL), (4, (1000000000000000075)::BIGINT), (5, (1000000000000000190)::BIGINT), (6, (-1000000000000000063)::BIGINT), (7, (1000000000000000063)::BIGINT)) t(i, v);

query IIIII
SELECT i,
	quantile_cont(v, 0.5) OVER (ORDER BY i ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)::VARCHAR,
	median(v) OVER (ORDER BY i ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING)::VARCHAR,
	quantile_cont(v, [0.3, 0.5]) OVER (ORDER BY i ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING)::VARCHAR,
	quantile_cont(v, 0.5) OVER ()::VARCHAR
FROM series ORDER BY i
----
0	1e+18	1.0000000000000001e+18	[1e+18, 1.0000000000000001e+18]	1e+18
1	1.0000000000000001e+18	1e+18	[1e+18, 1e+18]	1e+18
2	1.0000000000000001e+18	1e+18	[1e+18, 1.0000000000000001e+18]	1e+18
3	1e+18	1.0000000000000001e+18	[1.0000000000000001e+18, 1.0000000000000001e+18]	1e+18
4	1.0000000000000001e+18	1.0000000000000001e+18	[1.0000000000000001e+18, 1.0000000000000001e+18]	1e+18
5	1.0000000000000001e+18	1.0000000000000001e+18	[1.9999999999999997e+17, 1.0000000000000001e+18]	1e+18
6	63.5	1.0000000000000001e+18	[1.9999999999999997e+17, 1e+18]	1e+18
7	0.0	1e+18	[-4.0000000000000006e+17, 0.0]	1e+18

statement ok
CREATE TABLE dseries AS SELECT * FROM (VALUES (0, 10000000000000000000000000000000000001::DECIMAL(38,0)), (1, 10000000000000000000000000000000000004::DECIMAL(38,0)), (2, -3::DECIMAL(38,0)), (3, 10000000000000000000000000000000000009::DECIMAL(38,0)), (4, 20000000000000000000000000000000000002::DECIMAL(38,0))) t(i, v);

query IIII
SELECT i,
	median(v) OVER (ORDER BY i ROWS BETWEEN 1 PRECEDING AND CURRENT ROW),
	mad(v) OVER (ORDER BY i ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING),
	quantile_cont(v, [0.3, 0.75]) OVER (ORDER BY i ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING)
FROM dseries ORDER BY i
----
0	10000000000000000000000000000000000001	2	[10000000000000000000000000000000000002, 10000000000000000000000000000000000003]
1	10000000000000000000000000000000000002	3	[5999999999999999777955395074968691915, 10000000000000000000000000000000000002]
2	5000000000000000000000000000000000000	4	[5999999999999999777955395074968691916, 10000000000000000000000000000000000006]
3	5000000000000000000000000000000000003	5000000000000000000000000000000000000	[5999999999999999777955395074968691919, 15000000000000000000000000000000000006]
4	15000000000000000000000000000000000006	9999999999999999999999999999999999993	[12999999999999999888977697537484345965, 17500000000000000000000000000000000004]

# temporal results round to the nearest unit as well, ties to even
query IIIIII
SELECT
	(SELECT median(v) FROM (VALUES ('2000-01-01 00:00:00.000002'::TIMESTAMP), ('2000-01-01 00:00:00.000003'::TIMESTAMP)) t(v)),
	(SELECT median(v) FROM (VALUES ('1960-01-01 00:00:00.000002'::TIMESTAMP), ('1960-01-01 00:00:00.000003'::TIMESTAMP)) t(v)),
	(SELECT median(v) FROM (VALUES ('2000-01-01 00:00:00.002'::TIMESTAMP_MS), ('2000-01-01 00:00:00.003'::TIMESTAMP_MS)) t(v)),
	(SELECT median(v) FROM (VALUES ('00:00:00.000002'::TIME), ('00:00:00.000003'::TIME)) t(v)),
	(SELECT median(v) FROM (VALUES ('00:00:00.000002+00'::TIMETZ), ('00:00:00.000003+00'::TIMETZ)) t(v)),
	(SELECT median(v) FROM (VALUES (INTERVAL 2 MICROSECONDS), (INTERVAL 3 MICROSECONDS)) t(v))
----
2000-01-01 00:00:00.000002	1960-01-01 00:00:00.000002	2000-01-01 00:00:00.002	00:00:00.000002	00:00:00.000002+00	00:00:00.000002

# nanosecond and day ranges whose differences exceed 2**53
query III
SELECT
	(SELECT epoch_ns(median(v)) FROM (VALUES ('1700-01-01 00:00:00.000000001'::TIMESTAMP_NS), ('2200-01-01 00:00:00.000000002'::TIMESTAMP_NS)) t(v)),
	(SELECT epoch_ns(median(v)) FROM (VALUES ('1700-01-01 00:00:00.000000001'::TIMESTAMPTZ_NS), ('2200-01-01 00:00:00.000000002'::TIMESTAMPTZ_NS)) t(v)),
	(SELECT list_transform(quantile_cont(v, [0.3, 0.9]), lambda x: epoch_ns(x)) FROM (VALUES ('1700-01-01 00:00:00.000000001'::TIMESTAMPTZ_NS), ('2200-01-01 00:00:00.000000002'::TIMESTAMPTZ_NS)) t(v))
----
-631108799999999998	-631108799999999998	[-3786799680000000174, 5680272960000000352]

query III
SELECT epoch_us(quantile_cont(v, 0.3)), epoch_us(median(v)), epoch_us(quantile_cont(v::TIMESTAMP, 0.7))
FROM (VALUES ('0001-01-01'::DATE), ('9999-12-31'::DATE)) t(v)
----
32525746559999996	95633308800000000	158740871039999986

# the exact midpoint of one microsecond and 290000 years is a tie, which goes to the even microsecond
query I
SELECT median(v) FROM (VALUES (INTERVAL 1 MICROSECOND), (INTERVAL '290000 years')) t(v)
----
52200000 days

# a window over nanosecond timestamps
query II
SELECT i, epoch_ns(median(v) OVER (ORDER BY i ROWS BETWEEN 1 PRECEDING AND CURRENT ROW))
FROM (VALUES (0, make_timestamp_ns(-8520335999999999999)), (1, make_timestamp_ns(7258118400000000002)), (2, make_timestamp_ns(7)), (3, make_timestamp_ns(-2195942399999999997))) t(i, v) ORDER BY i
----
0	-8520335999999999999
1	-631108799999999998
2	3629059200000000004
3	-1097971199999999995

query IIII
SELECT quantile_cont(v, 0.5)::VARCHAR, median(v)::VARCHAR, quantile_cont(v::UBIGINT, 0.5)::VARCHAR, median(v::UBIGINT)::VARCHAR
FROM (VALUES (18446744073709547080::UHUGEINT), (18446744073709545054::UHUGEINT)) t(v)
----
1.8446744073709545e+19	1.8446744073709545e+19	1.8446744073709545e+19	1.8446744073709545e+19

# grouped DECIMAL, and a finalized exported state, agree with the ungrouped results above
query II
SELECT g, median(v) FROM (VALUES (1, 1::DECIMAL(38,0)), (1, 2), (2, 2), (2, 3), (3, -1), (3, -2)) t(g, v) GROUP BY g ORDER BY g
----
1	2
2	2
3	-2

query II
SELECT finalize(quantile_cont(v, 0.5) EXPORT_STATE)::VARCHAR, finalize(median(v) EXPORT_STATE)::VARCHAR FROM big WHERE g = 1
----
1.0000000000000001e+18	1.0000000000000001e+18

# a negative quantile orders descending, and its ties go to even as well
query IIII
SELECT
	(SELECT quantile_cont(v, -0.5) FROM (VALUES (2::DECIMAL(4,0)), (3::DECIMAL(4,0))) t(v)),
	(SELECT quantile_cont(v, -0.25) FROM (VALUES (1::DECIMAL(4,0)), (2::DECIMAL(4,0))) t(v)),
	(SELECT quantile_cont(v, -0.5) FROM (VALUES (1::DECIMAL(38,0)), (2::DECIMAL(38,0))) t(v)),
	(SELECT quantile_cont(v, -0.5) FROM (VALUES ('2000-01-01 00:00:00.000002'::TIMESTAMP), ('2000-01-01 00:00:00.000003'::TIMESTAMP)) t(v))
----
2	2	2	2000-01-01 00:00:00.000002

# a frame much larger than its partition takes the skip list instead of the sort tree
query III
SELECT i, median(v) OVER (ORDER BY i ROWS BETWEEN 5 PRECEDING AND CURRENT ROW)::VARCHAR,
	quantile_cont(v, [0.5, 0.3]) OVER (ORDER BY i ROWS BETWEEN 5 PRECEDING AND CURRENT ROW)::VARCHAR
FROM (VALUES (0, 1000000000000000060::BIGINT), (1, 1000000000000000070::BIGINT), (2, 1000000000000000061::BIGINT)) t(i, v) ORDER BY i
----
0	1e+18	[1e+18, 1e+18]
1	1.0000000000000001e+18	[1.0000000000000001e+18, 1e+18]
2	1e+18	[1e+18, 1e+18]

query II
SELECT i, mad(v) OVER (ORDER BY i ROWS BETWEEN 5 PRECEDING AND CURRENT ROW)
FROM (VALUES (0, (127)::DECIMAL(3,0)), (1, (-128)::DECIMAL(3,0)), (2, (3)::DECIMAL(3,0))) t(i, v) ORDER BY i
----
0	0
1	128
2	124

# TIMESTAMP_S ties, and mad over TIME and TIMESTAMP, whose medians and deviations round alike
query III
SELECT
	(SELECT median(v) FROM (VALUES ('2000-01-01 00:00:02'::TIMESTAMP_S), ('2000-01-01 00:00:03'::TIMESTAMP_S)) t(v)),
	(SELECT mad(v) FROM (VALUES ('00:00:00'::TIME), ('00:00:00.000001'::TIME), ('00:00:00.000004'::TIME), ('00:00:00.000007'::TIME)) t(v)),
	(SELECT mad(v) FROM (VALUES ('2000-01-01 00:00:00'::TIMESTAMP), ('2000-01-01 00:00:00.000001'::TIMESTAMP)) t(v))
----
2000-01-01 00:00:02	00:00:00.000002	00:00:00

