# name: test/sql/catalog/function/test_recursive_macro.test
# description: Test recursive macros
# group: [function]

statement ok
set enable_macro_dependencies=true

statement error
CREATE MACRO "sum"(x) AS (CASE WHEN sum(x) IS NULL THEN 0 ELSE sum(x) END);
----
Binder Error: Cannot create macro "sum": its definition expands "sum" again

query I
SELECT sum(1);
----
1

# a body that needs its argument's type stops binding at CREATE before it reaches the call of sum, so this cycle
# shows only at a call, where the expression depth limit ends it
statement ok
CREATE MACRO "sum"(x) AS x.f + sum(x);

statement error
SELECT sum({'f': 1});
----
Max expression depth limit

statement error
SELECT sum({'f': 1}) WHERE 42=0
----
Max expression depth limit

statement ok
DROP MACRO sum

# recursive macro with explicit qualification
statement ok
CREATE MACRO "sum"(x) AS (CASE WHEN system.main.sum(x) IS NULL THEN 0 ELSE system.main.sum(x) END);

query I
SELECT sum(1);
----
1

query I
SELECT sum(1) WHERE 42=0
----
0

# evil test case by Mark
statement ok
create macro m1(a) as a+1;

statement ok
create macro m2(a) as m1(a)+1;

statement error
create or replace macro m1(a) as m2(a)+1;
----
Binder Error: Cannot create macro "m1": its definition expands "m1" again

# also table macros
statement ok
create macro m3(a) as a+1;

statement ok
create macro m4(a) as table select m3(a);

statement error
create or replace macro m3(a) as (from m4(42));
----
Binder Error: Cannot create macro "m3": its definition expands "m3" again
