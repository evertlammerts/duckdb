# name: test/sql/catalog/view/view_catalog_alias.test
# description: Test that views referencing their own catalog survive re-attaching under a different alias
# group: [view]

statement ok
ATTACH '{TEST_DIR}/view_catalog_alias.db' AS db1;

statement ok
CREATE SCHEMA db1.s1;

statement ok
CREATE TABLE db1.t(i INTEGER);

statement ok
INSERT INTO db1.t VALUES (42);

statement ok
CREATE TABLE db1.s1.t(i INTEGER);

statement ok
INSERT INTO db1.s1.t VALUES (84);

# base table ref - two-part and three-part qualification
statement ok
CREATE VIEW db1.v_base AS SELECT * FROM db1.t;

statement ok
CREATE VIEW db1.v_full AS SELECT * FROM db1.main.t;

# qualified column references
statement ok
CREATE VIEW db1.v_colref AS SELECT db1.t.i FROM db1.t;

# subqueries and CTEs
statement ok
CREATE VIEW db1.v_subquery AS SELECT (SELECT max(i) FROM db1.t) AS i;

statement ok
CREATE VIEW db1.v_cte AS WITH c AS (SELECT * FROM db1.t) SELECT * FROM c;

# a view living in a non-default schema
statement ok
CREATE VIEW db1.s1.v_schema AS SELECT * FROM db1.s1.t;

# a deferred-binding view is normalized as well
statement ok
CREATE VIEW db1.v_deferred WITH (DEFER_BINDING) AS SELECT * FROM db1.t;

# the source of a PIVOT, UNPIVOT or MATCH_RECOGNIZE
statement ok
CREATE TABLE db1.p(kind VARCHAR, v INTEGER);

statement ok
INSERT INTO db1.p VALUES ('a', 5), ('a', 7);

statement ok
CREATE VIEW db1.v_pivot AS SELECT * FROM db1.main.p PIVOT (sum(v) FOR kind IN ('a'));

statement ok
CREATE VIEW db1.v_unpivot AS SELECT col, val FROM db1.p UNPIVOT (val FOR col IN (v)) ORDER BY val;

statement ok
CREATE VIEW db1.v_match AS SELECT n FROM db1.main.p MATCH_RECOGNIZE (ORDER BY v MEASURES count(*) AS n PATTERN (A+) DEFINE A AS v > 0);

# a column reference whose leading name is the catalog's beside bindings spelled like the catalog
statement ok
CREATE TABLE db1.tt(c INTEGER);

statement ok
INSERT INTO db1.tt VALUES (1);

statement ok
CREATE TABLE db1.rows_like(tt STRUCT(c INTEGER));

statement ok
INSERT INTO db1.rows_like VALUES ({'c': 2});

statement ok
CREATE TABLE db1.u(x INTEGER);

statement ok
INSERT INTO db1.u VALUES (5);

statement ok
CREATE VIEW db1.v_bind_level AS SELECT db1.tt.c AS c FROM db1.tt, db1.rows_like AS db1;

statement ok
CREATE VIEW db1.v_bind_function AS SELECT db1.tt.c AS c FROM db1.tt, range(1) AS db1(x);

statement ok
CREATE VIEW db1.v_bind_outer AS SELECT (SELECT db1.tt.c FROM db1.tt) AS c FROM db1.rows_like AS db1;

statement ok
CREATE VIEW db1.v_bind_inner AS SELECT (SELECT db1.tt.c FROM (SELECT {'c': 7} AS tt) AS db1) AS c FROM db1.tt;

statement ok
CREATE VIEW db1.v_binding_nocol AS SELECT (SELECT db1.t.i FROM db1.u AS db1) AS c FROM db1.t;

statement ok
CREATE VIEW db1.v_row_function AS SELECT db1.main.t AS r FROM db1.main.t, range(1) AS db1(x);

statement ok
CREATE VIEW db1.v_lateral AS SELECT z AS c FROM db1.t, LATERAL (SELECT db1.t.i AS z FROM db1.u AS db1);

query IIIIII
SELECT (SELECT db1.tt.c FROM db1.tt, db1.rows_like AS db1), (SELECT db1.tt.c FROM db1.tt, range(1) AS db1(x)), (SELECT (SELECT db1.tt.c FROM db1.tt) FROM db1.rows_like AS db1), (SELECT (SELECT db1.tt.c FROM (SELECT {'c': 7} AS tt) AS db1) FROM db1.tt), (SELECT (SELECT db1.t.i FROM db1.u AS db1) FROM db1.t), (SELECT z FROM db1.t, LATERAL (SELECT db1.t.i AS z FROM db1.u AS db1));
----
1	1	1	7	42	42

# a table in a nested schema, a CTE named like the table its definition reads, the ORDER BY of a set operation, a
# whole row, a later branch of a set operation or a recursive CTE beside an earlier branch's alias spelled like the
# catalog, and a table read beside a CTE of its name
statement ok
CREATE SCHEMA db1.s1.s2;

statement ok
CREATE TABLE db1.s1.s2.n(i INTEGER);

statement ok
INSERT INTO db1.s1.s2.n VALUES (7);

statement ok
CREATE VIEW db1.v_nested AS SELECT db1.s1.s2.n.i FROM db1.s1.s2.n;

statement ok
CREATE VIEW db1.v_cte_own AS WITH t AS (SELECT db1.t.i FROM db1.t) SELECT i FROM t;

statement ok
CREATE VIEW db1.v_setop_order AS SELECT db1.t.i FROM db1.t UNION ALL SELECT db1.t.i FROM db1.t ORDER BY db1.t.i;

statement ok
CREATE VIEW db1.v_whole_row AS SELECT db1.main.t AS r FROM db1.main.t;

statement ok
CREATE VIEW db1.v_setop_sibling AS SELECT (SELECT max(x) FROM (SELECT 0 AS x FROM range(0) AS db1(r) UNION ALL SELECT db1.t.i) s) AS c FROM db1.t;

statement ok
CREATE VIEW db1.v_rec_sibling AS SELECT (SELECT max(x) FROM (WITH RECURSIVE r(x) AS (SELECT 0 FROM range(1) AS db1(q) UNION ALL SELECT x + 1 FROM r WHERE x < db1.t.i) SELECT x FROM r)) AS c FROM db1.t;

statement ok
CREATE VIEW db1.v_cte_shadow AS WITH t(i) AS (VALUES (99)) SELECT i FROM db1.t;

query III
SELECT (SELECT (SELECT max(x) FROM (SELECT 0 AS x FROM range(0) AS db1(r) UNION ALL SELECT db1.t.i) s) FROM db1.t), (SELECT (SELECT max(x) FROM (WITH RECURSIVE r(x) AS (SELECT 0 FROM range(1) AS db1(q) UNION ALL SELECT x + 1 FROM r WHERE x < db1.t.i) SELECT x FROM r)) FROM db1.t), (WITH t(i) AS (VALUES (99)) SELECT i FROM db1.t);
----
42	42	42

# the catalog qualifier is dropped from the stored SQL
query II
SELECT view_name, trim(sql, chr(10)) FROM duckdb_views() WHERE database_name='db1' ORDER BY view_name;
----
v_base	CREATE VIEW v_base AS SELECT * FROM t;
v_bind_function	CREATE VIEW v_bind_function AS SELECT tt.c AS c FROM tt , "range"(1) AS db1(x);
v_bind_inner	CREATE VIEW v_bind_inner AS SELECT (SELECT tt.c FROM (SELECT struct_pack(c := 7) AS tt) AS db1) AS c FROM tt;
v_bind_level	CREATE VIEW v_bind_level AS SELECT tt.c AS c FROM tt , rows_like AS db1;
v_bind_outer	CREATE VIEW v_bind_outer AS SELECT (SELECT tt.c FROM tt) AS c FROM rows_like AS db1;
v_binding_nocol	CREATE VIEW v_binding_nocol AS SELECT (SELECT t.i FROM u AS db1) AS c FROM t;
v_colref	CREATE VIEW v_colref AS SELECT t.i FROM t;
v_cte	CREATE VIEW v_cte AS WITH c AS (SELECT * FROM t) SELECT * FROM c;
v_cte_own	CREATE VIEW v_cte_own AS WITH t AS (SELECT t.i FROM t) SELECT i FROM t;
v_cte_shadow	CREATE VIEW v_cte_shadow AS WITH t (i) AS (SELECT * FROM (VALUES (99)) AS valueslist) SELECT i FROM main.t;
v_deferred	CREATE VIEW v_deferred AS SELECT * FROM t;
v_full	CREATE VIEW v_full AS SELECT * FROM main.t;
v_lateral	CREATE VIEW v_lateral AS SELECT z AS c FROM t , (SELECT t.i AS z FROM u AS db1);
v_match	CREATE VIEW v_match AS SELECT n FROM main.p MATCH_RECOGNIZE(ORDER BY v MEASURES count_star() AS n PATTERN (A+) DEFINE A AS (v > 0));
v_nested	CREATE VIEW v_nested AS SELECT s1.s2.n.i FROM s1.s2.n;
v_pivot	CREATE VIEW v_pivot AS SELECT * FROM main.p PIVOT (sum(v) FOR (kind) IN ('a'));
v_rec_sibling	CREATE VIEW v_rec_sibling AS SELECT (SELECT max(x) FROM (WITH RECURSIVE r (x) AS ((SELECT 0 FROM "range"(1) AS db1(q)) UNION ALL (SELECT (x + 1) FROM r WHERE (x < t.i))) SELECT x FROM r)) AS c FROM t;
v_row_function	CREATE VIEW v_row_function AS SELECT main.t AS r FROM main.t , "range"(1) AS db1(x);
v_schema	CREATE VIEW s1.v_schema AS SELECT * FROM s1.t;
v_setop_order	CREATE VIEW v_setop_order AS (SELECT t.i FROM t) UNION ALL (SELECT t.i FROM t) ORDER BY t.i;
v_setop_sibling	CREATE VIEW v_setop_sibling AS SELECT (SELECT max(x) FROM ((SELECT 0 AS x FROM "range"(0) AS db1(r)) UNION ALL (SELECT t.i)) AS s) AS c FROM t;
v_subquery	CREATE VIEW v_subquery AS SELECT (SELECT max(i) FROM t) AS i;
v_unpivot	CREATE VIEW v_unpivot AS SELECT col, val FROM p UNPIVOT (val FOR col IN (v)) ORDER BY val;
v_whole_row	CREATE VIEW v_whole_row AS SELECT main.t AS r FROM main.t;

statement ok
DETACH db1;

statement ok
ATTACH '{TEST_DIR}/view_catalog_alias.db' AS db2;

query I
SELECT * FROM db2.v_base;
----
42

query I
SELECT * FROM db2.v_full;
----
42

query I
SELECT * FROM db2.v_colref;
----
42

query I
SELECT * FROM db2.v_subquery;
----
42

query I
SELECT * FROM db2.v_cte;
----
42

query I
SELECT * FROM db2.s1.v_schema;
----
84

query I
SELECT * FROM db2.v_deferred;
----
42

query I
SELECT * FROM db2.v_pivot;
----
12

query TI rowsort
SELECT * FROM db2.v_unpivot;
----
v	5
v	7

query I
SELECT * FROM db2.v_match;
----
2

query IIIIII
SELECT (SELECT c FROM db2.v_bind_level), (SELECT c FROM db2.v_bind_function), (SELECT c FROM db2.v_bind_outer), (SELECT c FROM db2.v_bind_inner), (SELECT c FROM db2.v_binding_nocol), (SELECT c FROM db2.v_lateral);
----
1	1	1	7	42	42

query I
SELECT r FROM db2.v_row_function;
----
{'i': 42}

query I
SELECT * FROM db2.v_nested;
----
7

query I
SELECT * FROM db2.v_cte_own;
----
42

query I
SELECT * FROM db2.v_setop_order;
----
42
42

query I
SELECT r FROM db2.v_whole_row;
----
{'i': 42}

query III
SELECT (SELECT c FROM db2.v_setop_sibling), (SELECT c FROM db2.v_rec_sibling), (SELECT i FROM db2.v_cte_shadow);
----
42	42	42

# views referencing another catalog keep their qualification
statement ok
ATTACH '{TEST_DIR}/view_catalog_alias_other.db' AS other;

statement ok
CREATE TABLE other.t(i INTEGER);

statement ok
INSERT INTO other.t VALUES (7);

statement ok
CREATE VIEW db2.v_other AS SELECT * FROM db2.t UNION ALL SELECT * FROM other.t;

query I
SELECT trim(sql, chr(10)) FROM duckdb_views() WHERE view_name='v_other';
----
CREATE VIEW v_other AS (SELECT * FROM t) UNION ALL (SELECT * FROM other.t);

query I
SELECT * FROM db2.v_other ORDER BY 1;
----
7
42
