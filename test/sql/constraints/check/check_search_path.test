# name: test/sql/constraints/check/check_search_path.test
# description: A CHECK constraint resolves its function, macro and type names in its table's schema, whatever the writer's search path
# group: [check]

load {TEST_DIR}/check_search_path.db

statement ok
CREATE SCHEMA s;

# the reported case: a macro of s called by its bare name, the table written from a session on main

statement ok
SET search_path = 's';

statement ok
CREATE MACRO s.tenfold(x) AS x * 10;

statement ok
CREATE TABLE s.tc(v INTEGER, CHECK (tenfold(v) < 100));

statement ok
INSERT INTO s.tc VALUES (1);

statement ok
RESET search_path;

statement ok
INSERT INTO s.tc VALUES (2);

statement error
INSERT INTO s.tc VALUES (20);
----
CHECK constraint failed

statement ok
INSERT INTO s.tc VALUES (NULL);

statement ok
UPDATE s.tc SET v = 3 WHERE v = 2;

statement error
UPDATE s.tc SET v = 30 WHERE v = 3;
----
CHECK constraint failed

statement ok
DELETE FROM s.tc WHERE v IS NULL;

query I
SELECT v FROM s.tc ORDER BY v;
----
1
3

query I
SELECT constraint_text FROM duckdb_constraints() WHERE schema_name = 's' AND table_name = 'tc';
----
CHECK((tenfold(v) < 100))

# the same macro name in both schemas: the table's schema wins

statement ok
CREATE MACRO main.f(x) AS x * 1000;

statement ok
CREATE MACRO s.f(x) AS x * 10;

statement ok
SET search_path = 's';

statement ok
CREATE TABLE s.pair(k INTEGER PRIMARY KEY, v INTEGER, w INTEGER, CHECK (f(v) < 100));

statement ok
RESET search_path;

statement ok
INSERT INTO s.pair VALUES (1, 5, 0);

statement error
INSERT INTO s.pair VALUES (2, 20, 0);
----
CHECK constraint failed

statement ok
INSERT INTO s.pair VALUES (1, 6, 0) ON CONFLICT (k) DO UPDATE SET v = excluded.v;

statement error
INSERT INTO s.pair VALUES (1, 60, 0) ON CONFLICT (k) DO UPDATE SET v = excluded.v;
----
CHECK constraint failed

statement ok
UPDATE s.pair SET v = 7;

statement error
UPDATE s.pair SET v = 70;
----
CHECK constraint failed

# an UPDATE of a column the CHECK does not read binds the constraints too

statement ok
UPDATE s.pair SET w = 1;

statement ok
MERGE INTO s.pair USING (SELECT 2 AS k, 8 AS v) src ON pair.k = src.k WHEN NOT MATCHED THEN INSERT VALUES (src.k, src.v, 0);

statement error
MERGE INTO s.pair USING (SELECT 3 AS k, 80 AS v) src ON pair.k = src.k WHEN NOT MATCHED THEN INSERT VALUES (src.k, src.v, 0);
----
CHECK constraint failed

statement ok
MERGE INTO s.pair USING (SELECT 2 AS k, 8 AS v) src ON pair.k = src.k WHEN MATCHED THEN UPDATE SET v = src.v;

statement error
MERGE INTO s.pair USING (SELECT 2 AS k, 80 AS v) src ON pair.k = src.k WHEN MATCHED THEN UPDATE SET v = src.v;
----
CHECK constraint failed

query III
SELECT * FROM s.pair ORDER BY k;
----
1	7	1
2	8	0

# dot calls on a physical column, also with the table's name as qualifier

statement ok
SET search_path = 's';

statement ok
CREATE TABLE s.dc(v INTEGER, CHECK (v.tenfold() < 100), CHECK (dc.v.tenfold() < 100));

statement ok
RESET search_path;

statement ok
INSERT INTO s.dc VALUES (2);

statement error
INSERT INTO s.dc VALUES (20);
----
CHECK constraint failed

# a table created from main binds the table's macro at CREATE and depends on it

statement ok
CREATE MACRO main.h(x) AS x * 1000;

statement ok
CREATE MACRO s.h(x) AS x * 10;

statement ok
CREATE TABLE s.from_main(v INTEGER, CHECK (h(v) < 100));

statement ok
INSERT INTO s.from_main VALUES (5);

statement error
INSERT INTO s.from_main VALUES (20);
----
CHECK constraint failed

statement error
DROP MACRO s.h;
----
Dependency Error

statement ok
DROP MACRO main.h;

statement ok
INSERT INTO s.from_main VALUES (6);

# a session on s that resolves every name already keeps the CHECK as written

statement ok
SET search_path = 's';

statement ok
INSERT INTO pair VALUES (4, 9, 0);

statement error
INSERT INTO pair VALUES (5, 90, 0);
----
CHECK constraint failed

statement ok
RESET search_path;

# a user type in a cast, with a different type of the same name in main

statement ok
CREATE TYPE s.mood AS ENUM ('sad', 'ok');

statement ok
CREATE TYPE main.mood AS ENUM ('happy');

statement ok
SET search_path = 's';

statement ok
CREATE TABLE s.tm(m VARCHAR, CHECK (TRY_CAST(m AS mood) IS NOT NULL));

statement ok
RESET search_path;

statement ok
INSERT INTO s.tm VALUES ('ok');

statement error
INSERT INTO s.tm VALUES ('happy');
----
CHECK constraint failed

# ALTER from main rebuilds the table and binds its constraints again

statement ok
ALTER TABLE s.tc ADD COLUMN extra INTEGER;

statement ok
ALTER TABLE s.tc RENAME COLUMN v TO val;

statement ok
ALTER TABLE s.tc ALTER extra TYPE BIGINT;

statement ok
ALTER TABLE s.tc DROP COLUMN extra;

statement ok
INSERT INTO s.tc VALUES (4);

statement error
INSERT INTO s.tc VALUES (40);
----
CHECK constraint failed

query I
SELECT constraint_text FROM duckdb_constraints() WHERE schema_name = 's' AND table_name = 'tc';
----
CHECK((tenfold(val) < 100))

statement ok
ALTER TABLE s.tc ADD PRIMARY KEY (val);

statement error
ALTER TABLE s.tc ALTER val TYPE BIGINT;
----
Cannot change the type of a column that has a CHECK constraint specified

# dropping the column a CHECK reads drops the CHECK with it, unless the CHECK reads another column too

statement ok
SET search_path = 's';

statement ok
CREATE TABLE s.drop_one(v INTEGER, w INTEGER, CHECK (tenfold(v) < 100));

statement ok
CREATE TABLE s.drop_two(v INTEGER, w INTEGER, CHECK (tenfold(v) < w));

statement ok
RESET search_path;

statement ok
ALTER TABLE s.drop_one DROP COLUMN v;

query I
SELECT count(*) FROM duckdb_constraints() WHERE schema_name = 's' AND table_name = 'drop_one';
----
0

statement error
ALTER TABLE s.drop_two DROP COLUMN v;
----
Cannot drop column "v" because there is a CHECK constraint that depends on it

statement error
ALTER TABLE s.tc ADD CONSTRAINT more CHECK (tenfold(val) > 0);
----
No support for adding CHECK constraints with ALTER TABLE

# a CHECK cannot reference a generated column directly; one reached through a dot call receiver resolves the
# generated expression in the table's schema too

statement error
CREATE TABLE s.gen_direct(v INTEGER, g INTEGER GENERATED ALWAYS AS (tenfold(v)), CHECK (g < 100));
----
Constraints on generated columns are not supported yet

statement ok
SET search_path = 's';

statement ok
CREATE TABLE s.gen_dot(v INTEGER, g INTEGER GENERATED ALWAYS AS (tenfold(v) - 100), CHECK (g.abs() < 50));

statement ok
RESET search_path;

statement ok
INSERT INTO s.gen_dot VALUES (9);

statement error
INSERT INTO s.gen_dot VALUES (1);
----
CHECK constraint failed

query II
SELECT v, g FROM s.gen_dot;
----
9	-10

# a DEFAULT expression beside the CHECK binds in the table's schema as well

statement ok
SET search_path = 's';

statement ok
CREATE TABLE s.td(v INTEGER, w INTEGER DEFAULT tenfold(4), CHECK (tenfold(v) < 100));

statement ok
RESET search_path;

statement ok
INSERT INTO s.td(v) VALUES (2);

statement error
INSERT INTO s.td(v) VALUES (20);
----
CHECK constraint failed

query II
SELECT v, w FROM s.td;
----
2	40

# a temporary table resolves its names through the writer's path, as a temporary view does

statement ok
SET search_path = 's';

statement ok
CREATE TEMPORARY TABLE tt(v INTEGER, CHECK (tenfold(v) < 100));

statement ok
INSERT INTO tt VALUES (1);

statement ok
RESET search_path;

statement error
INSERT INTO tt VALUES (2);
----
tenfold does not exist

# a WAL that holds ALTERs of the table, written from a session on s, replays from a session on main; the restart
# replays the whole WAL, so the constraints are bound again too

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET wal_autocheckpoint = '1TB';

statement ok
SET search_path = 's';

statement ok
ALTER TABLE s.td RENAME COLUMN w TO w2;

statement ok
ALTER TABLE s.td ADD COLUMN extra INTEGER;

statement ok
ALTER TABLE s.td DROP COLUMN extra;

statement ok
RESET search_path;

restart

statement ok
INSERT INTO s.td(v) VALUES (3);

statement error
INSERT INTO s.td(v) VALUES (30);
----
CHECK constraint failed

query II
SELECT v, w2 FROM s.td ORDER BY v;
----
2	40
3	40

statement ok
INSERT INTO s.tc VALUES (5);

statement error
INSERT INTO s.tc VALUES (50);
----
CHECK constraint failed

statement ok
UPDATE s.pair SET v = 9 WHERE k = 1;

query I
SELECT val FROM s.tc ORDER BY val;
----
1
3
4
5

query III
SELECT * FROM s.pair ORDER BY k;
----
1	9	1
2	8	0
4	9	0

# an attached database: the table in db2.s, written from memory.main

statement ok
ATTACH ':memory:' AS db2;

statement ok
CREATE SCHEMA db2.s;

statement ok
CREATE MACRO db2.s.hundredfold(x) AS x * 100;

statement ok
SET search_path = 'db2.s';

statement ok
CREATE TABLE db2.s.ta(v INTEGER, CHECK (hundredfold(v) < 1000));

statement ok
RESET search_path;

statement ok
INSERT INTO db2.s.ta VALUES (3);

statement error
INSERT INTO db2.s.ta VALUES (30);
----
CHECK constraint failed

statement ok
DETACH db2;

# a qualified name resolves in the table's catalog when the session's default catalog holds a schema of that name

statement ok
CREATE TABLE s.q(v INTEGER, CHECK (s.tenfold(v) < 100));

statement ok
ATTACH ':memory:' AS other;

statement ok
CREATE SCHEMA other.s;

statement ok
CREATE MACRO other.s.tenfold(x) AS x * 1000;

statement ok
USE other;

statement ok
INSERT INTO check_search_path.s.q VALUES (3);

statement error
INSERT INTO check_search_path.s.q VALUES (30);
----
CHECK constraint failed

statement ok
USE check_search_path;

statement ok
DETACH other;

# EXPORT writes the CHECK as written, and IMPORT from a session on main recreates the table

load {TEST_DIR}/check_search_path_export.db

statement ok
CREATE SCHEMA s;

statement ok
CREATE MACRO s.f(x) AS x * 10;

statement ok
CREATE MACRO main.f(x) AS x * 1000;

statement ok
CREATE TYPE s.mood AS ENUM ('sad', 'ok');

statement ok
SET search_path = 's';

statement ok
CREATE TABLE s.e(v INTEGER, m VARCHAR, CHECK (f(v) < 100), CHECK (TRY_CAST(m AS mood) IS NOT NULL));

statement ok
INSERT INTO s.e VALUES (1, 'ok');

statement ok
RESET search_path;

statement ok
EXPORT DATABASE '{TEST_DIR}/check_search_path_export';

query I
SELECT count(*) FROM read_text('{TEST_DIR}/check_search_path_export/schema.sql') WHERE contains(content, 'CREATE TABLE s.e(v INTEGER, m VARCHAR, CHECK((f(v) < 100)), CHECK((TRY_CAST(m AS mood) IS NOT NULL)));');
----
1

load {TEST_DIR}/check_search_path_import.db

statement ok
IMPORT DATABASE '{TEST_DIR}/check_search_path_export';

query I
SELECT sql FROM duckdb_tables() WHERE table_name = 'e';
----
CREATE TABLE s.e(v INTEGER, m VARCHAR, CHECK((f(v) < 100)), CHECK((TRY_CAST(m AS mood) IS NOT NULL)));

statement ok
INSERT INTO s.e VALUES (5, 'sad');

statement error
INSERT INTO s.e VALUES (20, 'ok');
----
CHECK constraint failed

statement error
INSERT INTO s.e VALUES (1, 'happy');
----
CHECK constraint failed

query II
SELECT * FROM s.e ORDER BY v;
----
1	ok
5	sad
