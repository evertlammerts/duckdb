# name: test/sql/copy/csv/rejects/csv_rejects_last_line_in_new_buffer.test
# description: A last line without a newline that starts a new buffer is one row, or one rejected line
# group: [rejects]

require skip_reload

# the buffer sizes put the last line at the start of the last buffer, which depends on the exact bytes of the files
require notwindows

# the last line is the fourth row of a two row chunk at vector size 2
query I
SELECT * FROM read_csv('{DATA_DIR}/csv/rejects/last_line/cast.csv', columns={'c': 'INTEGER'}, auto_detect=false,
    buffer_size=6, store_rejects=true);
----
1
2
3

query IIIIIIII
SELECT line, line_byte_position, byte_position, column_idx, column_name, error_type, csv_line, error_message
FROM reject_errors ORDER BY ALL;
----
4	7	7	1	c	CAST	abc	Error when converting column "c". Could not convert string "abc" to 'INTEGER'

statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

query I
SELECT * FROM read_csv('{DATA_DIR}/csv/rejects/last_line/cast.csv', columns={'c': 'INTEGER'}, auto_detect=false,
    buffer_size=6, ignore_errors=true);
----
1
2
3

