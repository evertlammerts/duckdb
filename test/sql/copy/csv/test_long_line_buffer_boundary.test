# A cast error on a line the scan stops at for its size (line 14, abc and 400 bytes, cut after the part read) is rejected
# with that line's position and text, as its line size error is.

query II
SELECT count(a), count(*) FROM read_csv('{DATA_DIR}/csv/long_line_buffer_boundary/cast_error_on_long_line.csv', buffer_size = 150, max_line_size = 100,
	store_rejects = true, auto_detect = false, header = true, columns = {'a': 'UUID', 'b': 'VARCHAR'});
----
0	17

query IIII
SELECT line, line_byte_position, error_type, left(csv_line, 4) FROM reject_errors ORDER BY error_type;
----
14	53	CAST	abc,
14	53	LINE SIZE OVER MAXIMUM	abc,

statement ok
