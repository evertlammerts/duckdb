# Lines ending in a carriage return and newline, rows up to the end of the first 150 byte buffer, then three empty lines
# at the start of the next: the scan of the first buffer reads the first of them and stops, and the newline of an empty
# line is no part of the next value.

query III
SELECT count(*), count(DISTINCT a), string_agg(a, ' ' ORDER BY a) FILTER (a NOT SIMILAR TO '[0-9]+')
FROM lines('{DATA_DIR}/csv/long_line_buffer_boundary/crlf_empty_lines_at_buffer_start.csv', 150);
----
27	27	q r

query III
SELECT count(*), count(DISTINCT a), string_agg(a, ' ' ORDER BY a) FILTER (a NOT SIMILAR TO '[0-9]+')
FROM lines('{DATA_DIR}/csv/long_line_buffer_boundary/crlf_empty_lines_at_buffer_start.csv', 150, serial := true);
----
27	27	q r

# 99 bytes of rows, then 120 empty lines of a carriage return and newline, so each 150 byte buffer ends between the
# carriage return and the newline of one of them: the scan whose empty line ends at a buffer end reads only its newline,
# and the next scan reads the rest of the run and the row after it.

query II
SELECT count(*), count(DISTINCT a) FROM lines('{DATA_DIR}/csv/long_line_buffer_boundary/crlf_empty_lines_after_split_line_end.csv', 150);
----
20	20

query II
SELECT count(*), count(DISTINCT a) FROM lines('{DATA_DIR}/csv/long_line_buffer_boundary/crlf_empty_lines_after_split_line_end.csv', 150, skip := true);
----
20	20

query II
SELECT count(*), count(DISTINCT a) FROM lines('{DATA_DIR}/csv/long_line_buffer_boundary/crlf_empty_lines_after_split_line_end.csv', 150, serial := true);
----
20	20

# 98 bytes of rows, 120 empty lines from byte 98, then 17,zz and five rows: the scan whose boundary starts inside the
# run does not read the row after the run, which starts in the next boundary.

query II
SELECT count(*), count(DISTINCT a) FROM lines('{DATA_DIR}/csv/long_line_buffer_boundary/empty_lines_across_boundary.csv', 150);
----
22	22

query II
SELECT count(*), count(DISTINCT a) FROM lines('{DATA_DIR}/csv/long_line_buffer_boundary/empty_lines_across_boundary.csv', 150, skip := true);
----
22	22

query II
SELECT count(*), count(DISTINCT a) FROM lines('{DATA_DIR}/csv/long_line_buffer_boundary/empty_lines_across_boundary.csv', 150, serial := true);
----
22	22

# The same with 250 empty lines and a 203 byte line 268 after them: one reject, on that line, in both modes.

statement error
