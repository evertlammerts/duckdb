<REGEX>:.*CSV Error on Line: 268.*Maximum line size of 100 bytes exceeded.*

query II
SELECT count(*), count(DISTINCT a) FROM lines('{DATA_DIR}/csv/long_line_buffer_boundary/empty_lines_before_long_line.csv', 150, rejects := true);
----
21	21

query III
SELECT line, error_type, length(csv_line) FROM reject_errors;
----
268	LINE SIZE OVER MAXIMUM	203

