# With buffer_size equal to max_line_size, a line that starts at the second buffer (after a 99 byte header) ends in
# the third: a line of exactly max_line_size bytes is read, one byte more is refused. The line follows the header, so
# its size counts no newline before it.

query II
SELECT count(*), max(length(b)) FROM lines('{DATA_DIR}/csv/long_line_buffer_boundary/line_100_at_buffer_start.csv', 100);
----
2	98

query II
SELECT count(*), max(length(b)) FROM lines('{DATA_DIR}/csv/long_line_buffer_boundary/line_100_at_buffer_start.csv', 100, serial := true);
----
2	98

