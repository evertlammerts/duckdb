# name: test/sql/copy/csv/test_long_line_buffer_boundary.test
# description: A line that starts inside a scan boundary and ends in the next buffer is finished by that scan, so every line is returned, rejected or reported
# group: [csv]

# With buffer_size=150 and max_line_size=100 a buffer holds the scan boundaries [0, 100) and [100, 150).

statement ok
SET threads=1;

statement ok
CREATE MACRO lines(f, buf, rejects := false, skip := false, serial := false) AS TABLE
FROM read_csv(f, buffer_size = buf, store_rejects = rejects, ignore_errors = (skip OR rejects), parallel = (NOT serial),
	max_line_size = 100, auto_detect = false, header = true, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'});

# The reported file: the third line (bytes 67 to 199, 132 bytes) starts in [0, 100) and ends in the second buffer.

statement error
SELECT * FROM read_csv('{DATA_DIR}/csv/long_line_buffer_boundary/third_line_long.csv', max_line_size = 100,
	buffer_size = 150, auto_detect = false, header = true, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'});
----
<REGEX>:.*CSV Error on Line: 3.*Maximum line size of 100 bytes exceeded. Actual Size:132 bytes.*

query II
SELECT a, length(b) FROM lines('{DATA_DIR}/csv/long_line_buffer_boundary/third_line_long.csv', 150, rejects := true);
----
x	60

query II
SELECT line, error_type FROM reject_errors;
----
3	LINE SIZE OVER MAXIMUM

statement ok
DROP TABLE reject_errors;

statement ok
DROP TABLE reject_scans;

query II
SELECT a, length(b) FROM lines('{DATA_DIR}/csv/long_line_buffer_boundary/third_line_long.csv', 150, skip := true);
----
x	60

statement error
SELECT * FROM lines('{DATA_DIR}/csv/long_line_buffer_boundary/third_line_long.csv', 150, serial := true);
----
<REGEX>:.*CSV Error on Line: 3.*Maximum line size of 100 bytes exceeded.*

