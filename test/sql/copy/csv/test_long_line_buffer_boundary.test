SELECT * FROM read_csv('{DATA_DIR}/csv/long_line_buffer_boundary/middle_line_400.csv', buffer_size = 150, max_line_size = 100);
----
<REGEX>:.*Maximum line size of 100 bytes exceeded. Actual Size: at least 230 bytes.*

