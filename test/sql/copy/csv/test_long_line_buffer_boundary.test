# A line of exactly max_line_size bytes is read across the boundary as it is with the default buffer.

statement ok
CREATE TABLE at_limit_boundary AS
FROM read_csv('{DATA_DIR}/csv/long_line_buffer_boundary/middle_line_100.csv', buffer_size = 150, store_rejects = true,
	rejects_table = 'at_limit_boundary_errors', rejects_scan = 'at_limit_boundary_scans', max_line_size = 100,
	auto_detect = false, header = true, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'});

statement ok
CREATE TABLE at_limit_default AS
FROM read_csv('{DATA_DIR}/csv/long_line_buffer_boundary/middle_line_100.csv', store_rejects = true,
	rejects_table = 'at_limit_default_errors', rejects_scan = 'at_limit_default_scans', max_line_size = 100,
	auto_detect = false, header = true, columns = {'a': 'VARCHAR', 'b': 'VARCHAR'});

query I
SELECT (SELECT list(b ORDER BY b) FROM at_limit_boundary) = (SELECT list(b ORDER BY b) FROM at_limit_default);
----
true

query I
SELECT (SELECT list((line, error_type) ORDER BY line) FROM at_limit_boundary_errors) IS NOT DISTINCT FROM
	(SELECT list((line, error_type) ORDER BY line) FROM at_limit_default_errors);
----
true

# A line longer than the buffer is still open at the end of the buffer after the one it starts in, which no line
# within max_line_size is: 400 bytes from byte 70, and 132 bytes from byte 70 with buffer_size=100.

