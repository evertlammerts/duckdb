# A line with an invalid quote across the buffer end (line 3, from byte 90): the scan that finishes it stops there,
# so no line after it is read twice and the line is rejected once.

query II
SELECT count(*), count(DISTINCT a) FROM read_csv('{DATA_DIR}/csv/long_line_buffer_boundary/invalid_quote_across_buffer.csv', max_line_size = 100, buffer_size = 150, store_rejects = true, auto_detect = false, header = true,
	columns = {'a': 'VARCHAR', 'b': 'VARCHAR'});
----
21	21

query II
SELECT line, error_type FROM reject_errors;
----
3	UNQUOTED VALUE

statement ok
