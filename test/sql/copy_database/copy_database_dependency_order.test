statement ok
CREATE TABLE memory.text_dst2 AS FROM memory.catalog_text('dst2')

query I
SELECT count(*) FROM (
	(FROM memory.order_dst2 EXCEPT ALL FROM memory.order_dst)
	UNION ALL
	(FROM memory.order_dst EXCEPT ALL FROM memory.order_dst2)
)
