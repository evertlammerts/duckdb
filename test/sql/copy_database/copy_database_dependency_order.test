# the checkpoint writes entries in the same dependency order: a table with several dependencies, and nested macros,
# survive two checkpoints and reloads, and a copy from the reloaded database

statement ok
USE memory

statement ok
ATTACH '{TEST_DIR}/copy_database_dependency_order.db' AS ck

statement ok
USE ck

statement ok
CREATE SCHEMA s

statement ok
CREATE MACRO s.zinc(x) AS x + 1

statement ok
CREATE MACRO s.adouble_inc(x) AS s.zinc(x) * 2

statement ok
CREATE TYPE s.mood AS ENUM ('ok', 'sad')

statement ok
CREATE SEQUENCE s.seq START 100

statement ok
CREATE TABLE s.tk(id INTEGER DEFAULT nextval('s.seq'), m s.mood DEFAULT 'ok', v INTEGER DEFAULT s.adouble_inc(1), w AS (s.adouble_inc(v)), CHECK (s.adouble_inc(v) < 100))

statement ok
INSERT INTO s.tk (v) VALUES (3)

loop i 0 2

statement ok
CHECKPOINT ck

statement ok
USE memory

statement ok
DETACH ck

statement ok
ATTACH '{TEST_DIR}/copy_database_dependency_order.db' AS ck

statement ok
USE ck

statement ok
INSERT INTO s.tk DEFAULT VALUES

statement error
INSERT INTO s.tk (id, v) VALUES (0, 50)
----
CHECK constraint failed

endloop

query IIII
SELECT id, m, v, w FROM s.tk ORDER BY id
----
100	ok	3	8
101	ok	4	10
102	ok	4	10

# the reload keeps zinc before adouble_inc, which the export needs because CREATE MACRO binds the body

statement ok
EXPORT DATABASE '{TEST_DIR}/copy_database_dependency_order_reloaded'

statement ok
ATTACH ':memory:' AS impk

statement ok
USE impk

statement ok
IMPORT DATABASE '{TEST_DIR}/copy_database_dependency_order_reloaded'

query IIII
SELECT id, m, v, w FROM s.tk ORDER BY id
----
100	ok	3	8
101	ok	4	10
102	ok	4	10

statement ok
ATTACH ':memory:' AS dstk

statement ok
USE dstk

statement ok
COPY FROM DATABASE ck TO dstk

statement ok
INSERT INTO s.tk DEFAULT VALUES

query IIII
SELECT id, m, v, w FROM s.tk ORDER BY id
----
100	ok	3	8
101	ok	4	10
102	ok	4	10
103	ok	4	10

# ownership is a dependency too: a sequence owned by a table and one owned by another sequence copy

statement ok
USE memory

statement ok
ATTACH ':memory:' AS src3

statement ok
USE src3

statement ok
CREATE TABLE owner_table(i INTEGER)

statement ok
CREATE SEQUENCE owned_by_table

statement ok
ALTER SEQUENCE owned_by_table OWNED BY owner_table

statement ok
CREATE SEQUENCE owner_sequence

statement ok
CREATE SEQUENCE owned_by_sequence

statement ok
ALTER SEQUENCE owned_by_sequence OWNED BY owner_sequence

statement error
ALTER SEQUENCE owner_sequence OWNED BY owner_sequence
----
can not become its own owner

statement ok
ATTACH ':memory:' AS dst3

statement ok
USE dst3

statement ok
COPY FROM DATABASE src3 TO dst3

query I
SELECT sequence_name FROM duckdb_sequences() WHERE database_name = 'dst3' ORDER BY sequence_name
----
owned_by_sequence
owned_by_table
owner_sequence
