# the source tables are untouched by the target's triggers
query I
SELECT count(*) FROM src.audit;
----
8

# the schema step alone copies no trigger; the data step creates them after the data, and still fires a trigger
# made in the target by hand
statement ok
USE memory;

statement ok
ATTACH ':memory:' AS split;

statement ok
COPY FROM DATABASE src TO split (SCHEMA);

query I
SELECT count(*) FROM duckdb_triggers() WHERE database_name = 'split';
----
0

statement ok
CREATE TRIGGER by_hand AFTER INSERT ON split.r FOR EACH ROW INSERT INTO split.audit VALUES ('by hand ' || NEW.id);

statement ok
COPY FROM DATABASE src TO split (DATA);

query T rowsort
SELECT msg FROM split.audit WHERE msg LIKE 'by hand%';
----
by hand 10
by hand 11

query I
SELECT count(*) FROM split.audit;
----
10

query I
SELECT count(*) FROM duckdb_triggers() WHERE database_name = 'split';
----
18

# the data step returns one count per table whether or not it creates triggers
statement ok
ATTACH ':memory:' AS res;

statement ok
USE res;

statement ok
CREATE TABLE a AS SELECT range AS i FROM range(3);

statement ok
CREATE TABLE b AS SELECT 1 AS j;

statement ok
CREATE TRIGGER a_insert AFTER INSERT ON a FOR EACH STATEMENT INSERT INTO b VALUES (2);

statement ok
USE memory;

statement ok
ATTACH ':memory:' AS res_dst;

statement ok
COPY FROM DATABASE res TO res_dst (SCHEMA);

query II
EXPLAIN COPY FROM DATABASE res TO res_dst (DATA);
----
physical_plan	<REGEX>:.*Copy Database.*Union.*

query I rowsort
COPY FROM DATABASE res TO res_dst (DATA);
----
1
3

statement ok
DROP TRIGGER a_insert ON res.a;

statement ok
ATTACH ':memory:' AS res_plain;

statement ok
COPY FROM DATABASE res TO res_plain (SCHEMA);

# without a trigger the data step plans as before
query II
EXPLAIN COPY FROM DATABASE res TO res_plain (DATA);
----
physical_plan	<!REGEX>:.*Copy Database.*

query I rowsort
COPY FROM DATABASE res TO res_plain (DATA);
----
1
3

query I
SELECT j FROM res_dst.b;
----
1

# the stored ON clause names the table within the target, without the catalog
query T
SELECT sql FROM duckdb_triggers() WHERE database_name = 'split' AND trigger_name IN ('t_after_insert', 'n_insert', 's_insert') ORDER BY trigger_name;
----
CREATE TRIGGER n_insert AFTER INSERT ON s."inner".n FOR EACH ROW INSERT INTO s."inner".nlog (VALUES (('insert s.inner.n ' || "NEW".id)));
CREATE TRIGGER s_insert AFTER INSERT ON s.t FOR EACH STATEMENT INSERT INTO main.audit (VALUES ('insert s.t'));
CREATE TRIGGER t_after_insert AFTER INSERT ON t FOR EACH STATEMENT INSERT INTO audit (VALUES ('after insert t'));

# a body binds in the target's main schema, as in a session on the target: a trigger in another schema reaches a
# main table without qualification, and a table of the same name in the trigger's schema does not capture it
statement ok
ATTACH ':memory:' AS shadow;

statement ok
USE shadow;

statement ok
CREATE SCHEMA s;

statement ok
CREATE TABLE log(msg VARCHAR);

statement ok
CREATE TABLE s.log(a INTEGER, b INTEGER);

statement ok
CREATE TABLE s.x(id INTEGER);

statement ok
CREATE TRIGGER sx AFTER INSERT ON s.x FOR EACH STATEMENT INSERT INTO log VALUES ('x');

statement ok
INSERT INTO s.x VALUES (1);

statement ok
USE memory;

statement ok
ATTACH ':memory:' AS shadow_dst;

statement ok
COPY FROM DATABASE shadow TO shadow_dst;

statement error
DROP TABLE shadow_dst.main.log;
----
<REGEX>:Dependency Error.*sx.*

statement ok
DROP TABLE shadow_dst.s.log;

statement ok
USE shadow_dst;

statement ok
INSERT INTO s.x VALUES (2);

query T
SELECT msg FROM log;
----
x
x

statement ok
USE memory;

# creation order: a row trigger writing into a table must exist before that table's row trigger, and a trigger
# created before the trigger its body reaches has no dependency on that trigger's tables
statement ok
ATTACH ':memory:' AS ord;

statement ok
USE ord;

statement ok
CREATE TABLE a(id INTEGER);

statement ok
CREATE TABLE b(id INTEGER);

statement ok
CREATE TABLE z(id INTEGER);

statement ok
CREATE TABLE log(msg VARCHAR);

statement ok
CREATE TABLE log2(msg VARCHAR);

statement ok
CREATE TRIGGER tb AFTER INSERT ON b FOR EACH ROW INSERT INTO a VALUES (NEW.id);

statement ok
CREATE TRIGGER ta AFTER INSERT ON a FOR EACH ROW INSERT INTO log VALUES ('a ' || NEW.id);

statement ok
CREATE TRIGGER parent AFTER DELETE ON z FOR EACH STATEMENT DELETE FROM a;

statement ok
CREATE TRIGGER child AFTER DELETE ON a FOR EACH STATEMENT INSERT INTO log2 VALUES ('a deleted');

statement ok
INSERT INTO a VALUES (1);

statement ok
INSERT INTO z VALUES (2);

statement ok
USE memory;

statement ok
ATTACH ':memory:' AS ord_dst;

statement ok
COPY FROM DATABASE ord TO ord_dst;

query T nosort
SELECT trigger_name FROM duckdb_triggers() WHERE database_name = 'ord_dst' ORDER BY trigger_oid;
----
tb
ta
parent
child

query T
SELECT msg FROM ord_dst.log;
----
a 1

statement ok
USE ord_dst;

# firing the cascade fails as it does in the source
statement error
INSERT INTO b VALUES (1);
----
FOR EACH ROW trigger "tb" on table "b" writes to a table that has its own FOR EACH ROW trigger

statement ok
DELETE FROM z;

query T rowsort
SELECT msg FROM log UNION ALL SELECT msg FROM log2;
----
a 1
a deleted

statement ok
DROP TRIGGER child ON a;

statement ok
DROP TABLE log2;

# a body naming the source database cannot exist in the target: the copy fails and leaves the target empty
statement ok
USE memory;

statement ok
ATTACH ':memory:' AS qualified;

statement ok
CREATE TABLE qualified.t(id INTEGER);

statement ok
CREATE TABLE qualified.log(msg VARCHAR);

statement ok
CREATE TRIGGER q AFTER INSERT ON qualified.t FOR EACH STATEMENT INSERT INTO qualified.log VALUES ('q');

statement ok
INSERT INTO qualified.t VALUES (1);

statement ok
ATTACH ':memory:' AS qualified_dst;

statement error
COPY FROM DATABASE qualified TO qualified_dst;
----
<REGEX>:Binder Error.*Trigger "q" cannot reference "log" from a different catalog \("qualified"\).*

query II
SELECT (SELECT count(*) FROM duckdb_tables() WHERE database_name = 'qualified_dst'), (SELECT count(*) FROM duckdb_triggers() WHERE database_name = 'qualified_dst');
----
0	0

# the split form keeps the committed schema step and rolls back the data step
statement ok
COPY FROM DATABASE qualified TO qualified_dst (SCHEMA);

statement error
COPY FROM DATABASE qualified TO qualified_dst (DATA);
----
<REGEX>:Binder Error.*Trigger "q" cannot reference "log" from a different catalog \("qualified"\).*

query III
SELECT (SELECT count(*) FROM duckdb_tables() WHERE database_name = 'qualified_dst'), (SELECT count(*) FROM qualified_dst.t), (SELECT count(*) FROM duckdb_triggers() WHERE database_name = 'qualified_dst');
----
2	0	0

# a target whose storage version has no triggers rejects the copy
statement ok
ATTACH '{TEST_DIR}/copy_database_triggers_old.db' AS old_storage (STORAGE_VERSION 'v1.0.0');

statement error
COPY FROM DATABASE ord TO old_storage;
----
CREATE TRIGGER is only supported for storage versions v2.0.0 and higher

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'old_storage';
----
0

# the copied triggers persist in creation order in a file target
statement ok
ATTACH '{TEST_DIR}/copy_database_triggers.db' AS persisted (STORAGE_VERSION 'v2.0.0');

statement ok
COPY FROM DATABASE ord TO persisted;

statement ok
CHECKPOINT persisted;

statement ok
DETACH persisted;

statement ok
ATTACH '{TEST_DIR}/copy_database_triggers.db' AS persisted;

query T nosort
SELECT trigger_name FROM duckdb_triggers() WHERE database_name = 'persisted' ORDER BY trigger_oid;
----
tb
ta
parent
child

statement ok
USE persisted;

statement ok
INSERT INTO a VALUES (3);

query T rowsort
SELECT msg FROM log;
----
a 1
a 3
