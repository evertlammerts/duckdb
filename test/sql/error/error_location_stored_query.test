# name: test/sql/error/error_location_stored_query.test
# description: An error raised while a stored view or prepared body is bound points at the reference that pulled it in
# group: [error]

statement ok
CREATE TABLE src (a INTEGER, b INTEGER);

statement ok
CREATE VIEW v AS SELECT a FROM src;

statement ok
CREATE VIEW v_b AS SELECT b FROM src;

statement ok
CREATE VIEW vv AS SELECT * FROM v;

statement ok
CREATE VIEW v_one AS SELECT 1 AS a;

statement ok
CREATE MACRO tm() AS TABLE SELECT a FROM src;

statement ok
CREATE MACRO tm_over_view() AS TABLE SELECT a FROM v;

statement ok
CREATE VIEW v_over_tm AS SELECT * FROM tm();

statement ok
PREPARE p_over_view AS SELECT 1 AS first_column, 2 AS second_column, a FROM v;

statement ok
ALTER TABLE src DROP COLUMN b;

statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM v_b
----
LINE 1: SELECT 1 AS first_column, 2 AS second_column, * FROM v_b
                                                             ^^^

statement ok
DROP TABLE src;

statement error
SELECT 1 AS first_column, 2 AS second_column, v.a FROM v
----
LINE 1: SELECT 1 AS first_column, 2 AS second_column, v.a FROM v
                                                               ^

statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM vv
----
LINE 1: SELECT 1 AS first_column, 2 AS second_column, * FROM vv
                                                             ^^

statement error
SELECT * FROM v AS aliased_view, range(3) r
----
LINE 1: SELECT * FROM v AS aliased_view, range(3) r
                      ^

statement error
SELECT 1 AS first_column, (SELECT max(a) FROM v) AS second_column
----
LINE 1: SELECT 1 AS first_column, (SELECT max(a) FROM v) AS second_column
                                                      ^

statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM tm_over_view()
----
LINE 1: SELECT 1 AS first_column, 2 AS second_column, * FROM tm_over_view()
                                                             ^^^^^^^^^^^^^^

statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM v_over_tm
----
LINE 1: SELECT 1 AS first_column, 2 AS second_column, * FROM v_over_tm
                                                             ^^^^^^^^^

# the body of a scalar macro that a view calls is expanded while the view is bound, after its copy was rewritten
statement ok
CREATE TABLE macro_src (a INTEGER);

statement ok
CREATE MACRO scalar_over_src() AS (SELECT max(a) FROM macro_src);

statement ok
CREATE VIEW v_over_macro AS SELECT scalar_over_src() AS x;

statement ok
DROP TABLE macro_src;

statement error
SELECT 1 AS first_column, 2 AS second_column, x FROM v_over_macro
----
LINE 1: SELECT 1 AS first_column, 2 AS second_column, x FROM v_over_macro
                                                             ^^^^^^^^^^^^

# a view bound for its columns alone has no reference to point at
statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM pragma_table_info('v')
----
Table with name src does not exist

statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM pragma_table_info('v')
----
<!REGEX>:.*LINE 1:.*

# an error the outer query raises against the view keeps having no location
statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM v_one AS x(a, b)
----
has 1 columns available but 2 columns specified

statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM v_one AS x(a, b)
----
<!REGEX>:.*LINE 1:.*

statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM tm()
----
LINE 1: SELECT 1 AS first_column, 2 AS second_column, * FROM tm()
                                                             ^^^^

statement error
SELECT 1 AS first_column, 2 AS second_column, missing_column FROM range(1)
----
LINE 1: SELECT 1 AS first_column, 2 AS second_column, missing_column FROM range(1)
                                                      ^^^^^^^^^^^^^^

# parts of a view body outside its expression tree: a cast's target type, a pivot column, a NEAREST ranking expression,
# the input of MATCH_RECOGNIZE and the key of a recursive CTE
statement ok
CREATE TYPE mood AS ENUM ('happy');

statement ok
CREATE VIEW v_type AS SELECT 'happy'::mood AS m;

statement ok
DROP TYPE mood;

statement error
SELECT 1 AS first_column, 2 AS second_column, m FROM v_type
----
LINE 1: SELECT 1 AS first_column, 2 AS second_column, m FROM v_type
                                                             ^^^^^^

statement ok
CREATE TABLE pivot_src (k INTEGER, c VARCHAR, val INTEGER);

statement ok
CREATE VIEW v_pivot AS SELECT * FROM (PIVOT pivot_src ON c IN ('a') USING sum(val) GROUP BY k);

statement ok
ALTER TABLE pivot_src RENAME c TO c2;

statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM v_pivot
----
LINE 1: SELECT 1 AS first_column, 2 AS second_column, * FROM v_pivot
                                                             ^^^^^^^

statement ok
CREATE TABLE nearest_left (id INTEGER, e FLOAT[2]);

statement ok
CREATE TABLE nearest_right (id INTEGER, e FLOAT[2]);

statement ok
CREATE VIEW v_nearest AS SELECT l.id FROM nearest_left l JOIN nearest_right r NEAREST 1 BY DISTANCE array_distance(l.e, r.e);

statement ok
ALTER TABLE nearest_right RENAME e TO e2;

statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM v_nearest
----
LINE 1: SELECT 1 AS first_column, 2 AS second_column, * FROM v_nearest
                                                             ^^^^^^^^^

statement ok
CREATE TABLE match_src (p INTEGER, o INTEGER, v INTEGER);

statement ok
CREATE VIEW v_match AS SELECT * FROM (SELECT p, o, v FROM match_src) MATCH_RECOGNIZE (PARTITION BY p ORDER BY o MEASURES FIRST(o) AS ms ONE ROW PER MATCH PATTERN (A) DEFINE A AS true);

statement ok
ALTER TABLE match_src RENAME v TO v2;

statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM v_match
----
LINE 1: SELECT 1 AS first_column, 2 AS second_column, * FROM v_match
                                                             ^^^^^^^

statement ok
CREATE TABLE key_src (a INTEGER);

statement ok
CREATE VIEW v_key AS WITH RECURSIVE t USING KEY (a) AS (SELECT * FROM key_src UNION ALL SELECT * FROM t WHERE false) SELECT * FROM t;

statement ok
ALTER TABLE key_src RENAME a TO a2;

statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM v_key
----
LINE 1: SELECT 1 AS first_column, 2 AS second_column, * FROM v_key
                                                             ^^^^^

statement ok
CREATE TABLE prepared_src (a INTEGER);

statement ok
PREPARE p AS SELECT 1 AS first_column, 2 AS second_column, a FROM prepared_src;

statement ok
DROP TABLE prepared_src;

# the EXECUTE statement carries no location of its own, so an error from the prepared body has none
statement error
EXECUTE p /* a comment that makes this statement longer than the prepared text */
----
Table with name prepared_src does not exist

statement error
EXECUTE p /* a comment that makes this statement longer than the prepared text */
----
<!REGEX>:.*LINE 1:.*

statement error
EXPLAIN EXECUTE p /* a comment that makes this statement longer than the prepared text */
----
Table with name prepared_src does not exist

statement error
EXPLAIN EXECUTE p /* a comment that makes this statement longer than the prepared text */
----
<!REGEX>:.*LINE 1:.*

statement error
EXECUTE p_over_view /* a comment that makes this statement longer than the prepared text */
----
Table with name src does not exist

statement error
EXECUTE p_over_view /* a comment that makes this statement longer than the prepared text */
----
<!REGEX>:.*LINE 1:.*

# an error in an EXECUTE parameter is raised in the EXECUTE text and keeps its place
statement ok
PREPARE p_param AS SELECT $x::INTEGER AS x;

statement error
EXECUTE p_param(x := no_such_function(1))
----
LINE 1: EXECUTE p_param(x := no_such_function(1))
                             ^

statement ok
SET errors_as_json = true;

statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM vv
----
<REGEX>:.*"position":"53".*

statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM vv
----
<REGEX>:.*"location":"\[53,2\]".*

statement error
EXECUTE p
----
<REGEX>:.*prepared_src does not exist.*

statement error
EXECUTE p
----
<!REGEX>:.*"position".*

statement error
EXECUTE p
----
<!REGEX>:.*"location".*

statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM pragma_table_info('v')
----
<REGEX>:.*src does not exist.*

statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM pragma_table_info('v')
----
<!REGEX>:.*"position".*

statement error
SELECT 1 AS first_column, 2 AS second_column, * FROM pragma_table_info('v')
----
<!REGEX>:.*"location".*

statement error
SELECT * FROM pragma_table_info('v_over_tm')
----
<REGEX>:.*Table with name src does not exist.*

statement error
SELECT * FROM pragma_table_info('v_over_tm')
----
<!REGEX>:.*"location".*

statement error
SELECT * FROM pragma_table_info('v_over_macro')
----
<REGEX>:.*Table with name macro_src does not exist.*

statement error
SELECT * FROM pragma_table_info('v_over_macro')
----
<!REGEX>:.*"location".*
