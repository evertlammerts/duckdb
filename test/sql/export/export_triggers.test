# triggers are recreated in creation order: a row trigger writing into a table must exist before that table's row
# trigger, and a trigger created before the trigger its body reaches has no dependency on that trigger's tables
statement ok
ATTACH ':memory:' AS ord;

statement ok
USE ord;

statement ok
CREATE TABLE a(id INTEGER);

statement ok
CREATE TABLE b(id INTEGER);

statement ok
CREATE TABLE z(id INTEGER);

statement ok
CREATE TABLE log(msg VARCHAR);

statement ok
CREATE TABLE log2(msg VARCHAR);

statement ok
CREATE TRIGGER tb AFTER INSERT ON b FOR EACH ROW INSERT INTO a VALUES (NEW.id);

statement ok
CREATE TRIGGER ta AFTER INSERT ON a FOR EACH ROW INSERT INTO log VALUES ('a ' || NEW.id);

statement ok
CREATE TRIGGER parent AFTER DELETE ON z FOR EACH STATEMENT DELETE FROM a;

statement ok
CREATE TRIGGER child AFTER DELETE ON a FOR EACH STATEMENT INSERT INTO log2 VALUES ('a deleted');

# MERGE and WITH bodies
statement ok
CREATE TRIGGER z_merge AFTER INSERT ON z FOR EACH STATEMENT MERGE INTO log USING (SELECT 'merged' AS msg) src ON log.msg = src.msg WHEN NOT MATCHED THEN INSERT VALUES (src.msg);

statement ok
CREATE TABLE w(id INTEGER);

statement ok
CREATE TRIGGER w_with AFTER INSERT ON w FOR EACH STATEMENT WITH cte AS (SELECT 'with ' || count(*) AS msg FROM w) INSERT INTO log SELECT msg FROM cte;

statement error
INSERT INTO b VALUES (1);
----
FOR EACH ROW trigger "tb" on table "b" writes to a table that has its own FOR EACH ROW trigger

statement ok
EXPORT DATABASE ord TO '{TEST_DIR}/export_triggers_order';

query T nosort
SELECT line FROM (SELECT unnest(string_split(content, chr(10))) AS line FROM read_text('{TEST_DIR}/export_triggers_order/load.sql')) WHERE line LIKE 'CREATE TRIGGER%';
----
CREATE TRIGGER tb AFTER INSERT ON b FOR EACH ROW INSERT INTO a (VALUES ("NEW".id));
CREATE TRIGGER ta AFTER INSERT ON a FOR EACH ROW INSERT INTO log (VALUES (('a ' || "NEW".id)));
CREATE TRIGGER parent AFTER DELETE ON z FOR EACH STATEMENT DELETE FROM a;
CREATE TRIGGER child AFTER DELETE ON a FOR EACH STATEMENT INSERT INTO log2 (VALUES ('a deleted'));
CREATE TRIGGER z_merge AFTER INSERT ON z FOR EACH STATEMENT MERGE INTO log USING (SELECT 'merged' AS msg) AS src ON (log.msg = src.msg) WHEN NOT MATCHED THEN INSERT VALUES (src.msg);
CREATE TRIGGER w_with AFTER INSERT ON w FOR EACH STATEMENT WITH cte AS (SELECT ('with ' || count_star()) AS msg FROM w) INSERT INTO log SELECT msg FROM cte;

statement ok
ATTACH ':memory:' AS ord_dst;

statement ok
USE ord_dst;

statement ok
IMPORT DATABASE '{TEST_DIR}/export_triggers_order'

