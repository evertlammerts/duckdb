# load.sql accepts CREATE TRIGGER besides COPY, and still rejects any other statement
statement ok
COPY (SELECT 'CREATE TABLE extra(i INTEGER);') TO '{TEST_DIR}/export_triggers_order/load.sql' (HEADER false, QUOTE '', DELIMITER '|');

statement ok
ATTACH ':memory:' AS rejected;

statement ok
USE rejected;

statement error
