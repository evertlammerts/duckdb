# triggers of an attached database whose ON clause names the catalog, two of them with the same name
statement ok
ATTACH ':memory:' AS src;

statement ok
USE src;

statement ok
CREATE TABLE base(id INTEGER);

statement ok
CREATE TABLE other(id INTEGER);

statement ok
CREATE TABLE log(msg VARCHAR);

statement ok
CREATE TRIGGER same_name AFTER INSERT ON src.base FOR EACH STATEMENT INSERT INTO log VALUES ('base');

statement ok
CREATE TRIGGER same_name AFTER INSERT ON src.main.other FOR EACH STATEMENT INSERT INTO log VALUES ('other');

# bodies that name their own catalog, which the export drops as CREATE VIEW does for a view's body
statement ok
CREATE TABLE own(id INTEGER);

statement ok
CREATE TRIGGER own_insert AFTER INSERT ON own FOR EACH STATEMENT INSERT INTO src.main.log SELECT 'own ' || count(*) FROM src.main.other;

statement ok
CREATE TRIGGER own_delete AFTER DELETE ON own FOR EACH ROW INSERT INTO src.log SELECT 'deleted ' || OLD.id || ' beside ' || src.main.other.id FROM src.other;

# PIVOT, UNPIVOT and MATCH_RECOGNIZE over a table named with its own catalog, in trigger bodies and in a view
statement ok
CREATE TABLE p(kind VARCHAR, v INTEGER);

statement ok
INSERT INTO p VALUES ('a', 5), ('a', 7);

statement ok
CREATE VIEW pivoted AS SELECT * FROM src.main.p PIVOT (sum(v) FOR kind IN ('a'));

statement ok
CREATE TABLE shaped(id INTEGER);

statement ok
CREATE TRIGGER shaped_pivot AFTER INSERT ON shaped FOR EACH STATEMENT INSERT INTO log SELECT 'pivot ' || a FROM src.main.p PIVOT (sum(v) FOR kind IN ('a'));

statement ok
CREATE TRIGGER shaped_match AFTER UPDATE ON shaped FOR EACH STATEMENT INSERT INTO log SELECT 'match ' || n FROM src.main.p MATCH_RECOGNIZE (ORDER BY v MEASURES count(*) AS n PATTERN (A+) DEFINE A AS v > 0);

statement ok
CREATE TRIGGER shaped_unpivot AFTER DELETE ON shaped FOR EACH STATEMENT INSERT INTO log SELECT 'unpivot ' || val FROM src.p UNPIVOT (val FOR col IN (v));

# a leading name spelled like the catalog that the binder reads as a table or as a struct column keeps its place
statement ok
CREATE TABLE src(c STRUCT(f INTEGER));

statement ok
CREATE TABLE x(c STRUCT(f INTEGER));

statement ok
INSERT INTO src VALUES ({'f': 1});

statement ok
INSERT INTO x VALUES ({'f': 2});

statement ok
CREATE TABLE payload(src STRUCT(a STRUCT(v INTEGER)), a STRUCT(v INTEGER));

statement ok
INSERT INTO payload VALUES ({'a': {'v': 1}}, {'v': 2});

statement ok
CREATE TABLE spelled(id INTEGER);

statement ok
CREATE TRIGGER spelled_table AFTER INSERT ON spelled FOR EACH STATEMENT INSERT INTO log SELECT 'table ' || src.c.f FROM src, x;

statement ok
CREATE TRIGGER spelled_struct AFTER DELETE ON spelled FOR EACH STATEMENT INSERT INTO log SELECT 'struct ' || src.a.v FROM payload;

# fired once in the source, so the exported log holds the rows the source writes
statement ok
INSERT INTO shaped VALUES (1);

statement ok
UPDATE shaped SET id = 2;

statement ok
DELETE FROM shaped;

statement ok
INSERT INTO spelled VALUES (1);

statement ok
DELETE FROM spelled;

query T rowsort
SELECT msg FROM src.log;
----
match 2
pivot 12
struct 1
table 1
unpivot 5
unpivot 7

statement ok
EXPORT DATABASE src TO '{TEST_DIR}/export_triggers_catalog';

query T
SELECT line FROM (SELECT unnest(string_split(content, chr(10))) AS line FROM read_text('{TEST_DIR}/export_triggers_catalog/load.sql')) WHERE line LIKE 'CREATE TRIGGER%' ORDER BY line;
----
CREATE TRIGGER own_delete AFTER DELETE ON own FOR EACH ROW INSERT INTO log SELECT ((('deleted ' || "OLD".id) || ' beside ') || main.other.id) FROM other;
CREATE TRIGGER own_insert AFTER INSERT ON own FOR EACH STATEMENT INSERT INTO main.log SELECT ('own ' || count_star()) FROM main.other;
CREATE TRIGGER same_name AFTER INSERT ON base FOR EACH STATEMENT INSERT INTO log (VALUES ('base'));
CREATE TRIGGER same_name AFTER INSERT ON other FOR EACH STATEMENT INSERT INTO log (VALUES ('other'));
CREATE TRIGGER shaped_match AFTER UPDATE ON shaped FOR EACH STATEMENT INSERT INTO log SELECT ('match ' || n) FROM main.p MATCH_RECOGNIZE(ORDER BY v MEASURES count_star() AS n PATTERN (A+) DEFINE A AS (v > 0));
CREATE TRIGGER shaped_pivot AFTER INSERT ON shaped FOR EACH STATEMENT INSERT INTO log SELECT ('pivot ' || a) FROM main.p PIVOT (sum(v) FOR (kind) IN ('a'));
CREATE TRIGGER shaped_unpivot AFTER DELETE ON shaped FOR EACH STATEMENT INSERT INTO log SELECT ('unpivot ' || val) FROM p UNPIVOT (val FOR col IN (v));
CREATE TRIGGER spelled_struct AFTER DELETE ON spelled FOR EACH STATEMENT INSERT INTO log SELECT ('struct ' || src.a.v) FROM payload;
CREATE TRIGGER spelled_table AFTER INSERT ON spelled FOR EACH STATEMENT INSERT INTO log SELECT ('table ' || src.c.f) FROM src , x;

