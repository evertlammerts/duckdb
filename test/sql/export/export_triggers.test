# creation order survives checkpoints and reloads, across schemas
statement ok
ATTACH '{TEST_DIR}/export_triggers_restart.db' AS persisted (STORAGE_VERSION 'v2.0.0');

statement ok
USE persisted;

statement ok
CREATE SCHEMA z;

statement ok
CREATE TABLE a(id INTEGER);

statement ok
CREATE TABLE z.b(id INTEGER);

statement ok
CREATE TABLE log(msg VARCHAR);

statement ok
CREATE TRIGGER tb AFTER INSERT ON z.b FOR EACH ROW INSERT INTO main.a VALUES (NEW.id);

statement ok
CREATE TABLE c(id INTEGER);

statement ok
CREATE TRIGGER tc AFTER INSERT ON c FOR EACH STATEMENT INSERT INTO main.log VALUES ('c');

statement ok
CREATE TRIGGER ta AFTER INSERT ON a FOR EACH ROW INSERT INTO main.log VALUES ('a ' || NEW.id);

statement ok
CHECKPOINT persisted;

statement ok
USE rejected;

statement ok
DETACH persisted;

statement ok
ATTACH '{TEST_DIR}/export_triggers_restart.db' AS persisted;

query TT
SELECT schema_name, trigger_name FROM duckdb_triggers() WHERE database_name = 'persisted' ORDER BY trigger_oid;
----
z	tb
main	tc
main	ta

# a second checkpoint and reload keep the order
statement ok
CREATE TABLE persisted.extra(i INTEGER);

statement ok
CHECKPOINT persisted;

statement ok
DETACH persisted;

statement ok
ATTACH '{TEST_DIR}/export_triggers_restart.db' AS persisted;

query TT
SELECT schema_name, trigger_name FROM duckdb_triggers() WHERE database_name = 'persisted' ORDER BY trigger_oid;
----
z	tb
main	tc
main	ta

