# name: test/sql/export/export_triggers.test
# description: EXPORT DATABASE writes the triggers, and IMPORT DATABASE recreates them after the data is loaded
# group: [export]

require noforcestorage

statement ok
BEGIN TRANSACTION

statement ok
CREATE TABLE audit(msg VARCHAR);

statement ok
CREATE TABLE counters(n INTEGER);

statement ok
INSERT INTO counters VALUES (0);

statement ok
CREATE TABLE t(id INTEGER, v VARCHAR);

statement ok
CREATE TRIGGER t_before_insert BEFORE INSERT ON t FOR EACH STATEMENT INSERT INTO audit VALUES ('before insert t');

statement ok
CREATE TRIGGER t_after_insert AFTER INSERT ON t INSERT INTO audit VALUES ('after insert t');

statement ok
CREATE TRIGGER t_update_of AFTER UPDATE OF v ON t FOR EACH STATEMENT UPDATE counters SET n = n + 1;

statement ok
CREATE TRIGGER t_before_delete BEFORE DELETE ON t FOR EACH STATEMENT DELETE FROM audit WHERE msg = 'gone';

statement ok
CREATE TABLE r(id INTEGER);

statement ok
CREATE TRIGGER r_row_insert AFTER INSERT ON r FOR EACH ROW INSERT INTO audit VALUES ('row insert ' || NEW.id);

statement ok
CREATE TRIGGER r_row_delete AFTER DELETE ON r FOR EACH ROW INSERT INTO audit VALUES ('row delete ' || OLD.id);

statement ok
CREATE TABLE x(id INTEGER);

statement ok
CREATE TRIGGER x_new_rows AFTER INSERT ON x REFERENCING NEW TABLE AS new_rows FOR EACH STATEMENT INSERT INTO audit SELECT 'new ' || id FROM new_rows;

statement ok
CREATE TRIGGER x_old_rows AFTER DELETE ON x REFERENCING OLD TABLE AS old_rows FOR EACH STATEMENT INSERT INTO audit SELECT 'old ' || id FROM old_rows;

statement ok
CREATE TABLE upserted(k INTEGER PRIMARY KEY, hits INTEGER);

statement ok
CREATE TABLE u(id INTEGER);

statement ok
CREATE TRIGGER u_upsert AFTER INSERT ON u FOR EACH STATEMENT INSERT INTO upserted VALUES (1, 1) ON CONFLICT (k) DO UPDATE SET hits = upserted.hits + 1;

statement ok
CREATE TABLE uu(id INTEGER);

statement ok
CREATE TRIGGER uu_both AFTER UPDATE ON uu REFERENCING OLD TABLE AS o NEW TABLE AS n FOR EACH STATEMENT INSERT INTO audit SELECT 'update ' || o.id || ' to ' || n.id FROM o, n;

# names that need quoting, a quote in a string literal
statement ok
CREATE TABLE "Mixed Case"("Odd Col" INTEGER, "select" INTEGER);

statement ok
CREATE TRIGGER "Trigger ""Quoted""" AFTER UPDATE OF "Odd Col", "select" ON "Mixed Case" FOR EACH STATEMENT INSERT INTO audit VALUES ('it''s quoted');

# a body that calls a macro and one that reads a view, both defined in the export
statement ok
CREATE MACRO tag(x) AS 'macro ' || x;

statement ok
CREATE VIEW audit_count AS SELECT count(*) AS n FROM audit;

statement ok
CREATE TABLE m(id INTEGER);

statement ok
CREATE TRIGGER m_macro AFTER INSERT ON m FOR EACH ROW INSERT INTO audit VALUES (tag(NEW.id));

statement ok
CREATE TRIGGER m_view AFTER DELETE ON m FOR EACH STATEMENT INSERT INTO audit SELECT 'count ' || n FROM audit_count;

# a trigger on a table in another schema, created through the search path, beside a table of the same name in main
statement ok
CREATE SCHEMA s;

statement ok
CREATE TABLE s.t(id INTEGER);

statement ok
SET search_path = 's';

statement ok
CREATE TRIGGER s_insert AFTER INSERT ON t FOR EACH STATEMENT INSERT INTO main.audit VALUES ('insert s.t');

statement ok
SET search_path = 'main';

statement ok
CREATE SCHEMA s.inner;

statement ok
CREATE TABLE s.inner.n(id INTEGER);

statement ok
CREATE TRIGGER n_insert AFTER INSERT ON s.inner.n FOR EACH ROW INSERT INTO main.audit VALUES ('insert s.inner.n ' || NEW.id);

# data loaded before the export, through the triggers
statement ok
INSERT INTO t VALUES (1, 'a'), (2, 'b');

statement ok
INSERT INTO r VALUES (10), (11);

statement ok
INSERT INTO x VALUES (20);

statement ok
INSERT INTO u VALUES (30);

statement ok
INSERT INTO m VALUES (40);

statement ok
INSERT INTO uu VALUES (70);

statement ok
INSERT INTO s.t VALUES (50);

statement ok
INSERT INTO s.inner.n VALUES (60);

query T rowsort
SELECT msg FROM audit;
----
after insert t
before insert t
insert s.inner.n 60
insert s.t
macro 40
new 20
row insert 10
row insert 11

query II
SELECT * FROM upserted;
----
1	1

query TTTTTTT
SELECT schema_name, table_name, trigger_name, action_timing, event_manipulation, columns, for_each FROM duckdb_triggers() ORDER BY ALL;
----
inner	n	n_insert	AFTER	INSERT	[]	ROW
main	Mixed Case	Trigger "Quoted"	AFTER	UPDATE	[Odd Col, select]	STATEMENT
main	m	m_macro	AFTER	INSERT	[]	ROW
main	m	m_view	AFTER	DELETE	[]	STATEMENT
main	r	r_row_delete	AFTER	DELETE	[]	ROW
main	r	r_row_insert	AFTER	INSERT	[]	ROW
main	t	t_after_insert	AFTER	INSERT	[]	STATEMENT
main	t	t_before_delete	BEFORE	DELETE	[]	STATEMENT
main	t	t_before_insert	BEFORE	INSERT	[]	STATEMENT
main	t	t_update_of	AFTER	UPDATE	[v]	STATEMENT
main	u	u_upsert	AFTER	INSERT	[]	STATEMENT
main	uu	uu_both	AFTER	UPDATE	[]	STATEMENT
main	x	x_new_rows	AFTER	INSERT	[]	STATEMENT
main	x	x_old_rows	AFTER	DELETE	[]	STATEMENT
s	t	s_insert	AFTER	INSERT	[]	STATEMENT

statement ok
EXPORT DATABASE '{TEST_DIR}/export_triggers' (FORMAT CSV);

statement ok
ROLLBACK

# the triggers come after every COPY of load.sql, and none is in schema.sql
query I
SELECT count(*) FROM read_text('{TEST_DIR}/export_triggers/schema.sql') WHERE content LIKE '%TRIGGER%';
----
0

query I
SELECT regexp_matches(content, '^(COPY[^\n]*\n)+(CREATE TRIGGER[^\n]*\n)+$') FROM read_text('{TEST_DIR}/export_triggers/load.sql');
----
true

query T
SELECT line FROM (SELECT unnest(string_split(content, chr(10))) AS line FROM read_text('{TEST_DIR}/export_triggers/load.sql')) WHERE line LIKE 'CREATE TRIGGER%' ORDER BY line;
----
CREATE TRIGGER "Trigger ""Quoted""" AFTER UPDATE OF "Odd Col", "select" ON "Mixed Case" FOR EACH STATEMENT INSERT INTO audit (VALUES ('it''s quoted'));
CREATE TRIGGER m_macro AFTER INSERT ON m FOR EACH ROW INSERT INTO audit (VALUES (tag("NEW".id)));
CREATE TRIGGER m_view AFTER DELETE ON m FOR EACH STATEMENT INSERT INTO audit SELECT ('count ' || n) FROM audit_count;
CREATE TRIGGER n_insert AFTER INSERT ON s."inner".n FOR EACH ROW INSERT INTO main.audit (VALUES (('insert s.inner.n ' || "NEW".id)));
CREATE TRIGGER r_row_delete AFTER DELETE ON r FOR EACH ROW INSERT INTO audit (VALUES (('row delete ' || "OLD".id)));
CREATE TRIGGER r_row_insert AFTER INSERT ON r FOR EACH ROW INSERT INTO audit (VALUES (('row insert ' || "NEW".id)));
CREATE TRIGGER s_insert AFTER INSERT ON s.t FOR EACH STATEMENT INSERT INTO main.audit (VALUES ('insert s.t'));
CREATE TRIGGER t_after_insert AFTER INSERT ON t FOR EACH STATEMENT INSERT INTO audit (VALUES ('after insert t'));
CREATE TRIGGER t_before_delete BEFORE DELETE ON t FOR EACH STATEMENT DELETE FROM audit WHERE (msg = 'gone');
CREATE TRIGGER t_before_insert BEFORE INSERT ON t FOR EACH STATEMENT INSERT INTO audit (VALUES ('before insert t'));
CREATE TRIGGER t_update_of AFTER UPDATE OF v ON t FOR EACH STATEMENT UPDATE counters SET n = (n + 1);
CREATE TRIGGER u_upsert AFTER INSERT ON u FOR EACH STATEMENT INSERT INTO upserted (VALUES (1, 1)) ON CONFLICT (k) DO UPDATE SET hits = (upserted.hits + 1);
CREATE TRIGGER uu_both AFTER UPDATE ON uu REFERENCING NEW TABLE AS n OLD TABLE AS o FOR EACH STATEMENT INSERT INTO audit SELECT ((('update ' || o.id) || ' to ') || n.id) FROM o , n;
CREATE TRIGGER x_new_rows AFTER INSERT ON x REFERENCING NEW TABLE AS new_rows FOR EACH STATEMENT INSERT INTO audit SELECT ('new ' || id) FROM new_rows;
CREATE TRIGGER x_old_rows AFTER DELETE ON x REFERENCING OLD TABLE AS old_rows FOR EACH STATEMENT INSERT INTO audit SELECT ('old ' || id) FROM old_rows;

statement ok
IMPORT DATABASE '{TEST_DIR}/export_triggers'

