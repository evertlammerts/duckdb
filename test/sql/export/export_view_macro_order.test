query I
SELECT unnest(string_split(rtrim(content, chr(10)), chr(10))) FROM read_text('{TEST_DIR}/export_view_macro_order_2/schema.sql')
----
CREATE MACRO yinc (x) AS ((x + 1));
CREATE MACRO amacro () AS (42), (x) AS (yinc(x));
CREATE TABLE t(i INTEGER DEFAULT(amacro()));
CREATE MACRO zm (x) AS ((x + 1));
CREATE VIEW mv AS SELECT zm(1) AS y;
CREATE MACRO am () AS ((SELECT (y * 100) FROM mv));
CREATE VIEW zv AS SELECT 7 AS c;
CREATE MACRO mtm () AS TABLE (SELECT c FROM zv);
CREATE MACRO zinc (x) AS ((x + 2));
CREATE MACRO adouble (x) AS ((zinc(x) * 2));
CREATE VIEW b AS SELECT 4 AS n;
CREATE VIEW c AS SELECT (n + 1) AS n FROM b;
CREATE VIEW a AS SELECT (n * 10) AS n FROM c;
CREATE VIEW av AS SELECT (c * 2) AS d FROM mtm();

statement ok
ATTACH ':memory:' AS imp2

statement ok
USE imp2

statement ok
IMPORT DATABASE '{TEST_DIR}/export_view_macro_order_2'

