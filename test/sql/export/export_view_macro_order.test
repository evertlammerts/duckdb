CREATE SCHEMA s;
CREATE SCHEMA s.n;
CREATE VIEW s.z AS SELECT 1 AS k;
CREATE VIEW s.a AS SELECT (k + 1) AS k FROM z;
CREATE MACRO s.tm () AS TABLE (SELECT k FROM s.a);
CREATE VIEW y AS SELECT 5 AS k;
CREATE MACRO s.am () AS ((SELECT max(k) FROM y));
CREATE VIEW b AS SELECT (k * 3) AS k FROM s.tm();
CREATE VIEW z AS SELECT 100 AS k;
CREATE VIEW s.n.zz AS SELECT 8 AS k;
CREATE VIEW s.n.aa AS SELECT k FROM zz;
CREATE VIEW s.ab AS SELECT (k + 1) AS k FROM s.n.aa;

