EXPORT DATABASE '{TEST_DIR}/export_view_macro_order_9'

query I
SELECT unnest(string_split(rtrim(content, chr(10)), chr(10))) FROM read_text('{TEST_DIR}/export_view_macro_order_9/schema.sql')
----
CREATE SCHEMA s;
CREATE MACRO m1 (x) AS ((x + 1));
CREATE VIEW b AS SELECT 1 AS x;
CREATE MACRO foo () AS TABLE (SELECT * FROM b);
CREATE MACRO foo () AS (10);
CREATE MACRO bar () AS (((SELECT x FROM foo()) + foo()));
CREATE MACRO s.zz (x) AS ((x * 7));
CREATE MACRO qa () AS (s.zz(1));
CREATE VIEW a1 AS (SELECT x FROM b) UNION ALL (WITH b AS (SELECT 2 AS x) SELECT x FROM b);
CREATE VIEW a2 AS WITH b AS (SELECT (x + 1) AS x FROM b) SELECT x FROM b;
CREATE VIEW a3 AS SELECT (WITH b AS (SELECT 9 AS x) SELECT x FROM b) AS k, x FROM b;
CREATE VIEW a4 AS WITH RECURSIVE zc (x) AS ((SELECT 1) UNION ALL (SELECT (x + 1) FROM zc WHERE (x < 3))) SELECT count_star() AS n FROM zc;
CREATE VIEW z AS (SELECT 1 AS x) UNION ALL (SELECT 2);
CREATE VIEW a5 AS SELECT * FROM (SELECT x FROM z) MATCH_RECOGNIZE(ORDER BY x MEASURES count_star() AS c ONE ROW PER MATCH PATTERN (A+) DEFINE A AS (x > 0));
CREATE VIEW a6 AS SELECT * FROM z PIVOT (count_star() FOR (m1(x)) IN (2, 3));
CREATE VIEW zc AS SELECT (n * 2) AS n FROM a4;

statement ok
ATTACH ':memory:' AS imp9

statement ok
USE imp9

statement ok
IMPORT DATABASE '{TEST_DIR}/export_view_macro_order_9'

