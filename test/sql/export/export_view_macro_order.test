# names the binder never binds (an unused CTE, a macro argument the expansion drops, unnest, a recurring table, a
# temporary macro that shadows) give no edge, so the old order stays, and a recorded dependency is kept

statement ok
ATTACH ':memory:' AS src10

statement ok
USE src10

statement ok
DETACH src9

statement ok
DETACH imp9

statement ok
DETACH cp9

statement ok
