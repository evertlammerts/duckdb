# a common table expression only hides a view inside its own scope, and a body that is no set operation reads the
# entry outside of its own name; references inside set operations, subqueries, MATCH_RECOGNIZE and PIVOT count

statement ok
ATTACH ':memory:' AS src9

statement ok
USE src9

statement ok
DETACH src8

statement ok
DETACH imp8

statement ok
DETACH cp8

statement ok
CREATE VIEW b AS SELECT 1 x

statement ok
CREATE VIEW a1 AS SELECT x FROM b UNION ALL (WITH b AS (SELECT 2 x) SELECT x FROM b)

statement ok
CREATE VIEW a2 AS WITH b AS (SELECT x + 1 AS x FROM b) SELECT x FROM b

statement ok
CREATE VIEW a3 AS SELECT (WITH b AS (SELECT 9 x) SELECT x FROM b) AS k, x FROM b

statement ok
CREATE VIEW a4 AS WITH RECURSIVE zc(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM zc WHERE x < 3) SELECT count(*) AS n FROM zc

statement ok
CREATE VIEW zc AS SELECT n * 2 AS n FROM a4

statement ok
CREATE VIEW z AS SELECT 1 x UNION ALL SELECT 2

statement ok
CREATE VIEW a5 AS FROM (SELECT x FROM z) MATCH_RECOGNIZE (ORDER BY x MEASURES count(*) AS c ONE ROW PER MATCH PATTERN (A+) DEFINE A AS x > 0)

statement ok
CREATE MACRO m1(x) AS x + 1

statement ok
CREATE VIEW a6 AS PIVOT z ON m1(x) IN (2, 3) USING count(*)

statement ok
CREATE OR REPLACE MACRO m1(x) AS x + 1

