CREATE SCHEMA recurring;
CREATE SCHEMA s;
CREATE TABLE "input"(x INTEGER);
CREATE MACRO zs (x) AS (sum(x));
CREATE MACRO aw (x) AS (zs(x) OVER ());
CREATE MACRO zk (x) AS ((x + 1));
CREATE MACRO ak () AS TABLE (WITH RECURSIVE t (k, v) USING KEY (k, sum(zk(v)) AS v)  AS ((SELECT 1, 1) UNION (SELECT (k + 1), v FROM t WHERE (k < 3))) SELECT * FROM t);
CREATE MACRO distance_value (x) AS (abs(x));
CREATE MACRO nearest_pair () AS TABLE (SELECT * FROM ((SELECT * FROM (VALUES (1)) AS valueslist) AS a(x) INNER JOIN (SELECT * FROM (VALUES (2)) AS valueslist) AS b(y) EXACT NEAREST 1 BY DISTANCE distance_value((a.x - b.y))));
CREATE MACRO df (x) AS ((x + 2));
CREATE MACRO dg (x) AS (x.df());
CREATE MACRO keep (x) AS ((x + 0));
CREATE VIEW zu AS SELECT 3 AS c;
CREATE MACRO au () AS (keep((SELECT c FROM zu)));
CREATE MACRO ignore_int (x INTEGER) AS (99);
CREATE MACRO rounded (x) AS (x.abs());
CREATE MACRO take_second (x, y) AS (y);
CREATE MACRO s.abs (x) AS (99);
CREATE MACRO input_rows () AS TABLE (SELECT * FROM "input");
CREATE MACRO aggregate_input ("value") AS ((WITH "input" AS (SELECT "value" AS x) SELECT sum(x) FROM input_rows()));
CREATE MACRO fallback (x) AS (0);
CREATE MACRO compatibility (x) AS (fallback(x));
CREATE MACRO s.fallback (x) AS (x);
CREATE MACRO count_rows ("value") AS (count_star());
CREATE MACRO unnest (x) AS (99);
CREATE MACRO pick ("value", enabled := true) AS (CASE  WHEN (enabled) THEN ("value") ELSE 0 END);
CREATE MACRO sum_input () AS ((SELECT sum(x) FROM "input"));
CREATE MACRO aggregate_scalar ("value") AS ((WITH "input" AS (SELECT "value" AS x) SELECT sum_input()));
CREATE MACRO read_input ("value") AS ((WITH "input" AS (SELECT "value" AS x) SELECT sum(x) FROM query('FROM input')));
CREATE VIEW z AS SELECT 1 AS x;
CREATE VIEW a1 AS WITH c AS (SELECT * FROM z), z AS (SELECT 9 AS x) SELECT * FROM c;
CREATE VIEW a2 AS WITH RECURSIVE z (x) AS ((SELECT x FROM z) UNION ALL (SELECT (x + 1) FROM z WHERE (x < 3))) SELECT * FROM z;
CREATE VIEW zr AS SELECT 1 AS x;
CREATE VIEW ab AS WITH b AS (SELECT * FROM zr) SELECT * FROM (WITH RECURSIVE b (x) AS ((SELECT x FROM b) UNION ALL (SELECT (x + 1) FROM b WHERE (x < 3))) SELECT * FROM b);
CREATE VIEW zl AS SELECT list_value(1, 2) AS xs;
CREATE VIEW al AS SELECT unnest((SELECT xs FROM zl)) AS x;
CREATE VIEW zp AS SELECT 3 AS c;
CREATE VIEW zp2 AS SELECT 4 AS c;
CREATE VIEW ap AS SELECT pick((SELECT c FROM zp)) AS c, pick(1, enabled := ((SELECT c FROM zp2) > 0)) AS d;
CREATE VIEW zq AS SELECT 5 AS x;
CREATE VIEW aq AS SELECT * FROM query_table('zq');
CREATE VIEW zq2 AS SELECT 6 AS x;
CREATE VIEW aq2 AS SELECT * FROM query_table(list_value('zq', 'zq2'));
CREATE VIEW recurring.rz AS SELECT 1 AS x;
CREATE VIEW ar AS WITH rz AS (SELECT 99 AS x) SELECT x FROM recurring.rz;
CREATE VIEW zw1 AS SELECT 2 AS n;
CREATE VIEW aw1 AS SELECT ignore_int((SELECT n FROM zw1)) AS n;
CREATE VIEW zw10 AS SELECT 2 AS n;
CREATE VIEW aw10 AS SELECT count_rows((SELECT n FROM zw10)) OVER (ORDER BY (WITH "input" AS (SELECT "value" AS x) SELECT sum_input())) AS n;
CREATE VIEW zw11 AS SELECT 2 AS n;
CREATE VIEW aw11 AS SELECT read_input((SELECT n FROM zw11)) AS n;
CREATE VIEW zw2 AS SELECT 2 AS n;
CREATE VIEW aw2 AS SELECT rounded((SELECT n FROM zw2)) AS n;
CREATE VIEW zw3 AS SELECT 2 AS n;
CREATE VIEW aw3 AS SELECT x.take_second((SELECT n FROM zw3)) AS n FROM (SELECT * FROM (VALUES (1)) AS valueslist) AS t(x);
CREATE VIEW zw4 AS SELECT 2 AS n;
CREATE VIEW aw4 AS SELECT abs((SELECT n FROM zw4)) AS n;
CREATE VIEW zw5 AS SELECT 2 AS n;
CREATE VIEW aw5 AS SELECT * FROM main.query_table('zw5');
CREATE VIEW zw6 AS SELECT 2 AS n;
CREATE VIEW aw6 AS SELECT aggregate_input((SELECT n FROM zw6)) AS n;
CREATE VIEW zw7 AS SELECT 2 AS n;
CREATE VIEW aw7 AS SELECT count_rows((SELECT n FROM zw7)) OVER (ORDER BY "value") AS n;
CREATE VIEW zw8 AS SELECT 2 AS n;
CREATE VIEW aw8 AS SELECT count_rows((SELECT n FROM zw8)) OVER (ORDER BY (WITH "input" AS (SELECT "value" AS x) SELECT sum(x) FROM input_rows())) AS n;
CREATE VIEW zw9 AS SELECT 2 AS n;
CREATE VIEW aw9 AS SELECT aggregate_scalar((SELECT n FROM zw9)) AS n;
CREATE VIEW s.zs AS SELECT 7 AS x;
CREATE VIEW s.as1 AS SELECT compatibility((SELECT x FROM s.zs)) AS x;

