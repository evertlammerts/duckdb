statement ok
CREATE TEMP MACRO tq() AS 1

statement ok
CREATE MACRO qb() AS 7

statement ok
CREATE MACRO qa() AS qb()

statement ok
CREATE OR REPLACE MACRO qb() AS tq()

statement ok
CREATE MACRO tq() AS qa()

statement ok
CREATE TABLE qt(i INTEGER DEFAULT qb())

statement ok
CREATE MACRO current_date() AS ignore_arg(vb())

statement ok
CREATE MACRO vb() AS current_date * 2

statement ok
CREATE MACRO z3(x) AS x + ignore_arg(a3())

statement ok
CREATE MACRO a3() AS (SELECT p.x.z3() FROM (VALUES (1)) p(x))

# a dropped argument against a table macro reading the caller's CTE and against query_table

statement ok
CREATE TABLE c(x INTEGER)

statement ok
CREATE MACRO mc() AS TABLE FROM c

statement ok
CREATE VIEW ca AS SELECT ignore_arg((SELECT * FROM cb)) AS x

statement ok
CREATE VIEW cb AS WITH c AS (FROM ca) FROM mc()

statement ok
CREATE VIEW qta AS SELECT ignore_arg((SELECT * FROM qtb)) AS x

statement ok
CREATE VIEW qtb AS SELECT * FROM query_table('qta')

# a wrapper that passes its argument on to a macro that drops it, against a relation named through a macro parameter

statement ok
CREATE MACRO fallback(x) AS 1

statement ok
CREATE MACRO compatibility(x) AS fallback(x)

statement ok
CREATE MACRO read_relation(table_name) AS TABLE FROM query_table(table_name)

statement ok
CREATE VIEW wa AS SELECT compatibility((SELECT x FROM wb)) AS x

statement ok
CREATE VIEW wb AS FROM read_relation('wa')

# a window call of a macro that drops its argument

statement ok
CREATE MACRO count_rows(value) AS count(*)

statement ok
CREATE VIEW xa AS SELECT count_rows((SELECT x FROM xb)) OVER () AS x

statement ok
CREATE VIEW xb AS FROM read_relation('xa')

# a qualified helper picks one macro although another schema has one of its name

statement ok
CREATE SCHEMA overrides

statement ok
CREATE MACRO fallback1(x) AS 1

statement ok
CREATE MACRO overrides.fallback1(x) AS x

statement ok
CREATE MACRO compatibility1(x) AS main.fallback1(x)

statement ok
CREATE VIEW ya AS SELECT compatibility1((SELECT x FROM yb)) AS x

statement ok
CREATE VIEW yb AS FROM read_relation('ya')

# the overload a call selects drops the argument another overload reads

statement ok
CREATE MACRO trace(value) AS 0, (value, enabled) AS CASE WHEN enabled THEN value ELSE 0 END

statement ok
CREATE VIEW va AS SELECT trace((SELECT x FROM vb)) AS x

statement ok
CREATE VIEW vb AS FROM read_relation('va')

# a named argument and an overload with a default select the overload that drops the argument

statement ok
CREATE MACRO trace2(value) AS 0, (value, enabled, label := '') AS CASE WHEN enabled THEN value ELSE 0 END

statement ok
CREATE VIEW na AS SELECT trace(value := (SELECT x FROM nb)) AS x, trace2((SELECT x FROM nb)) AS y

statement ok
CREATE VIEW nb AS SELECT x FROM read_relation('na')

# a parameter named only inside a CTE nothing reads, in a macro that calls no table function

statement ok
CREATE MACRO audit_value(value) AS (WITH detail AS (SELECT value AS sample) SELECT 0)

statement ok
CREATE VIEW ua AS SELECT audit_value((SELECT x FROM ub)) AS x

statement ok
CREATE VIEW ub AS FROM read_relation('ua')

# the same in a macro that calls a builtin table function

statement ok
CREATE MACRO audit_count(value) AS (WITH detail AS (SELECT value AS sample) SELECT count(*) * 0 FROM duckdb_tables())

statement ok
CREATE VIEW ka AS SELECT audit_count((SELECT x FROM kb)) AS x

statement ok
CREATE VIEW kb AS FROM read_relation('ka')

# a table macro of another schema named like the builtin that the macro body calls

statement ok
CREATE SCHEMA metadata

statement ok
CREATE MACRO metadata.duckdb_tables() AS TABLE SELECT * FROM duckdb_tables() WHERE NOT internal

statement ok
CREATE VIEW ma AS SELECT audit_count((SELECT x FROM mb)) AS x

statement ok
CREATE VIEW mb AS FROM read_relation('ma')

statement ok
EXPORT DATABASE '{TEST_DIR}/export_view_macro_order_10'

query I
SELECT unnest(string_split(rtrim(content, chr(10)), chr(10))) FROM read_text('{TEST_DIR}/export_view_macro_order_10/schema.sql')
----
CREATE SCHEMA metadata;
CREATE SCHEMA overrides;
CREATE SCHEMA recurring;
CREATE TABLE c(x INTEGER);
CREATE MACRO qb () AS (tq());
CREATE TABLE qt(i INTEGER DEFAULT(qb()));
CREATE MACRO ignore_arg (x) AS (1);
CREATE MACRO g () AS (ignore_arg(f()));
CREATE MACRO f () AS ((g() + 1));
CREATE MACRO h () AS (unnest(list_value(1)));
CREATE MACRO unnest (x) AS ((h() + 1));
CREATE MACRO tg () AS ((tf() + 1));
CREATE MACRO tf () AS ((tg() + 10));
CREATE MACRO da (x) AS ((WITH unused AS (SELECT db(1)) SELECT (x + 1)));
CREATE MACRO db (x) AS (x.da());
CREATE MACRO qa () AS (qb());
CREATE MACRO tq () AS (qa());
CREATE MACRO current_date () AS (ignore_arg(vb()));
CREATE MACRO vb () AS ((current_date * 2));
CREATE MACRO z3 (x) AS ((x + ignore_arg(a3())));
CREATE MACRO a3 () AS ((SELECT p.x.z3() FROM (SELECT * FROM (VALUES (1)) AS valueslist) AS p(x)));
CREATE MACRO mc () AS TABLE (SELECT * FROM c);
CREATE MACRO fallback (x) AS (1);
CREATE MACRO compatibility (x) AS (fallback(x));
CREATE MACRO read_relation (table_name) AS TABLE (SELECT * FROM query_table(table_name));
CREATE MACRO count_rows ("value") AS (count_star());
CREATE MACRO fallback1 (x) AS (1);
CREATE MACRO overrides.fallback1 (x) AS (x);
CREATE MACRO compatibility1 (x) AS (main.fallback1(x));
CREATE MACRO trace ("value") AS (0), ("value", enabled) AS (CASE  WHEN (enabled) THEN ("value") ELSE 0 END);
CREATE MACRO trace2 ("value") AS (0), ("value", enabled, "label" := '') AS (CASE  WHEN (enabled) THEN ("value") ELSE 0 END);
