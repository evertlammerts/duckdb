statement ok
RESET enable_view_dependencies

statement ok
CREATE MACRO ignore_arg(x) AS 1

statement ok
CREATE MACRO g() AS ignore_arg(f())

statement ok
CREATE MACRO f() AS g() + 1

statement ok
CREATE MACRO h() AS unnest([1])

statement ok
CREATE MACRO unnest(x) AS h() + 1

statement ok
CREATE SCHEMA recurring

statement ok
CREATE VIEW r AS WITH RECURSIVE t(x) USING KEY (x) AS (SELECT 1 UNION SELECT x + 1 FROM recurring.t WHERE x < 3) FROM t

statement ok
CREATE VIEW recurring.t AS SELECT * FROM r

statement ok
CREATE TEMP MACRO tf() AS 1

statement ok
CREATE MACRO tg() AS tf() + 1

statement ok
CREATE MACRO tf() AS tg() + 10

