# name: test/sql/function/list/lambdas/lambda_parameter_group_alias.test
# description: A bare lambda parameter binds to the parameter, not to a group of the same name
# group: [lambdas]

statement ok
CREATE TABLE t AS SELECT 99 AS s;

statement ok
CREATE TABLE tc AS SELECT 99 AS p_;

statement ok
CREATE TABLE u AS SELECT * FROM (VALUES (1), (2), (3)) u(s);

# the parameter shadows a grouped select list alias

query II
SELECT s AS p_, list_transform([1], lambda p_: p_) FROM (SELECT 99 AS s) t GROUP BY p_;
----
99	[1]

query II
SELECT s AS p_, list_transform([1, 2], lambda p_: p_ * 10) FROM u GROUP BY p_ ORDER BY p_;
----
1	[10, 20]
2	[10, 20]
3	[10, 20]

query II
SELECT s AS p_, list_transform([NULL, 1], lambda p_: p_ IS NULL) FROM (VALUES (NULL::INT)) v(s) GROUP BY p_;
----
NULL	[true, false]

query II
SELECT s AS p_, list_filter([1, 2], lambda p_: p_ = 1) FROM t GROUP BY p_;
----
99	[1]

query II
SELECT s AS p_, list_reduce([1, 2], lambda p_, y: p_ + y) FROM t GROUP BY p_;
----
99	3

query II
SELECT s AS p_, [p_ for p_ in [1]] FROM t GROUP BY p_;
----
99	[1]

query II
SELECT s + 1 AS p_, list_transform([1], lambda p_: p_) FROM t GROUP BY p_;
----
100	[1]

query II
SELECT {'f': s} AS p_, list_transform([{'f': 1}], lambda p_: p_['f']) FROM t GROUP BY p_;
----
{'f': 99}	[1]

query II
SELECT s AS p_, list_transform([1], lambda p_: p_ + count(*)) FROM t GROUP BY p_;
----
99	[2]

query II
SELECT s AS p_, list_transform([1], lambda p_: sum(s) + p_) FROM t GROUP BY p_;
----
99	[100]

# the second parameter is the index
query II
SELECT s AS p_, list_transform([10], lambda x, p_: x + p_) FROM t GROUP BY p_;
----
99	[11]

query II
SELECT s AS p_, list_transform([[1]], lambda q: list_transform(q, lambda p_: p_)) FROM t GROUP BY p_;
----
99	[[1]]

query II
SELECT s AS p_, list_transform([1], lambda p_: list_transform([5], lambda y: p_ + y)) FROM t GROUP BY p_;
----
99	[[6]]

query II
SELECT s AS p_, list_transform([1], lambda p_: p_) AS l FROM t GROUP BY GROUPING SETS ((p_), ()) ORDER BY p_ NULLS LAST;
----
99	[1]
NULL	[1]

query II
SELECT s AS p_, list_transform([1], lambda p_: p_) AS l FROM t GROUP BY ROLLUP (p_) ORDER BY p_ NULLS LAST;
----
99	[1]
NULL	[1]

query III
SELECT s AS p_, s AS q_, list_transform([1], lambda p_: p_) AS l FROM t GROUP BY CUBE (p_, q_) ORDER BY ALL;
----
99	99	[1]
99	NULL	[1]
NULL	99	[1]
NULL	NULL	[1]

query II
SELECT s AS p_, list_transform([1], lambda P_: P_) FROM t GROUP BY p_;
----
99	[1]

statement ok
CREATE MACRO lambda_in_macro(a) AS list_transform([a], lambda p_: p_);

query II
SELECT s AS p_, lambda_in_macro(1) FROM t GROUP BY p_;
----
99	[1]

# a macro argument expanded into a lambda body reads as the body's parameter of the same name, as without GROUP BY
statement ok
CREATE MACRO argument_in_lambda(a) AS list_transform([1], lambda x: a);

query II
SELECT s AS x, argument_in_lambda(x) FROM t GROUP BY x;
----
99	[1]

# a group on a select list position is keyed by the position as text
query II
SELECT s AS p_, list_transform([1], lambda "0": "0") FROM t GROUP BY p_;
----
99	[1]

# a group that names a column of the enclosing query stays a bare name, alone or inside an expression
query I
SELECT (SELECT list_transform([1], lambda k: k) FROM range(1) GROUP BY k) FROM (SELECT 99 AS k) o;
----
[1]

query I
SELECT (SELECT list_transform([1], lambda k: k + 1) FROM range(1) GROUP BY k + 1) FROM (SELECT 99 AS k) o;
----
[2]

query I
SELECT (SELECT list_transform([1], lambda k: -k) FROM range(1) GROUP BY -k) FROM (SELECT 99 AS k) o;
----
[-1]

query I
SELECT (SELECT list_transform([1], lambda k: k::VARCHAR) FROM range(1) GROUP BY k::VARCHAR) FROM (SELECT 99 AS k) o;
----
[1]

query I
SELECT (SELECT list_transform([1], lambda k: list_transform([1], lambda j: k + 1)) FROM range(1) GROUP BY k + 1) FROM (SELECT 99 AS k) o;
----
[[2]]

query I
SELECT (SELECT list_transform([1], lambda k: k) FROM range(1) GROUP BY k HAVING list_transform([1], lambda k: k) = [1]) FROM (SELECT 99 AS k) o;
----
[1]

query I
SELECT (SELECT k + 1 FROM range(1) GROUP BY 1 HAVING list_transform([1], lambda k: k + 1) = [2]) FROM (SELECT 99 AS k) o;
----
100

query I
SELECT (SELECT first(list_transform([1], lambda k: k + 1)) OVER () FROM range(1) GROUP BY k + 1) FROM (SELECT 99 AS k) o;
----
[2]

# the operand of IN belongs to the lambda body, only the subquery does not
statement error
SELECT (SELECT list_transform([1], lambda k: k IN (SELECT 1)) FROM range(1) GROUP BY k IN (SELECT 1)) FROM (SELECT 99 AS k) o;
----
subqueries in lambda expressions are not supported

# a subquery whose body may read the parameter is no group either, so the lambda refuses it as without GROUP BY

statement error
SELECT list_transform([1], lambda s: (SELECT s)) FROM t GROUP BY (SELECT s);
----
subqueries in lambda expressions are not supported

statement error
SELECT (SELECT list_transform([1], lambda k: (SELECT k)) FROM range(1) GROUP BY (SELECT k)) FROM (SELECT 99 AS k) o;
----
subqueries in lambda expressions are not supported

statement error
SELECT list_transform([1], lambda s: (SELECT 1 WHERE s > 0)) FROM t GROUP BY (SELECT 1 WHERE s > 0);
----
subqueries in lambda expressions are not supported

statement error
SELECT list_transform([1], lambda s: (SELECT (SELECT s))) FROM t GROUP BY (SELECT (SELECT s));
----
subqueries in lambda expressions are not supported

# ... also as the receiver of a dot call or the relation of a star, which the subquery has not qualified yet

statement ok
CREATE TABLE ts AS SELECT 'zz' AS s, [1, 2] AS l, {'f': 5} AS st;

statement error
SELECT list_transform(['ab'], lambda s: (SELECT s.upper())) FROM ts GROUP BY (SELECT s.upper());
----
subqueries in lambda expressions are not supported

statement error
SELECT (SELECT list_transform([{'f': 'ab'}], lambda k: (SELECT k.f.upper())) FROM range(1) GROUP BY (SELECT k.f.upper())) FROM (SELECT {'f': 'zz'} AS k) o;
----
subqueries in lambda expressions are not supported

statement error
SELECT list_transform([[5]], lambda l: (SELECT l.list_transform(lambda x: x + 1))) FROM ts GROUP BY (SELECT l.list_transform(lambda x: x + 1));
----
subqueries in lambda expressions are not supported

statement error
SELECT list_transform([{'f': 1}], lambda st: (SELECT st.*)) FROM ts GROUP BY (SELECT st.*);
----
subqueries in lambda expressions are not supported

# the other clauses of a grouped query

query I
SELECT s AS p_ FROM t GROUP BY p_ HAVING list_transform([1], lambda p_: p_) = [1];
----
99

query II
SELECT s AS p_, row_number() OVER () AS rn FROM t GROUP BY p_ QUALIFY list_transform([1], lambda p_: p_) = [1];
----
99	1

query I
SELECT s AS p_ FROM u GROUP BY p_ ORDER BY list_transform([10 - s], lambda p_: p_);
----
3
2
1

query II
SELECT s AS p_, first(list_transform([1], lambda p_: p_)) OVER () FROM t GROUP BY p_;
----
99	[1]

query II
SELECT s AS p_, count(*) OVER (PARTITION BY list_transform([1], lambda p_: p_)) AS c FROM u GROUP BY p_ ORDER BY p_;
----
1	3
2	3
3	3

query II
SELECT s AS p_, sum(s) OVER (ORDER BY s ROWS BETWEEN list_transform([0], lambda p_: p_)[1] PRECEDING AND CURRENT ROW) AS w FROM u GROUP BY p_ ORDER BY p_;
----
1	1
2	2
3	3

query I
SELECT DISTINCT ON (list_transform([1], lambda p_: p_)) s AS p_ FROM u GROUP BY p_ ORDER BY ALL;
----
1

# GROUPING of a parameter names no group, whether the group is an alias or a column

statement error
SELECT s AS p_, list_transform([1], lambda p_: grouping(p_)) FROM t GROUP BY p_;
----
GROUPING child "p_" must be a grouping column

statement error
SELECT p_, list_transform([1], lambda p_: grouping(p_)) FROM tc GROUP BY p_;
----
GROUPING child "p_" must be a grouping column

statement error
SELECT list_transform([1], lambda p_: grouping(p_ + 1)) FROM tc GROUP BY p_ + 1;
----
GROUPING child "(p_ + 1)" must be a grouping column

statement error
SELECT s AS p_ FROM t GROUP BY p_ HAVING list_transform([1], lambda p_: grouping(p_)) = [0];
----
GROUPING child "p_" must be a grouping column

statement error
SELECT (SELECT list_transform([1], lambda k: grouping(k)) FROM range(1) GROUP BY k) FROM (SELECT 99 AS k) o;
----
GROUPING child "k" must be a grouping column

# a GROUPING inside a subquery does not reach the enclosing query's group through a parameter

statement error
SELECT p_, (SELECT list_transform([1], lambda p_: grouping(p_))) FROM tc GROUP BY p_;
----
GROUPING statement cannot be used without groups

statement error
SELECT s AS p_, (SELECT list_transform([1], lambda p_: grouping(p_))) FROM t GROUP BY p_;
----
GROUPING statement cannot be used without groups

statement error
SELECT p_ + 1, (SELECT list_transform([1], lambda p_: grouping(p_ + 1))) FROM tc GROUP BY p_ + 1;
----
GROUPING statement cannot be used without groups

statement error
SELECT p_, (SELECT list_transform([1], lambda p_: grouping(p_)) FROM range(1) GROUP BY range) FROM tc GROUP BY p_;
----
GROUPING child "p_" must be a grouping column

# a field access on a parameter is the parameter's field, not a group of the same text

query I
SELECT (SELECT list_transform([{'f': 1}], lambda k: k.f) FROM range(1) GROUP BY k.f) FROM (SELECT {'f': 99} AS k) o;
----
[1]

query I
SELECT (SELECT list_transform([{'f': 1}], lambda k: k.f + 1) FROM range(1) GROUP BY k.f + 1) FROM (SELECT {'f': 99} AS k) o;
----
[2]

query I
SELECT (SELECT list_transform([{'f': {'g': 1}}], lambda k: k.f.g) FROM range(1) GROUP BY k.f.g) FROM (SELECT {'f': {'g': 99}} AS k) o;
----
[1]

query I
SELECT (SELECT list_transform([{'f': 'ab'}], lambda k: k.f.upper()) FROM range(1) GROUP BY upper(k.f)) FROM (SELECT {'f': 'zz'} AS k) o;
----
[AB]

query I
SELECT (SELECT 1 FROM range(1) GROUP BY k.f HAVING list_transform([{'f': 1}], lambda k: k.f) = [1]) FROM (SELECT {'f': 99} AS k) o;
----
1

statement error
SELECT list_transform([{'f': 1}], lambda k: grouping(k.f)) FROM (SELECT {'f': 99} AS k) t GROUP BY k.f;
----
GROUPING child "f" must be a grouping column

statement error
SELECT (SELECT list_transform([{'f': 1}], lambda k: grouping(k.f))) FROM (SELECT {'f': 99} AS k) o GROUP BY k.f;
----
GROUPING statement cannot be used without groups

# a table named like the parameter that has the column provides the reference, as without GROUP BY

query I
SELECT list_transform([{'f': 1}], lambda k: k.f) FROM (SELECT 99 AS f) k GROUP BY k.f;
----
[99]

# a name with no group, or a name that is not a parameter, keeps its binding

statement error
SELECT list_transform([{'x': 1}], lambda p_: grouping(p_.x)) FROM t GROUP BY s;
----
GROUPING child "x" must be a grouping column

statement error
SELECT s, list_transform([1], lambda x: grouping(s + x)) FROM t GROUP BY s;
----
must be a grouping column

query I
SELECT (SELECT list_transform([1], lambda k: k + 1) FROM range(1)) FROM (SELECT 99 AS k) o GROUP BY k + 1;
----
[2]

query II
SELECT s AS p_, list_transform([1], lambda p_: p_) FROM t;
----
99	[1]

query II
SELECT s AS x, argument_in_lambda(x) FROM t;
----
99	[1]

query II
SELECT s AS p_, list_transform([1], lambda p_: p_) FROM t GROUP BY ALL;
----
99	[1]

query I
SELECT s AS p_ FROM t GROUP BY ALL HAVING list_transform([1], lambda p_: p_) = [1];
----
99

query II
SELECT p_, list_transform([1], lambda p_: p_) FROM tc GROUP BY p_;
----
99	[1]

query II
SELECT s AS p_, p_ + 1 FROM t GROUP BY p_;
----
99	100

query II
SELECT s AS p_, list_transform([1], lambda x: x + p_) FROM t GROUP BY p_;
----
99	[100]

query I
SELECT s AS p_ FROM t GROUP BY p_ HAVING list_transform([1], lambda x: x + p_) = [100];
----
99

query II
SELECT s AS p_, list_transform([1], lambda x: grouping(p_)) FROM t GROUP BY p_;
----
99	[0]

query II
SELECT p_, (SELECT list_transform([1], lambda x: grouping(p_))) FROM tc GROUP BY p_;
----
99	[0]

query I
SELECT (SELECT list_transform([1], lambda x: k + 1) FROM range(1) GROUP BY k + 1) FROM (SELECT 99 AS k) o;
----
[100]

# a lambda declared inside the group expression binds its own parameter, so the expression is still the group
query II
SELECT list_transform([s], lambda x: x + 1) AS l, count(*) FROM t GROUP BY list_transform([s], lambda x: x + 1);
----
[100]	1

# ... also inside a lambda body that declares the same name
query I
SELECT list_transform([1], lambda x: list_transform([s], lambda x: x + 1)) FROM t GROUP BY list_transform([s], lambda x: x + 1);
----
[[100]]

query I
SELECT list_transform([1], lambda y: s + 1) FROM t GROUP BY s + 1;
----
[100]

query I
SELECT list_transform([1], lambda y: y + (s + 1)) FROM t GROUP BY s + 1;
----
[101]

query I
SELECT list_transform([1], lambda x: s IN (SELECT 99)) FROM t GROUP BY s IN (SELECT 99);
----
[true]

query I
SELECT list_transform([1], lambda x: (SELECT s)) FROM t GROUP BY (SELECT s);
----
[99]

query I
SELECT list_transform([1], lambda s: (SELECT list_transform([1], lambda s: s))) FROM t GROUP BY (SELECT list_transform([1], lambda s: s));
----
[[1]]

query I
SELECT list_transform(['ab'], lambda x: (SELECT s.upper())) FROM ts GROUP BY (SELECT s.upper());
----
[ZZ]

query I
SELECT list_transform([{'f': 1}], lambda x: (SELECT st.*)) FROM ts GROUP BY (SELECT st.*);
----
[5]

query I
SELECT list_transform(['ab'], lambda s: (SELECT list_transform(['q'], lambda s: s.upper()))) FROM ts GROUP BY (SELECT list_transform(['q'], lambda s: s.upper()));
----
[[Q]]

# a schema named like the parameter qualifies a call that is no dot call, and a table named like it provides a star
statement ok
CREATE SCHEMA sc;

statement ok
CREATE MACRO sc.f(x) AS x + 1;

query I
SELECT list_transform([1], lambda sc: sc.f(c)) FROM (SELECT 3 AS c) q GROUP BY sc.f(c);
----
[4]

query I
SELECT list_transform([1], lambda sc: (SELECT sc.f(c))) FROM (SELECT 3 AS c) q GROUP BY (SELECT sc.f(c));
----
[4]

query I
SELECT list_transform([1], lambda t: (SELECT t.*)) FROM t GROUP BY (SELECT t.*);
----
[99]

statement ok
CREATE MACRO apply_each(l, f) AS list_transform(l, f);

query I
SELECT list_transform([1], lambda x: apply_each([s], lambda x: x + 1)) FROM t GROUP BY apply_each([s], lambda x: x + 1);
----
[[100]]

query II
SELECT s AS p_, max(list_transform([1], lambda p_: p_)) FROM t GROUP BY p_;
----
99	[1]

query I
SELECT s AS p_ FROM t WHERE list_transform([1], lambda p_: p_) = [1];
----
99
