# name: test/sql/function/list/lambdas/lambda_parameter_group_json.test
# description: An arrow that is not a lambda argument of a function is the JSON operator and declares no parameter
# group: [lambdas]

require json

query I
SELECT (SELECT list_transform(['{"f":1}'::JSON], lambda k: k -> 'f') FROM range(1) GROUP BY k -> 'f') FROM (SELECT '{"f":99}'::JSON AS k) o;
----
[1]

statement error
SELECT list_transform(['{"f":1}'::JSON], lambda k: grouping(k -> 'f')) FROM (SELECT '{"f":99}'::JSON AS k) t GROUP BY k -> 'f';
----
must be a grouping column

# the arrow over a grouped column that is not a parameter is still the group

query II
SELECT k -> 'f' AS g, list_transform([1], lambda x: k -> 'f') FROM (SELECT '{"f":99}'::JSON AS k) t GROUP BY k -> 'f';
----
99	[99]

# a parameter on the left of the arrow keeps the expression out of an enclosing query's group
statement error
SELECT (SELECT list_transform(['{"f":1}'::JSON], lambda k: CAST(k -> 'f' AS INTEGER) + v)) FROM (VALUES ('{"f":99}'::JSON, 2)) o(k, v) GROUP BY CAST(k -> 'f' AS INTEGER) + v;
----
column "v" must appear in the GROUP BY clause

# a column on the left of the arrow decides which scope owns an aggregate
query I
SELECT (SELECT sum(CAST(k -> 'f' AS INTEGER)) FROM range(1)) FROM (VALUES ('{"f":99}'::JSON), ('{"f":1}'::JSON)) o(k);
----
100

query I
SELECT (SELECT max(k -> 'f') FROM range(1)) FROM (VALUES ('{"f":99}'::JSON), ('{"f":1}'::JSON)) o(k);
----
99

query I
SELECT (SELECT sum(CAST(json_extract(k, '$.f') AS INTEGER)) FROM range(1)) FROM (VALUES ('{"f":99}'::JSON), ('{"f":1}'::JSON)) o(k);
----
100

# an arrow argument of a function that takes no lambda there is the JSON operator, so a parameter on its left keeps
# the expression out of a group of the same text over an outer column

query I
SELECT (SELECT list_transform(['{"f":"a"}'::JSON], lambda k: concat(k -> 'f', '')) FROM range(1) GROUP BY concat(k -> 'f', '')) FROM (SELECT '{"f":"bbbb"}'::JSON AS k) o;
----
['"a"']

query I
SELECT (SELECT list_transform(['{"f":"a"}'::JSON], lambda k: concat(k ->> 'f', '')) FROM range(1) GROUP BY concat(k ->> 'f', '')) FROM (SELECT '{"f":"bbbb"}'::JSON AS k) o;
----
[a]

query I
SELECT (SELECT list_transform(['{"f":"a"}'::JSON], lambda k: lower(k -> 'f')) FROM range(1) GROUP BY lower(k -> 'f')) FROM (SELECT '{"f":"bbbb"}'::JSON AS k) o;
----
['"a"']

query I
SELECT (SELECT list_transform(['{"f":"a"}'::JSON], lambda k: concat(k -> 'f', '')) FROM range(1) GROUP BY concat(k -> 'f', '')) FROM (SELECT '{"f":"bbbb"}'::JSON AS k UNION ALL SELECT NULL::JSON) o;
----
['"a"']
['"a"']

query I
SELECT (SELECT 1 FROM range(1) GROUP BY concat(k -> 'f', '') HAVING list_transform(['{"f":"a"}'::JSON], lambda k: concat(k -> 'f', '')) = ['"a"']) FROM (SELECT '{"f":"bbbb"}'::JSON AS k) o;
----
1

query I
SELECT (SELECT list_transform(['{"f":"a"}'::JSON], lambda k: list_transform([1], lambda x: concat(k -> 'f', ''))) FROM range(1) GROUP BY concat(k -> 'f', '')) FROM (SELECT '{"f":"bbbb"}'::JSON AS k) o;
----
[['"a"']]

statement error
SELECT list_transform(['{"f":"a"}'::JSON], lambda k: grouping(lower(k -> 'f'))) FROM (SELECT '{"f":"bbbb"}'::JSON AS k) t GROUP BY lower(k -> 'f');
----
must be a grouping column

# the same arrow over the outer column outside the lambda's parameters is still the group

query I
SELECT (SELECT list_transform([1], lambda x: concat(k -> 'f', '')) FROM range(1) GROUP BY concat(k -> 'f', '')) FROM (SELECT '{"f":"bbbb"}'::JSON AS k) o;
----
['"bbbb"']

# an arrow passed to a macro may be the JSON operator once the macro expands, so its left side may be the parameter

statement ok
CREATE MACRO passthrough(a) AS a;

query I
SELECT list_transform(['{"f":1}'::JSON], lambda k: passthrough(k -> 'f')) FROM (VALUES ('{"f":99}'::JSON)) t(k) GROUP BY passthrough(k -> 'f');
----
[1]

query I
SELECT (SELECT list_transform(['{"f":1}'::JSON], lambda k: passthrough(k -> 'f')) FROM range(1) GROUP BY passthrough(k -> 'f')) FROM (VALUES ('{"f":99}'::JSON)) o(k);
----
[1]
