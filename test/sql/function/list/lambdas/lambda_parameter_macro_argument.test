CREATE MACRO qualified_read(a, b) AS list_transform([1], lambda x: b + first((SELECT list_transform([-1], lambda x: x.abs() + a.v)[1] FROM (VALUES (-7)) AS t(x), (VALUES (1)) AS a(v))));

query I
SELECT list_transform([1], lambda x: 3 + first((SELECT list_transform([-1], lambda x: x.abs() + a.v)[1] FROM (VALUES (-7)) AS t(x), (VALUES (1)) AS a(v))));
----
[11]

query I
SELECT qualified_read(0, x.z) FROM (VALUES (3)) AS x(z) GROUP BY x.z;
----
[11]

query I
SELECT qualified_read(x.z, x.z) FROM (VALUES (3)) AS x(z) GROUP BY x.z;
----
[11]

statement ok
CREATE MACRO qread4(a, b) AS list_transform([1], lambda x: concat(a, ':', first((SELECT list_transform([-3], lambda x: x.abs() + b)[1] FROM (SELECT -20 AS x) AS s))));

query I
SELECT list_transform([1], lambda x: concat('!', ':', first((SELECT list_transform([-3], lambda x: x.abs() + 100)[1] FROM (SELECT -20 AS x) AS s))));
----
['!:120']

query I
SELECT qread4(x.z, 100) FROM (VALUES ('!')) AS x(z) GROUP BY x.z;
----
['!:120']

# a PIVOT source is walked with its own tables

statement ok
CREATE MACRO pivot_scope(a, b) AS list_transform([1], lambda x: a + first((SELECT k FROM (PIVOT (SELECT list_transform([{'d': 2}], lambda x: x.d + b)[1] AS v, 'k' AS category FROM (VALUES (60)) AS x(d)) ON category IN ('k') USING sum(v)) AS p)));

query I
SELECT list_transform([1], lambda x: 3 + first((SELECT k FROM (PIVOT (SELECT list_transform([{'d': 2}], lambda x: x.d + 3)[1] AS v, 'k' AS category FROM (VALUES (60)) AS x(d)) ON category IN ('k') USING sum(v)) AS p)));
----
[66]

query I
SELECT pivot_scope(x.z, 3) FROM (VALUES (3)) AS x(z) GROUP BY x.z;
----
[66]

# in a folded subquery each reference is decided at its own level: a table only a nested level or a CTE body reads
# does not count, a VALUES list binds in the level around it, and a select list alias of the level keeps its name

statement ok
CREATE MACRO t_inner(a) AS list_transform([1], lambda x: typeof((SELECT x + (SELECT count(*) FROM range(3)))) || a);

query I
SELECT list_transform([1], lambda x: typeof((SELECT x + (SELECT count(*) FROM range(3)))) || '!');
----
[BIGINT!]

query I
SELECT t_inner(x.z) FROM (VALUES ('!')) AS x(z);
----
[BIGINT!]

statement ok
CREATE MACRO t_where(a) AS list_transform([1], lambda x: typeof((SELECT x WHERE 1 IN (SELECT 1 FROM range(1)))) || a);

query I
SELECT list_transform([1], lambda x: typeof((SELECT x WHERE 1 IN (SELECT 1 FROM range(1)))) || '!');
----
[INTEGER!]

query I
SELECT t_where(x.z) FROM (VALUES ('!')) AS x(z);
----
[INTEGER!]

statement ok
CREATE MACRO tcte2(a) AS list_transform([1], lambda x: typeof((WITH c AS (SELECT k FROM range(1) AS t(k)) SELECT x)) || a);

query I
SELECT list_transform([1], lambda x: typeof((WITH c AS (SELECT k FROM range(1) AS t(k)) SELECT x)) || '!');
----
[INTEGER!]

query I
SELECT tcte2(x.z) FROM (VALUES ('!')) AS x(z);
----
[INTEGER!]

statement ok
CREATE MACRO tval(a) AS list_transform([1], lambda x: typeof((VALUES (x))) || a);

query I
SELECT list_transform([1], lambda x: typeof((VALUES (x))) || '!');
----
[INTEGER!]

query I
SELECT tval(x.z) FROM (VALUES ('!')) AS x(z);
----
[INTEGER!]

statement ok
CREATE MACRO alias_type(a) AS list_transform([1], lambda x: typeof((SELECT 's' AS x WHERE length(x) > 0)) || a);

query I
SELECT list_transform([1], lambda x: typeof((SELECT 's' AS x WHERE length(x) > 0)) || '!');
----
[VARCHAR!]

query I
SELECT alias_type(x.z) FROM (VALUES ('!')) AS x(z);
----
[VARCHAR!]
