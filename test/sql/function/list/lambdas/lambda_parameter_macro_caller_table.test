# a table only at an inner level leaves the outer level's read to the parameter

statement ok
CREATE MACRO exists_fold() AS list_transform([{'d': 'a'}], lambda x: typeof((SELECT x.d WHERE EXISTS (SELECT 1 FROM range(1)))));

query I
SELECT exists_fold() FROM x;
----
[VARCHAR]

query I
SELECT list_transform([{'d': 'a'}], lambda x: typeof((SELECT x.d WHERE EXISTS (SELECT 1 FROM range(1))))) FROM x AS q;
----
[VARCHAR]

# the IN, ANY or ALL operand of a folded subquery is read in the lambda's scope too

statement ok
CREATE MACRO membership_type() AS list_transform([{'d': 'a'}], lambda x: typeof((SELECT upper(x.d) IN (SELECT 'A'))));

query I
SELECT membership_type() FROM x;
----
[BOOLEAN]

query I
SELECT list_transform([{'d': 'a'}], lambda x: typeof((SELECT upper(x.d) IN (SELECT 'A')))) FROM x AS q;
----
[BOOLEAN]

statement ok
CREATE MACRO any_type() AS list_transform([{'d': 'a'}], lambda x: typeof((SELECT upper(x.d) = ANY (SELECT 'A'))));

query I
SELECT any_type() FROM x;
----
[BOOLEAN]

query I
SELECT list_transform([{'d': 'a'}], lambda x: typeof((SELECT upper(x.d) = ANY (SELECT 'A')))) FROM x AS q;
----
[BOOLEAN]

# a lambda inside a folded subquery that declares the name shadows the outer parameter there

statement ok
CREATE MACRO shadow_guard() AS list_transform([{'d': 1}], lambda x: typeof((SELECT list_transform([{'d': 1}], lambda x: x.d))) || ':' || typeof((SELECT x FROM range(1))));

query I
SELECT shadow_guard() FROM x;
----
['INTEGER[]:STRUCT(d INTEGER)']

query I
SELECT list_transform([{'d': 1}], lambda x: typeof((SELECT list_transform([{'d': 1}], lambda x: x.d))) || ':' || typeof((SELECT x FROM range(1)))) FROM x AS q;
----
['INTEGER[]:STRUCT(d INTEGER)']

