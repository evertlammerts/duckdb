# name: test/sql/function/list/lambdas/lambda_parameter_macro_caller_table.test
# description: A dotted reference to a lambda parameter of a macro body is not captured by a table of the caller named like the parameter
# group: [lambdas]

statement ok
CREATE TABLE x AS SELECT 50 AS d, 7 AS z;

statement ok
CREATE MACRO fp(a) AS list_transform([{'d': 1}], lambda x: x.d + a);

statement ok
CREATE MACRO fd() AS list_transform([{'d': 1}], lambda x: x.d);

query I
SELECT fp(7) FROM x;
----
[8]

query I
SELECT fd() FROM x;
----
[1]

query I
SELECT fd() FROM x AS X;
----
[1]

query I
SELECT fd() FROM (SELECT 1 AS e) q, x;
----
[1]

query I
SELECT fd() FROM range(1) x(d);
----
[1]

# written next to the table, the table wins over the parameter: the query's own tables come first

query I
SELECT list_transform([{'d': 1}], lambda x: x.d + 7) FROM x;
----
[57]

# no capture without a table named like the parameter, or without the column

query I
SELECT fp(7) FROM x AS q;
----
[8]

query I
SELECT fp(7) FROM (SELECT 50 AS e) x;
----
[8]

query I
SELECT fp(7) FROM (SELECT {'d': 50} AS x) t;
----
[8]

# the caller's table in an argument keeps its meaning

query I
SELECT fp(x.d) FROM x;
----
[51]

query I
SELECT fp(z) FROM x;
----
[8]

query II
SELECT d, fp(d) FROM x;
----
50	[51]

query I
SELECT fd() FROM x WHERE fp(z) = [8];
----
[1]

query II
SELECT z, fp(z) FROM x GROUP BY z;
----
7	[8]

query I
SELECT fd() FROM x ORDER BY fp(z);
----
[1]

query I
SELECT fp(z) FROM x GROUP BY fp(z);
----
[8]

# NULL elements

statement ok
CREATE MACRO fn() AS list_transform([NULL, {'d': 1}], lambda x: x.d);

query I
SELECT fn() FROM x;
----
[NULL, 1]

# nested lambdas in the body, a shadowing inner parameter, and a reference from the inner lambda to the outer one

statement ok
CREATE MACRO nested() AS list_transform([{'d': 1}], lambda x: list_transform([{'d': 2}], lambda y: y.d * 10 + x.d));

query I
SELECT nested() FROM x;
----
[[21]]

statement ok
CREATE MACRO shadowed() AS list_transform([{'d': 1}], lambda x: list_transform([{'d': 2}], lambda x: x.d));

query I
SELECT shadowed() FROM x;
----
[[2]]

statement ok
CREATE MACRO inner_only() AS list_transform([[{'d': 3}]], lambda q: list_transform(q, lambda x: x.d));

query I
SELECT inner_only() FROM x;
----
[[3]]

# list_reduce with two parameters and the comprehension syntax

statement ok
CREATE MACRO reduced() AS list_reduce([{'d': 1}, {'d': 2}], lambda x, y: {'d': x.d + y.d}).d;

query I
SELECT reduced() FROM x;
----
3

statement ok
CREATE MACRO comprehension() AS [x.d FOR x IN [{'d': 1}]];

query I
SELECT comprehension() FROM x;
----
[1]

# a field of a field, and a table qualified by its schema

statement ok
CREATE TABLE p AS SELECT {'e': 50} AS d;

statement ok
CREATE MACRO deep() AS list_transform([{'d': {'e': 1}}], lambda p: p.d.e);

query I
SELECT deep() FROM p;
----
[1]

statement ok
CREATE SCHEMA s;

statement ok
CREATE TABLE s.d AS SELECT 50 AS e;

statement ok
CREATE MACRO schema_named() AS list_transform([{'d': {'e': 1}}], lambda s: s.d.e);

query I
SELECT schema_named() FROM s.d;
----
[1]

query I
SELECT list_transform([{'d': {'e': 1}}], lambda s: s.d.e) FROM s.d;
----
[50]

# a dot call on a field of the parameter

statement ok
CREATE TABLE xs AS SELECT 'zz' AS d;

statement ok
CREATE MACRO dot_call() AS list_transform([{'d': 'ab'}], lambda xs: xs.d.upper());

query I
SELECT dot_call() FROM xs;
----
[AB]

# a USING column named like the parameter

query I
SELECT fd() FROM (SELECT {'d': 40} AS x) a JOIN (SELECT {'d': 40} AS x) b USING (x);
----
[1]

# an ambiguous caller table named like the parameter

statement ok
CREATE SCHEMA s1;

statement ok
CREATE SCHEMA s2;

statement ok
CREATE TABLE s1.x AS SELECT 50 AS d;

statement ok
CREATE TABLE s2.x AS SELECT 60 AS d;

query I
SELECT fd() FROM s1.x, s2.x;
----
[1]

statement error
SELECT list_transform([{'d': 1}], lambda x: x.d) FROM s1.x, s2.x;
----
Ambiguous reference to table

# the macro called inside a lambda of the caller, in a subquery, and from another macro

query I
SELECT list_transform([1], lambda q: fp(q)) FROM x;
----
[[2]]

# a guard: a subquery's own scope has no table x
query I
SELECT (SELECT fd()) FROM x;
----
[1]

query I
SELECT (SELECT fd() FROM x) FROM (SELECT 1);
----
[1]

statement ok
CREATE MACRO outer_macro(a) AS fp(a) || fd();

query I
SELECT outer_macro(7) FROM x;
----
[8, 1]

# the window form of a macro

statement ok
CREATE MACRO wm(a) AS sum(a) + list_sum(list_transform([{'d': 1}], lambda x: x.d));

query I
SELECT wm(z) OVER () FROM x;
----
8

# a table of the body's own subquery wins, as for any query

statement ok
CREATE MACRO body_table() AS (SELECT list_transform([{'d': 1}], lambda x: x.d) FROM (SELECT 60 AS d) x);

query I
SELECT body_table() FROM x;
----
[60]

statement ok
CREATE MACRO body_subquery() AS (SELECT list_transform([{'d': 1}], lambda x: x.d));

query I
SELECT body_subquery() FROM x;
----
[1]

# a table macro body binds in its own scope

statement ok
CREATE MACRO tm() AS TABLE SELECT list_transform([{'d': 1}], lambda x: x.d) AS r;

query III
SELECT * FROM x, tm();
----
50	7	[1]

# a table of a body subquery is not in scope for a lambda beside it, so the caller's table still does not capture

statement ok
CREATE MACRO mix(a) AS list_concat(list_transform([{'d': 1}], lambda x: x.d + a), (SELECT list_transform([{'d': 2}], lambda x: x.d + a) FROM (VALUES (60)) AS x(d)));

query I
SELECT mix(7) FROM x;
----
[8, 67]

statement ok
CREATE MACRO top2() AS list_transform([{'d': 1}], lambda x: x.d) || (SELECT [count(*)] FROM (SELECT 1) x);

query I
SELECT top2() FROM x;
----
[1, 1]

statement ok
CREATE MACRO beside() AS list_transform([{'d': 1}], lambda x: x.d) || (SELECT [2] FROM (SELECT 0 AS k) x);

query I
SELECT beside() FROM x;
----
[1, 2]

statement ok
CREATE MACRO nested_beside() AS list_transform([{'d': 1}], lambda x: list_transform([{'d': 2}], lambda x: x.d)) || (SELECT [[3]] FROM (SELECT 1) x);

query I
SELECT nested_beside() FROM x;
----
[[2], [3]]

# an argument that names the caller's table x is captured first; at the top of the body no body table is in scope, so x.d reads the parameter

statement ok
CREATE MACRO arg_first(a) AS list_transform([{'d': 1}], lambda x: a + x.d) || (SELECT [0] FROM (SELECT 1) x);

query I
SELECT arg_first(x.z) FROM x AS x;
----
[8, 0]

# a subquery in an aggregate argument inside the lambda binds, and its own table x wins over the renamed parameter

statement ok
CREATE MACRO agg_sub() AS list_transform([{'d': 1}], lambda x: x.d + first((SELECT list_transform([{'d': 2}], lambda x: x.d)[1] FROM (SELECT 60 AS d) x)));

query I
SELECT agg_sub() FROM x;
----
[61]

query I
SELECT agg_sub() FROM x AS q;
----
[61]

statement ok
CREATE MACRO agg_sub_ref() AS list_transform([{'d': 1}], lambda x: x.d + first((SELECT x.d FROM (SELECT 60 AS d) x)));

query I
SELECT agg_sub_ref() FROM x;
----
[61]

statement ok
CREATE MACRO agg_sub_sum() AS list_transform([{'d': 1}], lambda x: x.d + sum((SELECT x.d FROM (SELECT 40 AS d) x)));

query I
SELECT agg_sub_sum() FROM x;
----
[41]

statement ok
CREATE MACRO agg_sub_arg(a) AS list_transform([{'d': 1}], lambda x: first(a) + x.d + first((SELECT list_transform([{'d': 2}], lambda x: x.d)[1] FROM (SELECT 60 AS d) x)));

query I
SELECT agg_sub_arg(x.d) FROM x;
----
[111]

# a subquery that typeof folds binds in the lambda's scope, so its references take the parameter's new name

statement ok
CREATE MACRO whole_type() AS list_transform([{'d': 1}], lambda x: typeof(x.d) || ':' || typeof((SELECT x)));

query I
SELECT whole_type() FROM x;
----
['INTEGER:STRUCT(d INTEGER)']

query I
SELECT list_transform([{'d': 1}], lambda x: typeof(x.d) || ':' || typeof((SELECT x))) FROM x AS q;
----
['INTEGER:STRUCT(d INTEGER)']

statement ok
CREATE MACRO field_type() AS list_transform([{'d': 'a'}], lambda x: x.d || typeof((SELECT x.d)));

query I
SELECT field_type() FROM x;
----
[aVARCHAR]

query I
SELECT list_transform([{'d': 'a'}], lambda x: x.d || typeof((SELECT x.d))) FROM x AS q;
----
[aVARCHAR]

statement ok
CREATE MACRO inner_type() AS list_transform([{'d': 1}], lambda x: concat(x.d, ':', first((SELECT list_transform([{'e': 2}], lambda x: typeof((SELECT x.e FROM (SELECT 60 AS d) x)))[1]))));

query I
SELECT inner_type() FROM (SELECT 50 AS d, 'v' AS e) x;
----
['1:INTEGER']

query I
SELECT list_transform([{'d': 1}], lambda x: concat(x.d, ':', first((SELECT list_transform([{'e': 2}], lambda x: typeof((SELECT x.e FROM (SELECT 60 AS d) x)))[1])))) FROM (SELECT 50 AS d, 'v' AS e) q;
----
['1:INTEGER']

# a subquery anywhere in the argument of typeof binds in the lambda's scope when it has no table of its own

statement ok
CREATE MACRO wrapped_type() AS list_transform([{'d': 1, 'z': 2}], lambda x: typeof(x.d) || ':' || typeof((SELECT x).z));

query I
SELECT wrapped_type() FROM x;
----
['INTEGER:INTEGER']

query I
SELECT list_transform([{'d': 1, 'z': 2}], lambda x: typeof(x.d) || ':' || typeof((SELECT x).z)) FROM x AS q;
----
['INTEGER:INTEGER']

statement ok
CREATE MACRO nested_type() AS list_transform([{'d': 1}], lambda x: typeof(x.d) || ':' || typeof([(SELECT x)]));

query I
SELECT nested_type() FROM x;
----
['INTEGER:STRUCT(d INTEGER)[]']

query I
SELECT list_transform([{'d': 1}], lambda x: typeof(x.d) || ':' || typeof([(SELECT x)])) FROM x AS q;
----
['INTEGER:STRUCT(d INTEGER)[]']

statement ok
CREATE MACRO coalesced_type() AS list_transform([{'d': 1}], lambda x: typeof(x.d) || ':' || typeof(coalesce((SELECT x), x)));

query I
SELECT coalesced_type() FROM x;
----
['INTEGER:STRUCT(d INTEGER)']

query I
SELECT list_transform([{'d': 1}], lambda x: typeof(x.d) || ':' || typeof(coalesce((SELECT x), x))) FROM x AS q;
----
['INTEGER:STRUCT(d INTEGER)']

# a subquery with a table of its own reads its own column x, and other functions do not fold their subquery

statement ok
CREATE MACRO local_column_type() AS list_transform([{'d': 1}], lambda x: typeof(x.d) || ':' || typeof((SELECT x FROM (SELECT 'inner' AS x) t)));

query I
SELECT local_column_type() FROM x;
----
['INTEGER:VARCHAR']

query I
SELECT list_transform([{'d': 1}], lambda x: typeof(x.d) || ':' || typeof((SELECT x FROM (SELECT 'inner' AS x) t))) FROM x AS q;
----
['INTEGER:VARCHAR']

statement ok
CREATE MACRO cast_sub() AS list_transform([{'d': 1}], lambda x: x.d + first(cast_to_type((SELECT x FROM (VALUES (7)) AS t(x)), 0)));

query I
SELECT cast_sub() FROM x;
----
[8]

query I
SELECT list_transform([{'d': 1}], lambda x: x.d + first(cast_to_type((SELECT x FROM (VALUES (7)) AS t(x)), 0))) FROM x AS q;
----
[8]

statement ok
CREATE MACRO map_sub() AS list_transform([{'d': 1}], lambda x: x.d + first(map_contains((SELECT MAP {'k': x} FROM (VALUES (1)) AS t(x)), 'k')::INTEGER));

query I
SELECT map_sub() FROM x;
----
[2]

query I
SELECT list_transform([{'d': 1}], lambda x: x.d + first(map_contains((SELECT MAP {'k': x} FROM (VALUES (1)) AS t(x)), 'k')::INTEGER)) FROM x AS q;
----
[2]

# the caller scope is asked about a dotted read inside a folded subquery too

statement ok
CREATE MACRO folded_read() AS list_transform([{'d': 'a'}], lambda x: typeof((SELECT x.d)));

query I
SELECT folded_read() FROM x;
----
[VARCHAR]

query I
SELECT list_transform([{'d': 'a'}], lambda x: typeof((SELECT x.d))) FROM x AS q;
----
[VARCHAR]

statement ok
CREATE MACRO folded_beside() AS list_transform([{'d': 'a'}], lambda x: typeof(x) || typeof((SELECT x.d)));

query I
SELECT folded_beside() FROM x;
----
['STRUCT(d VARCHAR)VARCHAR']

query I
SELECT list_transform([{'d': 'a'}], lambda x: typeof(x) || typeof((SELECT x.d))) FROM x AS q;
----
['STRUCT(d VARCHAR)VARCHAR']

# a dot call on the parameter inside a folded subquery is asked about, as at the top of the lambda

statement ok
CREATE MACRO dot_fold() AS list_transform([{'d': 1::BIGINT}], lambda x: typeof((SELECT x.d.abs())));

query I
SELECT dot_fold() FROM x;
----
[BIGINT]

query I
SELECT list_transform([{'d': 1::BIGINT}], lambda x: typeof((SELECT x.d.abs()))) FROM x AS q;
----
[BIGINT]

statement ok
CREATE MACRO dc_alone() AS list_transform([{'d': -1.5}], lambda x: typeof((SELECT x.d.abs())));

query I
SELECT dc_alone() FROM x;
----
['DECIMAL(2,1)']

query I
SELECT list_transform([{'d': -1.5}], lambda x: typeof((SELECT x.d.abs()))) FROM x AS q;
----
['DECIMAL(2,1)']

