# name: test/sql/function/list/lambdas/lambda_window_reference.test
# description: Window functions inside lambda bodies that reference the lambda parameters
# group: [lambdas]

statement ok
CREATE TABLE t AS SELECT * FROM (VALUES (1, 10), (2, 20), (3, 30)) v(i, s);

statement error
SELECT list_transform([1], lambda x: first(x) OVER ()) FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT list_transform([1, 2], lambda x: sum(x) OVER (ORDER BY i)) FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT list_transform([1], lambda x: lead(x) OVER (ORDER BY i)) FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT list_transform([1], lambda x: lead(s, 1, x) OVER (ORDER BY i)) FROM t;
----
window functions cannot reference lambda parameters

# the parameter only in a clause of the window, not in its argument
statement error
SELECT list_transform([1], lambda x: count(*) OVER (PARTITION BY x)) FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT list_transform([1], lambda x: row_number() OVER (ORDER BY x)) FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT list_transform([1], lambda x: count(*) FILTER (WHERE x > 0) OVER ()) FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT list_transform([1], lambda x: sum(s) OVER (ORDER BY i ROWS BETWEEN x PRECEDING AND CURRENT ROW)) FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT list_transform([1], lambda x: first(s ORDER BY x) OVER ()) FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT list_transform([1], lambda x: sum(s) OVER (ORDER BY i RANGE BETWEEN x PRECEDING AND CURRENT ROW)) FROM t;
----
window functions cannot reference lambda parameters

# the parameter reached through a struct field and through a subquery in the argument
statement error
SELECT list_transform([{'a': 1}], lambda x: first(x.a) OVER ()) FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT list_transform([1], lambda x: first((SELECT x)) OVER ()) FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT list_transform([1], lambda x: first(x) OVER w) FROM t WINDOW w AS (ORDER BY i);
----
window functions cannot reference lambda parameters

# the other lambda functions and the comprehension form
statement error
SELECT [first(x) OVER () FOR x IN [1, 2]] FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT [x FOR x IN [1, 2] IF first(x) OVER () > 0] FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT list_filter([1, 2], lambda x: first(x) OVER () > 0) FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT list_reduce([1, 2], lambda a, b: a + first(b) OVER ()) FROM t;
----
window functions cannot reference lambda parameters

# nested lambdas: a parameter of the inner and of the outer lambda
statement error
SELECT list_transform([[1]], lambda x: list_transform(x, lambda y: first(y) OVER ())) FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT list_transform([[1]], lambda x: list_transform(x, lambda y: y + first(len(x)) OVER ())) FROM t;
----
window functions cannot reference lambda parameters

# the window in another clause of the query
statement error
SELECT list_transform([1], lambda x: first(x) OVER ()) FROM t GROUP BY i;
----
window functions cannot reference lambda parameters

statement error
SELECT i FROM t QUALIFY list_transform([1], lambda x: first(x) OVER ())[1] = 1;
----
window functions cannot reference lambda parameters

statement error
SELECT i FROM t ORDER BY list_transform([1], lambda x: first(x) OVER ())[1];
----
window functions cannot reference lambda parameters

statement error
SELECT list_transform(NULL::INTEGER[], lambda x: first(x) OVER ()) FROM t;
----
window functions cannot reference lambda parameters

# a window that a macro expands to, and a macro body that holds one
statement ok
CREATE MACRO window_max(a) AS max(a) OVER ();

statement error
SELECT list_transform([1], lambda x: window_max(x)) FROM t;
----
window functions cannot reference lambda parameters

statement error
CREATE MACRO window_over_parameter(l) AS list_transform(l, lambda x: first(x) OVER ());
----
window functions cannot reference lambda parameters

# MATCH_RECOGNIZE computes the aggregates of its measures as window functions over the match
statement error
SELECT * FROM range(3) r(x) MATCH_RECOGNIZE (ORDER BY x MEASURES list_transform([1], lambda v: sum(v)) AS n PATTERN (A+) DEFINE A AS true);
----
window functions cannot reference lambda parameters

# an aggregate inside the window names itself, as outside a window
statement error
SELECT list_transform([1], lambda x: first(sum(x)) OVER ()) FROM t;
----
aggregate functions cannot reference lambda parameters

statement error
SELECT list_transform([1], lambda x: sum(x)) FROM t;
----
aggregate functions cannot reference lambda parameters

# windows that do not reference the lambda parameters are computed over the rows of the query
query II
SELECT i, list_transform([1, NULL], lambda x: x + sum(s) OVER ()) FROM t ORDER BY i;
----
1	[61, NULL]
2	[61, NULL]
3	[61, NULL]

query II
SELECT i, list_transform([1, 2], lambda x: x * row_number() OVER (ORDER BY s DESC)) FROM t ORDER BY i;
----
1	[3, 6]
2	[2, 4]
3	[1, 2]

query II
SELECT i, [x + lag(s, 1, 0) OVER (ORDER BY i) FOR x IN [1, NULL, 5] IF count(*) OVER () > x] FROM t ORDER BY i;
----
1	[1]
2	[11]
3	[21]

query II
SELECT i, list_transform([1], lambda x: x + sum(sum(s)) OVER ()) FROM t GROUP BY i ORDER BY i;
----
1	[61]
2	[61]
3	[61]

query II
SELECT i, list_transform([1], lambda x: x + window_max(s)) FROM t ORDER BY i;
----
1	[31]
2	[31]
3	[31]

query I
SELECT * FROM range(3) r(x) MATCH_RECOGNIZE (ORDER BY x MEASURES list_transform([1], lambda v: v + sum(x)) AS n PATTERN (A+) DEFINE A AS true);
----
[4]

# a lambda declared inside a window or an aggregate in a lambda body has only its own parameters, laid out without
# the hidden ones of the enclosing lambdas
query II
SELECT i, list_transform([1], lambda x: first(list_transform([s], lambda y: y + 1)) OVER (ORDER BY i)) FROM t ORDER BY i;
----
1	[[11]]
2	[[11]]
3	[[11]]

query I
SELECT list_transform([10], lambda x, i: x + i + (first(list_transform([1], lambda y: y + 1)) OVER ())[1]);
----
[13]

query II
SELECT i, list_transform([1], lambda x: first(list_transform([s, s], lambda y, j: y + j)) OVER (ORDER BY i)) FROM t ORDER BY i;
----
1	[[11, 12]]
2	[[11, 12]]
3	[[11, 12]]

query II
SELECT i, list_transform([1], lambda x: first(list_transform([[s]], lambda y: list_transform(y, lambda z: z + len(y) + i))) OVER (ORDER BY i)) FROM t ORDER BY i;
----
1	[[[12]]]
2	[[[12]]]
3	[[[12]]]

query II
SELECT i, list_transform([1], lambda a: list_transform([2], lambda b: a + b + first(list_sum(list_transform([s], lambda c: c + s))) OVER (ORDER BY i))) FROM t ORDER BY i;
----
1	[[23]]
2	[[23]]
3	[[23]]

query II
SELECT i, list_transform([1], lambda x: x + count(*) OVER (PARTITION BY list_transform([i % 2], lambda y: y + s - s))) FROM t ORDER BY i;
----
1	[3]
2	[2]
3	[3]

query II
SELECT i, list_transform([1], lambda x: x + row_number() OVER (ORDER BY list_transform([s], lambda y: -y))) FROM t ORDER BY i;
----
1	[4]
2	[3]
3	[2]

query II
SELECT i, list_transform([1], lambda x: x + sum(list_sum(list_transform([s], lambda y: y + 1)))) FROM t GROUP BY i ORDER BY i;
----
1	[12]
2	[22]
3	[32]

query I
SELECT list_transform([10], lambda x, k: x + k + sum(list_sum(list_transform([s], lambda y: y + 1)))) FROM t;
----
[74]

query I
SELECT list_transform([1], lambda x: first(list_transform([[s]], lambda y: list_transform(y, lambda z: z + len(y))) ORDER BY i)) FROM t;
----
[[[11]]]

query II
SELECT i, list_transform([1], lambda x: first(list_reduce([s, s], lambda a, b, k: a + b + k + i)) OVER (ORDER BY i)) FROM t ORDER BY i;
----
1	[23]
2	[23]
3	[23]

query I
SELECT list_transform([1], lambda x: x + sum(list_reduce([s, s], lambda a, b: a + b + s, 0))) FROM t;
----
[241]

query I
SELECT list_transform([1], lambda x: x + sum(s) FILTER (WHERE list_sum(list_transform([s], lambda y: y + 1)) > 15)) FROM t;
----
[51]

# an aggregate inside a lambda inside a window inside a lambda body hides one more binding than the window
query I
SELECT list_transform([1], lambda x: first(list_transform([1], lambda y: y + sum(list_sum(list_transform([s], lambda z: z + 1))))) OVER ()) FROM t;
----
[[64]]

query I
SELECT i FROM t GROUP BY i HAVING list_transform([1], lambda x: x + sum(list_sum(list_transform([s], lambda y: y + 1))))[1] > 15 ORDER BY i;
----
2
3

query I
SELECT i FROM t QUALIFY list_transform([1], lambda x: x + max(list_sum(list_transform([s], lambda y: y + i))) OVER ())[1] = i + 33 ORDER BY i;
----
1

query I
SELECT * FROM range(3) r(x) MATCH_RECOGNIZE (ORDER BY x MEASURES list_transform([1], lambda v: v + sum(list_sum(list_transform([x], lambda y: y + 1)))) AS n PATTERN (A+) DEFINE A AS true);
----
[7]

# the enclosing parameter stays hidden next to a lambda inside the window or aggregate and inside its body
statement error
SELECT list_transform([1], lambda x: first(x + list_sum(list_transform([s], lambda y: y))) OVER ()) FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT list_transform([1], lambda x: count(*) OVER (PARTITION BY list_transform([s], lambda y: y + x))) FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT list_transform([1], lambda x: row_number() OVER (ORDER BY list_transform([s], lambda y: y + x))) FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT list_transform([1], lambda x: first(list_transform([s], lambda y: y + x)) OVER ()) FROM t;
----
window functions cannot reference lambda parameters

statement error
SELECT list_transform([1], lambda x: sum(list_sum(list_transform([s], lambda y: y + x)))) FROM t;
----
aggregate functions cannot reference lambda parameters

statement error
SELECT list_transform([1], lambda x: sum(s) FILTER (WHERE list_sum(list_transform([s], lambda y: y + x)) > 0)) FROM t;
----
aggregate functions cannot reference lambda parameters

statement error
SELECT list_transform([1], lambda x: first(s ORDER BY list_sum(list_transform([s], lambda y: y + x)))) FROM t;
----
aggregate functions cannot reference lambda parameters

# outside any lambda body nothing is hidden
query II
SELECT i, first(list_transform([s], lambda y: y + 1)) OVER (ORDER BY i) FROM t ORDER BY i;
----
1	[11]
2	[11]
3	[11]
