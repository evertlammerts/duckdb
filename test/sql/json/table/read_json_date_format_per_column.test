# A two digit year is not read by a four digit year format or the plain cast, so mixed widths are text
statement ok
copy (select * from (values ('{"d":"05-06-99"}'), ('{"d":"05-06-1999"}'))) to '{TEMP_DIR}/year_widths.json' (format csv, quote '', header 0)

query II
select typeof(d), d from read_json('{TEMP_DIR}/year_widths.json')
----
VARCHAR	05-06-99
VARCHAR	05-06-1999

statement ok
copy (select * from (values ('{"d":"05-06-99 10:00:00"}'), ('{"d":"05-06-1999 10:00:00"}'))) to '{TEMP_DIR}/year_widths_ts.json' (format csv, quote '', header 0)

query II
select typeof(d), d from read_json('{TEMP_DIR}/year_widths_ts.json')
----
VARCHAR	05-06-99 10:00:00
VARCHAR	05-06-1999 10:00:00

statement ok
copy (select * from (values ('{"d":"96-03-27"}'), ('{"d":"1996-03-27"}'))) to '{TEMP_DIR}/year_widths_iso.json' (format csv, quote '', header 0)

query II
