# name: test/sql/json/test_execute_serialized_mark_join.test
# description: A serialized statement whose join type is MARK deserializes, binds and runs
# group: [json]

require json

# The function reports no progress, which the progress verifier flags once its result spans two chunks.
statement ok
SET debug_verify_progress_ignore='UNSUPPORTED_SOURCE:JSON_EXECUTE_SERIALIZED_SQL';

# SQL cannot spell a mark join, so a serialized semi join is edited into one
query IT
SELECT a, __mark_join_marker
FROM json_execute_serialized_sql(replace(
    json_serialize_sql('SELECT * FROM (SELECT 1 AS a UNION ALL SELECT 2) t1 SEMI JOIN (SELECT 1 AS a) t2 ON t1.a = t2.a'),
    '"join_type":"SEMI"', '"join_type":"MARK"'))
ORDER BY a
----
1	true
2	false
