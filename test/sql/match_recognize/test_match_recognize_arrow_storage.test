# name: test/sql/match_recognize/test_match_recognize_arrow_storage.test
# description: MATCH_RECOGNIZE - an arrow lambda read back from storage before v2.0.0 is a lambda under every setting
# group: [match_recognize]

require skip_reload

statement ok
SET lambda_syntax = 'ENABLE_SINGLE_ARROW'

statement ok
ATTACH '{TEST_DIR}/mr_arrow_v1_5.db' AS s15 (STORAGE_VERSION 'v1.5.0')

statement ok
CREATE TABLE s15.t4 AS SELECT * FROM (VALUES (1, 10), (2, 20), (3, 30), (4, 40)) v(i, x)

statement ok
CREATE VIEW s15.v1 AS SELECT * FROM s15.t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([{'x': 1}], A -> A.x) AS m PATTERN (A B) DEFINE B AS true)

statement ok
CREATE VIEW s15.v2 AS SELECT * FROM s15.t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([0], lambda w: PREV(list_sum(list_transform([i], w -> w)))) AS z PATTERN (A B) DEFINE B AS true)

statement ok
CREATE VIEW s15.v3 AS SELECT * FROM s15.t4 MATCH_RECOGNIZE (ORDER BY i MEASURES sum(list_transform([{'x': 100}], A -> A.x)[1]) AS s PATTERN (A+) DEFINE A AS true)

statement ok
CREATE VIEW s15.v4 AS SELECT * FROM s15.t4 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A+) DEFINE A AS sum(list_transform([{'x': 1}], A -> A.x)[1]) < 3)

statement ok
CREATE MACRO s15.map_both(xs, ys, f) AS list_transform(xs || ys, f)

statement ok
CREATE VIEW s15.v5 AS SELECT * FROM s15.t4 MATCH_RECOGNIZE (ORDER BY i MEASURES sum(map_both([{'x': 1}], [{'x': 2}], A -> A.x)[1]) AS s PATTERN (A+) DEFINE A AS true)

statement ok
CREATE VIEW s15.v6 AS SELECT * FROM s15.t4 MATCH_RECOGNIZE (ORDER BY i MEASURES s15.map_both([{'x': 1}], [{'x': 2}], A -> A.x) AS m PATTERN (A B) DEFINE B AS true)

statement ok
CREATE VIEW s15.v7 AS SELECT * FROM s15.t4 MATCH_RECOGNIZE (ORDER BY i MEASURES sum(s15.map_both([{'x': 1}], [{'x': 2}], A -> A.x)[1]) AS s PATTERN (A+) DEFINE A AS true)

statement ok
DETACH s15

foreach setting DEFAULT ENABLE_SINGLE_ARROW DISABLE_SINGLE_ARROW

statement ok
SET lambda_syntax = '{setting}'

statement ok
ATTACH '{TEST_DIR}/mr_arrow_v1_5.db' AS s15

query I
SELECT m FROM s15.v1
----
[1]
[1]

query I rowsort
SELECT z FROM s15.v2
----
[1]
[3]

query I
SELECT s FROM s15.v3
----
400

query I
SELECT c FROM s15.v4
----
2
2

query I
SELECT s FROM s15.v5
----
4

query I
SELECT m FROM s15.v6
----
[1, 2]
[1, 2]

query I
SELECT s FROM s15.v7
----
4

statement ok
DETACH s15

endloop
