[30]

query I
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES list_transform([1], lambda s: FIRST(A.s)) AS m PATTERN (A+) DEFINE A AS true
)
----
[10]

query I
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES list_transform([1], lambda st: A.st.f) AS m PATTERN (A+) DEFINE A AS true
)
----
[20]

query I
FROM t MATCH_RECOGNIZE (
