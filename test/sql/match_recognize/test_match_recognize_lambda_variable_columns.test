)
----
[y]

query I
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES list_transform([1], lambda s: sum(U.s)) AS m PATTERN (A B) SUBSET U = (A, B)
    DEFINE A AS true, B AS true
)
