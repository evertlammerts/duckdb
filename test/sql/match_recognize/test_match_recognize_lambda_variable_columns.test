# name: test/sql/match_recognize/test_match_recognize_lambda_variable_columns.test
# description: MATCH_RECOGNIZE - a column behind a pattern variable inside a lambda body
# group: [match_recognize]

statement ok
CREATE TABLE t AS FROM (VALUES (10, 1, 'X', {'f': 10, 'g': {'h': 'Q'}}), (20, 2, 'Y', {'f': 20, 'g': {'h': 'R'}})) v(s, i, w, st);

# A.s names column s of the rows A matched, whatever the enclosing lambda calls its parameter

query II
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES count(*) AS n, FIRST(A.i) AS first_i PATTERN (A)
    DEFINE A AS list_bool_or(list_transform([1], lambda s: A.s > 15))
)
----
1	2

query II
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES count(*) AS n, FIRST(A.i) AS first_i PATTERN (A)
    DEFINE A AS list_bool_or(list_transform([1], lambda y: A.s > 15))
)
----
1	2

query I
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES FIRST(A.i) AS first_i PATTERN (A)
    DEFINE A AS list_bool_or(list_transform([[1]], lambda s: list_bool_or(list_transform(s, lambda s: A.s > 15))))
)
----
2

query I
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES FIRST(A.i) AS first_i PATTERN (A)
    DEFINE A AS list_bool_or(list_transform([{'f': 0}], lambda st: A.st.f > 15))
)
----
2

query I
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES FIRST(A.i) AS first_i PATTERN (A)
    DEFINE A AS list_bool_or(list_transform(['q'], lambda w: A.w.lower() = 'y'))
)
----
2

query I
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES FIRST(A.i) AS first_i PATTERN (A)
    DEFINE A AS list_bool_or(list_transform(['z'], lambda st: A.st.g.h.lower() = 'r'))
)
----
2

query I
FROM (VALUES (10, 1), (20, 2)) v("a.b", i) MATCH_RECOGNIZE (
    ORDER BY i MEASURES FIRST(A.i) AS first_i PATTERN (A)
    DEFINE A AS list_bool_or(list_transform([1], lambda "a.b": A."a.b" > 15))
)
----
2

# another variable's column is the one on its last row so far, also from inside a lambda
query II
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES FIRST(A.i) AS a_i, FIRST(B.i) AS b_i PATTERN (A B)
    DEFINE A AS true, B AS list_bool_or(list_transform([100], lambda s: B.s > A.s))
)
----
1	2

query I
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES count(*) AS n PATTERN (A B)
    DEFINE A AS true, B AS list_bool_or(list_transform([{'f': 0}], lambda st: A.st.f = 10))
)
----
2

query I
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES count(*) AS n PATTERN (A B) SUBSET U = (A, B)
    DEFINE A AS true, B AS list_bool_or(list_transform([1], lambda s: U.s > 15))
)
----
2

query II
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES count(*) AS n, FIRST(A.i) AS first_i PATTERN (A+)
    DEFINE A AS list_bool_or(list_transform([100], lambda s: sum(A.s) <= 10))
)
----
1	1

query I
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS list_bool_or(list_transform([100], lambda s: FIRST(A.s) = 10))
)
----
2

query I
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES FIRST(A.i) AS first_i PATTERN (A)
    DEFINE A AS list_bool_or(list_transform([100], lambda s: PREV(A.s) = 10))
)
----
2

# a bare name inside the lambda is still its parameter, and where the parameter cannot be read, the
# error says so

query I rowsort
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES FIRST(A.i) AS first_i PATTERN (A)
    DEFINE A AS list_bool_or(list_transform([100], lambda s: s > 15))
)
----
1
2

statement error
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS list_bool_or(list_transform([100], lambda s: sum(s) > 0))
)
----
aggregate functions cannot reference lambda parameters

statement error
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS list_bool_or(list_transform([100], lambda s: PREV(s) > 0))
)
----
window functions cannot reference lambda parameters

# a column no lambda binds is the row being tested
query I
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES FIRST(A.i) AS first_i PATTERN (A)
    DEFINE A AS list_bool_or(list_transform([1], lambda y: s > 15))
)
----
2

# A lambda parameter spelled like the pattern variable is the lambda's, so A.s is its field, in a
# navigation and an aggregate too, where a parameter cannot be read

query I rowsort
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES FIRST(A.i) AS first_i PATTERN (A)
    DEFINE A AS list_bool_or(list_transform([{'s': 100}], lambda A: A.s > 15))
)
----
1
2

query I rowsort
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES FIRST(A.i) AS first_i PATTERN (A)
    DEFINE A AS list_bool_or(list_transform([{'s': 100}], lambda A: list_bool_or(list_transform([1], lambda s: A.s > 15))))
)
----
1
2

statement error
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS list_bool_or(list_transform([{'s': 100}], lambda A: sum(A.s) > 0))
)
----
aggregate functions cannot reference lambda parameters

statement error
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS list_bool_or(list_transform([{'s': 100}], lambda A: PREV(A.s) > 0))
)
----
window functions cannot reference lambda parameters

statement error
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS list_bool_or(list_transform([{'s': 100}], lambda A: FIRST(A.s) > 0))
)
----
window functions cannot reference lambda parameters

statement error
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS list_bool_or(list_transform(['A'], lambda A: CLASSIFIER(A) = 'A'))
)
----
CLASSIFIER() takes a pattern variable

# MEASURES reads a variable's column the same way

query I
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES list_transform([1], lambda s: A.s) AS m PATTERN (A+) DEFINE A AS true
)
----
[20]

query I
FROM t MATCH_RECOGNIZE (
    ORDER BY i MEASURES list_transform([1], lambda s: sum(A.s)) AS m PATTERN (A+) DEFINE A AS true
)
