# A MEASURES step is computed per input row below the matcher, so it cannot read the parameter either,
# even where the parameter is spelled like a column of the input.

statement ok
CREATE TABLE t4 AS SELECT * FROM (VALUES (1, 10, 7), (2, 20, 8), (3, 30, 9), (4, 5, 1)) v(i, s, x);

statement error
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([100], lambda x: PREV(x)) AS m PATTERN (A+) DEFINE A AS true);
----
window functions cannot reference lambda parameters

statement error
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([100], lambda x: NEXT(x)) AS m ALL ROWS PER MATCH PATTERN (A+) DEFINE A AS true);
----
window functions cannot reference lambda parameters

statement error
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([100], lambda q: PREV(q)) AS m PATTERN (A+) DEFINE A AS true);
----
window functions cannot reference lambda parameters

# a step may hold a lambda of its own, whose parameter may shadow the outer one, and may name the
# column with its table or with a pattern variable
query I
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([100], lambda x: PREV(list_sum(list_transform([s], lambda x: x + 1)))) AS m PATTERN (A+) DEFINE A AS true);
----
[31]

query I
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([100], lambda x: x + PREV(t4.x)) AS m PATTERN (A+) DEFINE A AS true);
