# A lambda parameter spelled like a pattern variable is the one in scope inside an aggregate or a
# navigation as well, so those read a parameter of the lambda they are written in.

query I
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A B+) DEFINE B AS list_bool_or(list_transform([{'s': 100}], lambda A: A.s < s)));
----

statement error
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A B+) DEFINE B AS list_bool_or(list_transform([{'s': 100}], lambda A: sum(A.s) < s)));
