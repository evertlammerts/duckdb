# A method call behind a pattern variable is a call on the variable's column, which the parser keeps
# in the function's name: a lambda parameter spelled like the column does not claim it either.

statement ok
CREATE TABLE u AS SELECT * FROM (VALUES (1, 'W1'), (2, 'W2'), (3, 'W3'), (4, 'W4')) v(i, w);

query I rowsort
SELECT * FROM u MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A+) DEFINE A AS list_bool_or(list_transform(['w3'], lambda w: A.w.lower() <> 'w3')));
----
1
2

query I
SELECT * FROM u MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A B+) DEFINE B AS list_bool_or(list_transform(['w3'], lambda w: B.w.lower() <> 'w3')));
----
2
2

query I
SELECT * FROM u MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A B+) DEFINE B AS list_bool_or(list_transform(['w9'], lambda w: max(A.w.lower()) < w)));
----
4

query III
SELECT * FROM u MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform(['Q'], lambda w: A.w.lower() || w) AS m, list_transform(['Q'], lambda w: max(B.w.lower()) || w) AS n, list_transform(['Q'], lambda q: LAST(B.w.lower()) || q) AS o PATTERN (A B+) DEFINE B AS true);
----
[w1Q]	[w4Q]	[w4Q]

# without a lambda and with arguments
query II rowsort
SELECT * FROM u MATCH_RECOGNIZE (ORDER BY i MEASURES A.w.lower() AS m, LAST(B.w.substr(2)) AS n PATTERN (A B+) DEFINE B AS B.w.lower() <> 'w3');
----
w1	2
w3	4

# a lambda parameter spelled like the variable is the one in scope, so the call is on its field
query I
SELECT * FROM u MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([{'w': 'Z'}], lambda A: A.w.lower()) AS m PATTERN (A B+) DEFINE B AS true);
----
[z]

query I
SELECT * FROM u MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A B+) DEFINE B AS list_bool_or(list_transform([{'w': 'Z'}], lambda A: A.w.lower() = 'z')));
----
4

statement error
SELECT * FROM u MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([{'w': 'Z'}], lambda A: max(A.w.lower())) AS m PATTERN (A B+) DEFINE B AS true);
----
window functions cannot reference lambda parameters

# CLASSIFIER() of a name a lambda binds names no pattern variable, inside an aggregate or a navigation too
statement error
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES FIRST(list_transform([0], lambda A: CLASSIFIER(A))[1]) AS c PATTERN (A+) DEFINE A AS true);
----
CLASSIFIER() takes a pattern variable

statement error
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([{'s': 1}], lambda B: CLASSIFIER(B)) AS c PATTERN (A B+) DEFINE B AS true);
----
CLASSIFIER() takes a pattern variable

statement error
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A+) DEFINE A AS list_bool_or(list_transform([1], lambda A: CLASSIFIER(A) = 'A')));
----
CLASSIFIER() takes a pattern variable

# an arrow that turns out to be a lambda is a scope of its own inside a step and an aggregate
statement ok
SET lambda_syntax='ENABLE_SINGLE_ARROW'

query I rowsort
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([0], lambda v: PREV(list_sum(list_transform([s], v -> v)))) AS z PATTERN (A B) DEFINE B AS true);
----
[10]
[30]

query I
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES sum(list_transform([{'x': 100}], A -> A.x)[1]) AS m PATTERN (A+) DEFINE A AS true);
----
400

# so is a longer path on an arrow's parameter
query I
SELECT * FROM (SELECT *, list_transform([{'st': {'g': 'Z'}, 'g': 'Y'}], A -> A.st.g.lower()) AS outside FROM u) MATCH_RECOGNIZE (ORDER BY i MEASURES FIRST(outside) = list_transform([{'st': {'g': 'Z'}, 'g': 'Y'}], A -> A.st.g.lower()) AS same PATTERN (A B+) DEFINE B AS true);
----
true

# a method call on a lambda parameter is read by the engine, which counts the receiver as the first argument
query I
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([[{'x': 5}]], lambda xs: xs.list_transform(A -> A.x)) AS m PATTERN (A B) DEFINE B AS true);
----
[[5]]
[[5]]

statement ok
RESET lambda_syntax

# A method call the catalog does not name, or one of this clause's navigations, is the call on the receiver the
# engine builds, so it meets the same scope checks as the function spelling: on a bare or table qualified column,
# or behind a pattern variable.

statement ok
CREATE TABLE tn AS SELECT * FROM (VALUES (1, -10), (2, -20), (3, -30)) v(i, x);

statement error
SELECT * FROM tn MATCH_RECOGNIZE (ORDER BY i MEASURES sum(A.x + x.abs()) AS s PATTERN (A B+) DEFINE A AS true, B AS true);
----
sum() reads the rows of "A", so "x" cannot also read the whole match

query I
SELECT * FROM tn t MATCH_RECOGNIZE (ORDER BY i MEASURES LAST(t.x.abs()) AS s PATTERN (A B+) DEFINE A AS true, B AS true);
----
30

query I
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES B.s.prev(1) AS m PATTERN (A B+) DEFINE B AS true);
----
20

query I
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES A.s.next(1) AS m PATTERN (A B+) DEFINE B AS true);
----
20

query I
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A B+) DEFINE B AS B.s.prev(1) > 15);
----
2

query I
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES s.prev(1) AS m PATTERN (A B+) DEFINE B AS true);
----
20

query III
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES B.s.first() AS f, B.s.last() AS l, B.classifier() AS c PATTERN (A B+) DEFINE B AS true);
----
20	30	B

# the engine knows no navigation, so one is the clause's call on a lambda parameter as well
statement error
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([{'w': 'Z'}], lambda A: A.w.prev(0)) AS m PATTERN (A B+) DEFINE B AS true);
----
window functions cannot reference lambda parameters

# The receiver is built by the engine's own construction, so a longer path reads as it reads outside the clause:
# behind a table, on a column, behind a pattern variable and on a lambda parameter
statement error
SELECT * FROM (SELECT i, {'g': 'ab'} AS st FROM t3) t MATCH_RECOGNIZE (ORDER BY i MEASURES FIRST(t.st.g.upper()) AS m PATTERN (A) DEFINE A AS true);
----
does not have a column named "g"

statement ok
CREATE TABLE us AS SELECT i, {'g': {'h': w}, 'h': 'Q' || i} AS st, 'q' || i AS h FROM u;

query II
SELECT * FROM (SELECT *, st.g.h.lower() AS outside FROM us) MATCH_RECOGNIZE (ORDER BY i MEASURES FIRST(outside) = FIRST(st.g.h.lower()) AS same, LAST(outside) = LAST(st.g.h.lower()) AS same_last PATTERN (A B+) DEFINE B AS true);
----
true	true

query I
SELECT * FROM (SELECT *, x.st.g.h.lower() AS outside FROM us x) MATCH_RECOGNIZE (ORDER BY i MEASURES FIRST(outside) = A.st.g.h.lower() AS same PATTERN (A B+) DEFINE B AS true);
----
true

query I
SELECT * FROM (SELECT *, list_transform([{'st': {'g': 'Z'}, 'g': 'Y'}], lambda A: A.st.g.lower()) AS outside FROM u) MATCH_RECOGNIZE (ORDER BY i MEASURES FIRST(outside) = list_transform([{'st': {'g': 'Z'}, 'g': 'Y'}], lambda A: A.st.g.lower()) AS same PATTERN (A B+) DEFINE B AS true);
----
true

query I
SELECT * FROM (SELECT *, list_transform([{'st': {'g': 'Z'}, 'g': 'Y'}], lambda A: A.st.g.lower()) AS outside FROM u) MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A+) DEFINE A AS list_transform([{'st': {'g': 'Z'}, 'g': 'Y'}], lambda A: A.st.g.lower()) = outside);
----
4

# a method call led by a lambda parameter is read as the engine reads it, inside the clause and outside it alike,
# with one name in front of the call or more
query I
SELECT * FROM (SELECT i, x, list_transform(['zz'], lambda x: x.upper()) AS outside FROM (VALUES (1, 'ab')) t(i, x)) MATCH_RECOGNIZE (ORDER BY i MEASURES FIRST(outside) = list_transform(['zz'], lambda x: x.upper()) AS same PATTERN (A) DEFINE A AS true);
----
true

query I
SELECT * FROM (SELECT i, x, list_transform([{'f': {'g': 'zz'}, 'g': 'yy'}], lambda x: x.f.g.upper()) AS outside FROM (VALUES (1, {'f': {'g': 'ab'}, 'g': 'cd'})) t(i, x)) MATCH_RECOGNIZE (ORDER BY i MEASURES FIRST(outside) = list_transform([{'f': {'g': 'zz'}, 'g': 'yy'}], lambda x: x.f.g.upper()) AS same PATTERN (A) DEFINE A AS true);
----
true

# so is the unnest the engine refuses here, which is never a method call
statement error
SELECT * FROM (SELECT i, [i] AS li FROM range(1, 5) r(i)) MATCH_RECOGNIZE (ORDER BY i MEASURES FIRST(li.unnest()) AS m PATTERN (A) DEFINE A AS true);
----
UNNEST
