# name: test/sql/match_recognize/test_match_recognize_lambdas.test
# description: MATCH_RECOGNIZE - lambda scopes, and matcher state a lambda captures
# group: [match_recognize]

statement ok
PRAGMA enable_verification

# A lambda names its own parameters, and a name it binds is not the input's to compute below this
# clause. What the name means is the ordinary binder's to decide, here as anywhere else.

query I
FROM (VALUES (10)) t(x) MATCH_RECOGNIZE (
    MEASURES list_transform([1, 2], lambda v: v + 1) AS s PATTERN (A)
 DEFINE A AS true)
----
[2, 3]

query I
FROM (VALUES ([1, 2])) t(xs) MATCH_RECOGNIZE (
    MEASURES list_transform(t.xs, lambda v: v + 1) AS s PATTERN (A)
 DEFINE A AS true)
----
[2, 3]

# the parameter is the lambda's even where the input has a column of the same name, and the column is
# still the column everywhere else
query II
FROM (VALUES ([1, 2], 100)) t(xs, v) MATCH_RECOGNIZE (
    MEASURES list_transform(xs, lambda v: v + 1) AS s, v AS w PATTERN (A)
 DEFINE A AS true)
----
[2, 3]	100

# a name the lambda does not bind is the input's, and is computed there
query I
FROM (VALUES ([1, 2], 100)) t(xs, v) MATCH_RECOGNIZE (
    MEASURES list_transform(xs, lambda w: w + v) AS s PATTERN (A)
 DEFINE A AS true)
----
[101, 102]

query I
FROM (VALUES ([[1, 2]], 10)) t(xs, x) MATCH_RECOGNIZE (
    MEASURES list_transform(xs, lambda a: list_transform(a, lambda b: b + x)) AS s PATTERN (A)
 DEFINE A AS true)
----
[[11, 12]]

query I
FROM (VALUES ([1, 2], 1), ([3, 4], 2)) t(xs, i) MATCH_RECOGNIZE (
    ORDER BY i MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS len(list_filter(xs, lambda v: v > 2)) = 0
)
----
1

query I
FROM (VALUES ([2, 1]), ([1, 1])) t(xs) MATCH_RECOGNIZE (
    ORDER BY list_transform(xs, lambda v: v)[1] MEASURES count(*) AS n PATTERN (A+)
 DEFINE A AS true)
----
2

# The match number is a field the matcher writes per attempt, and until the plan knows which field it
# is a column of a table nothing produces - so it is captured out of a lambda body the way any other
# value a condition reads is, rather than staying behind as a reference the lambda would read.

query I
FROM range(2) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS list_transform([1], lambda v: v + MATCH_NUMBER())[1] > 1
)
----
2

query I
FROM range(2) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS list_transform([[1]], lambda a: list_transform(a, lambda b: b + MATCH_NUMBER()))[1][1] > 1
)
----
2

# a condition that captures the match number still depends on the attempt it is tested in, so the
# same answer as the spelling that reads it directly
query I
SELECT n FROM (
    FROM range(3) t(x) MATCH_RECOGNIZE (
        ORDER BY x MEASURES count(*) AS n AFTER MATCH SKIP TO NEXT ROW PATTERN (A+)
        DEFINE A AS list_transform([1], lambda v: v * MATCH_NUMBER())[1] < 3
    )
) ORDER BY n
----
2
3

query I
FROM range(2) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS list_transform(['q'], lambda v: v || CLASSIFIER())[1] = 'qA'
)
----
2

query I
FROM range(3) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS list_transform([1], lambda v: v + FIRST(x))[1] > 0
)
----
3

query I
FROM range(3) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS list_transform([1], lambda v: v + x)[1] >= 1
)
----
3

query I
SELECT s FROM (
    FROM range(2) t(x) MATCH_RECOGNIZE (
        ORDER BY x MEASURES list_transform([1], lambda v: v + MATCH_NUMBER()) AS s
        ALL ROWS PER MATCH PATTERN (A+)
     DEFINE A AS true)
) LIMIT 1
----
[2]

# where the value is computed still decides what it may read, lambda or not
statement error
FROM range(2) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS lag(list_transform([1], lambda v: v + MATCH_NUMBER())[1]) OVER (ORDER BY x) IS NULL
)
----
cannot be part of a window function

statement error
FROM range(2) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n PATTERN (A+)
    DEFINE A AS FIRST(list_transform([1], lambda v: v + MATCH_NUMBER())[1]) > 1
)
----
cannot be part of the expression a navigation reads

# A lambda parameter and a pattern variable can be spelled the same way. The lambda's is the one in
# scope, so what its body reads does not change with the spelling of the parameter.

query I
FROM (VALUES (10)) t(x) MATCH_RECOGNIZE (
    MEASURES list_transform([{'x': 1}, {'x': 2}], lambda A: A.x + 1) AS s PATTERN (A)
 DEFINE A AS true)
----
[2, 3]

query I
FROM (VALUES (10)) t(x) MATCH_RECOGNIZE (
    MEASURES list_transform([{'x': 1}, {'x': 2}], lambda v: v.x + 1) AS s PATTERN (A)
 DEFINE A AS true)
----
[2, 3]

query I
FROM (VALUES (10)) t(x) MATCH_RECOGNIZE (
    MEASURES count(*) AS n PATTERN (A)
    DEFINE A AS list_transform([{'x': 1}], lambda A: A.x)[1] = 1
)
----
1

# the same inside an aggregate, whose arguments decide which rows of the match it aggregates
query I
FROM (VALUES (10)) t(x) MATCH_RECOGNIZE (
    MEASURES list_sum(list_transform([{'x': 1}, {'x': 2}], lambda A: A.x)) AS s PATTERN (A)
 DEFINE A AS true)
----
3

# an aggregate over the rows of the match reads its arguments for a pattern variable to scope to, so
# a lambda parameter inside one must not be mistaken for a variable the match could be scoped to
query I
SELECT s FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES sum(list_transform([{'A': x}], lambda A: A.A)[1]) AS s PATTERN (A+)
 DEFINE A AS true)
----
3

# naming the variable outside the lambda still scopes the aggregate to the rows it matched
query I
SELECT s FROM (VALUES (1), (2), (3)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES sum(list_transform([B.x], lambda v: v)[1]) AS s
    PATTERN (A B+) DEFINE A AS x < 2, B AS x >= 2
)
----
5

# a pattern variable in front of a column still means the column, where no lambda binds the name
query II
SELECT * FROM (VALUES (1), (2)) t(x) MATCH_RECOGNIZE (
    ORDER BY x MEASURES count(*) AS n, LAST(A.x) AS last_x PATTERN (A+)
 DEFINE A AS true)
----
2	2

# The arrow spelling is the JSON operator as well as a lambda, and which it is only settles when the
# enclosing function is bound - so nothing about it is decided before that, and an ambiguous column
# under one is still ambiguous.

statement error
FROM (
    (VALUES (1)) a(j)
    CROSS JOIN (VALUES (2)) b(j)
) MATCH_RECOGNIZE (
    MEASURES (j -> 'k') AS v PATTERN (X)
 DEFINE X AS true)
----
Ambiguous reference to column name "j"

statement error
FROM (
    (VALUES (1)) a(j)
    CROSS JOIN (VALUES (2)) b(j)
) MATCH_RECOGNIZE (
    MEASURES j AS v PATTERN (X)
 DEFINE X AS true)
----
Ambiguous reference to column name "j"

# nor is a pattern variable the arrow may bind taken for one, so as a lambda it reads its parameter
statement ok
SET lambda_syntax='ENABLE_SINGLE_ARROW'

query I
FROM (VALUES (10)) t(x) MATCH_RECOGNIZE (
    MEASURES list_transform([{'x': 1}, {'x': 2}], A -> A.x + 1) AS s PATTERN (A)
 DEFINE A AS true)
----
[2, 3]

statement ok
RESET lambda_syntax

# A DEFINE aggregate or navigation is computed over the rows of the match, outside the lambda it is
# written in, so it cannot read the lambda's parameter; a lambda inside it starts a scope of its own.

statement ok
CREATE TABLE t3 AS SELECT * FROM (VALUES (1, 10, 7), (2, 20, 8), (3, 30, 9)) v(i, s, x);

statement error
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A+) DEFINE A AS list_bool_or(list_transform([1], lambda v: sum(v) > 0)));
----
aggregate functions cannot reference lambda parameters

statement error
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A+) DEFINE A AS list_bool_or(list_transform([1], lambda v: count(v) > 0)));
----
aggregate functions cannot reference lambda parameters

statement error
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A+) DEFINE A AS list_bool_or(list_transform([1], lambda v: FIRST(v) > 0)));
----
window functions cannot reference lambda parameters

statement error
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A+) DEFINE A AS list_bool_or(list_transform([1], lambda v: LAST(s + v) > 0)));
----
window functions cannot reference lambda parameters

statement error
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A+) DEFINE A AS list_bool_or(list_transform([1], lambda v: PREV(v) IS NULL)));
----
window functions cannot reference lambda parameters

query I rowsort
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A+) DEFINE A AS list_bool_or(list_transform([1], lambda v: v + sum(s) > 0)));
----
3

query I rowsort
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A+) DEFINE A AS sum(s) < 40);
----
1
2

query I rowsort
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A+) DEFINE A AS list_bool_or(list_transform([1], lambda v: v + sum(list_sum(list_transform([s], lambda y: y + s))) < 70)));
----
1
2

query I rowsort
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A+) DEFINE A AS list_bool_or(list_transform([1], lambda v: LAST(list_sum(list_transform([s], lambda y: y + s))) = 20 * v)));
----
1

query I rowsort
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A+) DEFINE A AS list_bool_or(list_transform([1], lambda v: coalesce(PREV(list_sum(list_transform([s], lambda y: y + s))), 0) < 30 * v)));
----
2

query I rowsort
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([1], lambda v: v + sum(list_sum(list_transform([s], lambda y: y + s)))) AS c PATTERN (A+) DEFINE A AS true);
----
[121]

query I rowsort
SELECT * FROM t3 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([1], lambda v: v + LAST(list_sum(list_transform([s], lambda y: y + s)))) AS c PATTERN (A+) DEFINE A AS true);
----
[61]

# A MEASURES step is computed per input row below the matcher, so it cannot read the parameter either,
# even where the parameter is spelled like a column of the input.

statement ok
CREATE TABLE t4 AS SELECT * FROM (VALUES (1, 10, 7), (2, 20, 8), (3, 30, 9), (4, 5, 1)) v(i, s, x);

statement error
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([100], lambda x: PREV(x)) AS m PATTERN (A+) DEFINE A AS true);
----
window functions cannot reference lambda parameters

statement error
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([100], lambda x: NEXT(x)) AS m ALL ROWS PER MATCH PATTERN (A+) DEFINE A AS true);
----
window functions cannot reference lambda parameters

statement error
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([100], lambda q: PREV(q)) AS m PATTERN (A+) DEFINE A AS true);
----
window functions cannot reference lambda parameters

# a step may hold a lambda of its own, whose parameter may shadow the outer one, and may name the
# column with its table or with a pattern variable
query I
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([100], lambda x: PREV(list_sum(list_transform([s], lambda x: x + 1)))) AS m PATTERN (A+) DEFINE A AS true);
----
[31]

query I
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([100], lambda x: x + PREV(t4.x)) AS m PATTERN (A+) DEFINE A AS true);
----
[109]

query I
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([100], lambda x: x + PREV(A.x)) AS m PATTERN (A+) DEFINE A AS true);
----
[109]

# A pattern variable in front of a column names the input's column, so a lambda parameter spelled like
# the column does not claim it, in DEFINE and in MEASURES.

query I
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A B+) DEFINE B AS list_bool_or(list_transform([1000], lambda s: A.s < 15)));
----
4

query I
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A B+) DEFINE B AS list_bool_or(list_transform([1000], lambda s: LAST(A.s) < t4.s)));
----
3

query I
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A B+) DEFINE B AS list_bool_or(list_transform([1000], lambda s: sum(A.s) < 15)));
----
4

query I
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A+) DEFINE A AS list_bool_or(list_transform([1000], lambda s: A.s > 15)));
----
2

query III
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([1000], lambda s: s + A.s) AS m, list_transform([1000], lambda s: s + sum(A.s)) AS n, list_transform([1000], lambda s: s + LAST(B.s)) AS o PATTERN (A B+) DEFINE B AS true);
----
[1010]	[1010]	[1005]

# another variable's column beside the parameter
query I
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A B+) DEFINE B AS list_bool_or(list_transform([1], lambda v: A.s + v < B.s)));
----
3

# behind a variable, a name the input does not have is still not a column, whatever the lambda binds
statement error
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A+) DEFINE A AS list_bool_or(list_transform([1], lambda q: A.q = 1)));
----
Referenced column "q" not found

# A lambda parameter spelled like a pattern variable is the one in scope inside an aggregate or a
# navigation as well, so those read a parameter of the lambda they are written in.

query I
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A B+) DEFINE B AS list_bool_or(list_transform([{'s': 100}], lambda A: A.s < s)));
----

statement error
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A B+) DEFINE B AS list_bool_or(list_transform([{'s': 100}], lambda A: sum(A.s) < s)));
----
aggregate functions cannot reference lambda parameters

statement error
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A B+) DEFINE B AS list_bool_or(list_transform([{'s': 100}], lambda A: FIRST(A.s) < s)));
----
window functions cannot reference lambda parameters

statement error
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A B+) DEFINE B AS list_bool_or(list_transform([{'s': 100}], lambda A: PREV(A.s) < s)));
----
window functions cannot reference lambda parameters

statement error
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([{'s': 100}], lambda A: sum(A.s)) AS m PATTERN (A B+) DEFINE B AS true);
----
window functions cannot reference lambda parameters

statement error
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([{'s': 100}], lambda A: LAST(A.s)) AS m PATTERN (A B+) DEFINE B AS true);
----
window functions cannot reference lambda parameters

statement error
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([{'s': 100}], lambda A: PREV(A.s)) AS m PATTERN (A B+) DEFINE B AS true);
----
window functions cannot reference lambda parameters
