[109]

# A pattern variable in front of a column names the input's column, so a lambda parameter spelled like
# the column does not claim it, in DEFINE and in MEASURES.

query I
SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES count(*) AS c PATTERN (A B+) DEFINE B AS list_bool_or(list_transform([1000], lambda s: A.s < 15)));
