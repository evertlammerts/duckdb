SELECT * FROM t4 MATCH_RECOGNIZE (ORDER BY i MEASURES list_transform([1000], lambda s: s + A.s) AS m, list_transform([1000], lambda s: s + sum(A.s)) AS n, list_transform([1000], lambda s: s + LAST(B.s)) AS o PATTERN (A B+) DEFINE B AS true);
