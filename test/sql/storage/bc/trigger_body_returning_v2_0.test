# CREATE TABLE s(id INTEGER);
# CREATE TABLE slog(k VARCHAR, id INTEGER);
# CREATE TRIGGER s_after AFTER INSERT ON s FOR EACH STATEMENT INSERT INTO slog VALUES ('after', 1) RETURNING id;
# CREATE TRIGGER s_before BEFORE DELETE ON s FOR EACH STATEMENT UPDATE slog SET id = id + 1 RETURNING id;
# CREATE TABLE q(id INTEGER);
# CREATE TRIGGER q_fires_s AFTER INSERT ON q FOR EACH STATEMENT INSERT INTO s SELECT id FROM q;
# CREATE TABLE k(id INTEGER);
