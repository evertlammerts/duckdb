# name: test/sql/trigger/trigger_body_returning.test
# description: RETURNING in a trigger body is refused at CREATE TRIGGER; a body without it fires; the RETURNING * the trigger expansion adds and a writer's own list record nothing
# group: [trigger]

require noforcestorage

statement ok
CREATE MACRO trigger_deps(trg) AS TABLE
SELECT e.name, d.deptype
FROM duckdb_dependencies() d
JOIN duckdb_triggers() t ON t.trigger_oid = d.refobjid
JOIN (
	SELECT table_oid AS oid, table_name AS name FROM duckdb_tables()
	UNION ALL
	SELECT sequence_oid, sequence_name FROM duckdb_sequences()
	UNION ALL
	SELECT type_oid, type_name FROM duckdb_types() WHERE NOT internal
	UNION ALL
	SELECT function_oid, function_name FROM duckdb_functions() WHERE NOT internal
) e ON e.oid = d.objid
WHERE t.trigger_name = trg
ORDER BY ALL;

# A statement body with RETURNING is refused, and the same body without it fires
statement ok
CREATE TABLE c(id INTEGER);

statement ok
CREATE TABLE log(id INTEGER);

statement ok
CREATE MACRO f(x) AS x + 1;

statement error
CREATE TRIGGER sc AFTER INSERT ON c FOR EACH STATEMENT INSERT INTO log VALUES (2) RETURNING f(id);
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "sc" on table "c")

statement error
CREATE TRIGGER sc AFTER INSERT ON c FOR EACH STATEMENT INSERT INTO log VALUES (2) RETURNING *;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "sc" on table "c")

query I
SELECT count(*) FROM duckdb_triggers() WHERE trigger_name = 'sc';
----
0

statement ok
DROP MACRO f;

statement ok
CREATE TRIGGER sc AFTER INSERT ON c FOR EACH STATEMENT INSERT INTO log VALUES (2);

statement ok
INSERT INTO c VALUES (1);

query I
FROM log;
----
2

statement ok
DROP TRIGGER sc ON c;

# FOR EACH ROW bodies: INSERT with NEW, DELETE with OLD
statement ok
CREATE TABLE r(id INTEGER);

statement ok
CREATE TABLE rlog(id INTEGER);

statement ok
CREATE MACRO fr(x) AS x * 10;

statement error
CREATE TRIGGER ri AFTER INSERT ON r FOR EACH ROW INSERT INTO rlog VALUES (NEW.id) RETURNING fr(id);
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "ri" on table "r")

statement error
CREATE TRIGGER rd AFTER DELETE ON r FOR EACH ROW DELETE FROM rlog WHERE id = OLD.id RETURNING id;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "rd" on table "r")

# The refusal comes before the body binds: a list naming NEW or OLD gets it too
statement error
CREATE TRIGGER rn AFTER INSERT ON r FOR EACH ROW INSERT INTO rlog VALUES (1) RETURNING NEW.id;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "rn" on table "r")

statement error
CREATE TRIGGER rn AFTER DELETE ON r FOR EACH ROW INSERT INTO rlog VALUES (OLD.id) RETURNING OLD.id;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "rn" on table "r")

statement ok
CREATE TRIGGER ri AFTER INSERT ON r FOR EACH ROW INSERT INTO rlog VALUES (NEW.id);

statement ok
CREATE TRIGGER rd AFTER DELETE ON r FOR EACH ROW DELETE FROM rlog WHERE id = OLD.id;

statement ok
INSERT INTO r VALUES (1), (2), (3);

statement ok
DELETE FROM r WHERE id = 2;

query I
SELECT id FROM rlog ORDER BY id;
----
1
3

# A BEFORE body, UPDATE and DELETE bodies
statement ok
CREATE TABLE s1(id INTEGER);

statement ok
CREATE TABLE s1log(id INTEGER, n INTEGER);

statement ok
CREATE SEQUENCE sq;

statement error
CREATE TRIGGER s1b BEFORE INSERT ON s1 FOR EACH STATEMENT INSERT INTO s1log VALUES (0, 0) RETURNING id - 1;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "s1b" on table "s1")

statement error
CREATE TRIGGER s1u AFTER INSERT ON s1 FOR EACH STATEMENT UPDATE s1log SET n = n + 1 RETURNING n + 100;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "s1u" on table "s1")

statement error
CREATE TRIGGER s1d AFTER DELETE ON s1 FOR EACH STATEMENT DELETE FROM s1log WHERE n > 5 RETURNING id * 2, nextval('sq');
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "s1d" on table "s1")

statement ok
CREATE TRIGGER s1b BEFORE INSERT ON s1 FOR EACH STATEMENT INSERT INTO s1log VALUES (0, 0);

statement ok
CREATE TRIGGER s1u AFTER INSERT ON s1 FOR EACH STATEMENT UPDATE s1log SET n = n + 1;

statement ok
CREATE TRIGGER s1d AFTER DELETE ON s1 FOR EACH STATEMENT DELETE FROM s1log WHERE n > 5;

statement ok
INSERT INTO s1 VALUES (1);

statement ok
INSERT INTO s1 VALUES (2);

query II
SELECT id, n FROM s1log ORDER BY n;
----
0	1
0	2

statement ok
DELETE FROM s1;

query I
SELECT count(*) FROM s1log;
----
2

query I
SELECT count(*) FROM duckdb_sequences() WHERE sequence_name = 'sq' AND last_value IS NULL;
----
1

# An upsert body, which binds through the MERGE rewrite, and a MERGE INTO body
statement ok
CREATE TABLE u(id INTEGER);

statement ok
CREATE TABLE ukeys(id INTEGER PRIMARY KEY, v INTEGER);

statement error
CREATE TRIGGER su AFTER INSERT ON u FOR EACH STATEMENT
	INSERT INTO ukeys SELECT id, 0 FROM u ON CONFLICT DO UPDATE SET v = v + 1 RETURNING v * 3;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "su" on table "u")

statement error
CREATE TRIGGER su AFTER INSERT ON u FOR EACH STATEMENT
	INSERT OR REPLACE INTO ukeys SELECT id, 0 FROM u RETURNING v;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "su" on table "u")

statement ok
CREATE TRIGGER su AFTER INSERT ON u FOR EACH STATEMENT
	INSERT INTO ukeys SELECT id, 0 FROM u ON CONFLICT DO UPDATE SET v = v + 1;

statement ok
INSERT INTO u VALUES (1);

statement ok
INSERT INTO u VALUES (2);

query II
SELECT id, v FROM ukeys ORDER BY id;
----
1	1
2	0

statement ok
CREATE TABLE m(id INTEGER);

statement ok
CREATE TABLE mk(id INTEGER PRIMARY KEY, v INTEGER);

statement error
CREATE TRIGGER sm AFTER INSERT ON m FOR EACH STATEMENT
	MERGE INTO mk USING (SELECT id FROM m) src ON mk.id = src.id
	WHEN MATCHED THEN UPDATE SET v = v + 1 WHEN NOT MATCHED THEN INSERT VALUES (src.id, 0)
	RETURNING merge_action, v + 5;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "sm" on table "m")

statement ok
CREATE TRIGGER sm AFTER INSERT ON m FOR EACH STATEMENT
	MERGE INTO mk USING (SELECT id FROM m) src ON mk.id = src.id
	WHEN MATCHED THEN UPDATE SET v = v + 1 WHEN NOT MATCHED THEN INSERT VALUES (src.id, 0);

statement ok
INSERT INTO m VALUES (1);

statement ok
INSERT INTO m VALUES (2);

query II
SELECT id, v FROM mk ORDER BY id;
----
1	1
2	0

# A body with a WITH clause carries its RETURNING on its own statement; a data modifying WITH stays refused in a row body
statement error
CREATE TRIGGER sw AFTER INSERT ON c FOR EACH STATEMENT WITH x AS (SELECT 4 AS id) INSERT INTO log SELECT id FROM x RETURNING id;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "sw" on table "c")

statement error
CREATE TRIGGER rw AFTER INSERT ON r FOR EACH ROW WITH x AS (SELECT NEW.id AS id) INSERT INTO rlog SELECT id FROM x RETURNING id;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "rw" on table "r")

statement error
CREATE TRIGGER rw AFTER INSERT ON r FOR EACH ROW WITH x AS (DELETE FROM rlog RETURNING id) INSERT INTO log SELECT NEW.id + id FROM x;
----
WITH clause containing a data-modifying statement must be at the top level

statement ok
CREATE TRIGGER sw AFTER INSERT ON c FOR EACH STATEMENT WITH x AS (SELECT 4 AS id) INSERT INTO log SELECT id FROM x;

statement ok
INSERT INTO c VALUES (5);

query I
SELECT id FROM log ORDER BY id;
----
2
4

statement ok
DROP TRIGGER sw ON c;

# A trigger in another schema, and a body writing into a table with a statement trigger
statement ok
CREATE SCHEMA sch;

statement ok
CREATE TABLE sch.t(id INTEGER);

statement ok
CREATE TABLE sch.tlog(v VARCHAR);

statement ok
CREATE TABLE sch.t3(id INTEGER);

statement ok
CREATE TRIGGER s3 AFTER INSERT ON sch.t3 FOR EACH STATEMENT INSERT INTO sch.tlog VALUES ('t3');

statement error
CREATE TRIGGER sx AFTER INSERT ON sch.t FOR EACH STATEMENT INSERT INTO sch.t3 VALUES (3) RETURNING id;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "sx" on table "t")

statement error
CREATE TRIGGER rx AFTER INSERT ON sch.t FOR EACH ROW INSERT INTO sch.t3 VALUES (NEW.id) RETURNING id;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "rx" on table "t")

# The expansion's RETURNING * over a generated column calling a macro records nothing, in both creation orders
statement ok
CREATE MACRO fg(x) AS x * 7;

statement ok
CREATE TABLE gs(id INTEGER, n INTEGER, g INTEGER GENERATED ALWAYS AS (fg(id)));

statement ok
CREATE TABLE gk(id INTEGER PRIMARY KEY, n INTEGER, g INTEGER GENERATED ALWAYS AS (fg(id)));

statement ok
CREATE TABLE gw(id INTEGER);

statement ok
CREATE TABLE glog(id INTEGER);

statement ok
CREATE TRIGGER wi_first AFTER INSERT ON gw FOR EACH STATEMENT INSERT INTO gs SELECT id, 0 FROM gw;

statement ok
CREATE TRIGGER wu_first AFTER DELETE ON gw FOR EACH STATEMENT UPDATE gs SET n = n + 1;

statement ok
CREATE TRIGGER wk_first AFTER INSERT ON gw FOR EACH STATEMENT INSERT INTO gk SELECT id, 0 FROM gw ON CONFLICT DO UPDATE SET n = n + 1;

statement ok
CREATE TRIGGER gs_ins AFTER INSERT ON gs FOR EACH STATEMENT INSERT INTO glog VALUES (1);

statement ok
CREATE TRIGGER gs_upd AFTER UPDATE ON gs FOR EACH STATEMENT INSERT INTO glog VALUES (2);

statement ok
CREATE TRIGGER gk_ins AFTER INSERT ON gk FOR EACH STATEMENT INSERT INTO glog VALUES (3);

statement ok
CREATE TRIGGER wi_second AFTER INSERT ON gw FOR EACH STATEMENT INSERT INTO gs SELECT id, 0 FROM gw;

statement ok
CREATE TRIGGER wu_second AFTER DELETE ON gw FOR EACH STATEMENT UPDATE gs SET n = n + 1;

statement ok
CREATE TRIGGER wk_second AFTER INSERT ON gw FOR EACH STATEMENT INSERT INTO gk SELECT id, 0 FROM gw ON CONFLICT DO UPDATE SET n = n + 1;

query TTT
SELECT trigger_name, string_agg(name, ',' ORDER BY name), string_agg(deptype, ',' ORDER BY name)
FROM (SELECT unnest(['wi_first', 'wi_second', 'wu_first', 'wu_second', 'wk_first', 'wk_second']) AS trigger_name) n,
	LATERAL (FROM trigger_deps(n.trigger_name))
GROUP BY ALL
ORDER BY ALL;
----
wi_first	gs,gw	n,a
wi_second	gs,gw	n,a
wk_first	gk,gw	n,a
wk_second	gk,gw	n,a
wu_first	gs,gw	n,a
wu_second	gs,gw	n,a

statement ok
INSERT INTO gw VALUES (1);

statement ok
DELETE FROM gw;

query III
SELECT id, n, g FROM gs ORDER BY ALL;
----
1	2	7
1	2	7

query II
SELECT id, g FROM gk;
----
1	7

query II
SELECT id, count(*) FROM glog GROUP BY id ORDER BY id;
----
1	2
2	2
3	2

# A body's own RETURNING over a written table with a generated column and statement triggers is refused
statement ok
CREATE TABLE ga(id INTEGER, g INTEGER GENERATED ALWAYS AS (fg(id)));

statement error
CREATE TRIGGER wa_first AFTER INSERT ON gw FOR EACH STATEMENT INSERT INTO ga SELECT id FROM gw RETURNING *;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "wa_first" on table "gw")

statement ok
CREATE TRIGGER ga_ins AFTER INSERT ON ga FOR EACH STATEMENT INSERT INTO glog VALUES (4);

statement error
CREATE TRIGGER wa_second AFTER INSERT ON gw FOR EACH STATEMENT INSERT INTO ga SELECT id FROM gw RETURNING *;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "wa_second" on table "gw")

statement error
CREATE TRIGGER wa_upd AFTER DELETE ON gw FOR EACH STATEMENT UPDATE ga SET id = id + 1 RETURNING g;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "wa_upd" on table "gw")

statement error
CREATE TRIGGER wa_del AFTER DELETE ON gw FOR EACH STATEMENT DELETE FROM ga WHERE id > 100 RETURNING g;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "wa_del" on table "gw")

statement ok
ATTACH ':memory:' AS other;

# Outside triggers RETURNING resolves as before, and a prepared statement rebinds instead of recording
statement ok
CREATE TABLE p(id INTEGER PRIMARY KEY, v INTEGER);

statement ok
CREATE MACRO fp(x) AS x + 1000;

query I
INSERT INTO p VALUES (1, 1) RETURNING fp(v);
----
1001

query I
UPDATE p SET v = 2 RETURNING fp(v);
----
1002

query TI
MERGE INTO p USING (SELECT 2 AS id) src ON p.id = src.id WHEN NOT MATCHED THEN INSERT VALUES (src.id, 3) RETURNING merge_action, fp(v);
----
INSERT	1003

query I
INSERT INTO p VALUES (2, 4) ON CONFLICT DO UPDATE SET v = 4 RETURNING fp(v);
----
1004

query I
DELETE FROM p WHERE id = 2 RETURNING fp(v);
----
1004

statement ok
PREPARE pr AS INSERT INTO p VALUES (5, 5) RETURNING fp(v);

statement ok
DROP MACRO fp;

statement error
EXECUTE pr;
----
Scalar Function with name fp does not exist

statement ok
CREATE MACRO fp(x) AS x + 2000;

query I
EXECUTE pr;
----
2005

# A prepared parameter in a RETURNING list binds like one in the rest of the statement
statement ok
PREPARE pi AS INSERT INTO p VALUES ($1, 0) RETURNING id + $2;

query I
EXECUTE pi(6, 10);
----
16

statement ok
PREPARE pu AS UPDATE p SET v = v + 1 WHERE id = $1 RETURNING v * $2;

query I
EXECUTE pu(6, 7);
----
7

statement ok
PREPARE pd AS DELETE FROM p WHERE id = $1 RETURNING id - $2;

query I
EXECUTE pd(6, 1);
----
5

statement ok
CREATE TRIGGER pt AFTER INSERT ON p FOR EACH STATEMENT INSERT INTO log VALUES (9);

statement ok
PREPARE pti AS INSERT INTO p VALUES ($1, 0) RETURNING id * $2;

query I
EXECUTE pti(7, 3);
----
21

query I
SELECT count(*) FROM log WHERE id = 9;
----
1

# What RETURNING registers with its statement is kept: a sequence of another database is a second written database
statement ok
CREATE SEQUENCE other.oseq;

statement error
INSERT INTO p VALUES (8, 0) RETURNING nextval('other.oseq');
----
a single transaction can only write to a single attached database

query I
SELECT count(*) FROM p WHERE id = 8;
----
0

statement ok
INSERT INTO p VALUES (8, 0);

# A prepared RETURNING reads a variable when executed, and a named parameter takes precedence over a variable
statement ok
SET VARIABLE rv = 1;

statement ok
PREPARE pv AS INSERT INTO p VALUES (9, 0) RETURNING getvariable('rv');

statement ok
SET VARIABLE rv = 2;

query I
EXECUTE pv;
----
2

statement ok
PREPARE pn AS INSERT INTO p VALUES (10, 0) RETURNING $rv;

query I
EXECUTE pn(rv := 9);
----
9

# A trigger body's $name is the user variable, never a parameter of the statement that fires it
statement ok
SET VARIABLE bv = 5;

statement ok
CREATE TABLE bc(id INTEGER);

statement ok
CREATE TABLE br(id INTEGER);

statement ok
CREATE TABLE bl(k VARCHAR, id INTEGER);

statement ok
CREATE TRIGGER b_val AFTER INSERT ON bc FOR EACH STATEMENT INSERT INTO bl VALUES ('val', $bv);

statement ok
CREATE TRIGGER b_sub AFTER INSERT ON bc FOR EACH STATEMENT INSERT INTO bl SELECT 'sub', a FROM (SELECT 10 AS a, $bv AS b);

statement error
CREATE TRIGGER b_ret AFTER INSERT ON bc FOR EACH STATEMENT INSERT INTO bl VALUES ('ret', 20) RETURNING $bv;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "b_ret" on table "bc")

statement ok
CREATE TRIGGER b_row AFTER INSERT ON br FOR EACH ROW INSERT INTO bl VALUES ('row', NEW.id + $bv);

# A prepared firing statement without parameters reads the variable at EXECUTE
statement ok
PREPARE bp AS INSERT INTO bc VALUES (1);

statement ok
SET VARIABLE bv = 6;

statement ok
EXECUTE bp;

# A named parameter of the firing statement does not reach the bodies
statement ok
PREPARE bq AS INSERT INTO bc VALUES ($bv);

statement ok
EXECUTE bq(bv := 7);

statement ok
PREPARE bpr AS INSERT INTO br VALUES ($bv);

statement ok
EXECUTE bpr(bv := 100);

query TI
SELECT k, id FROM bl ORDER BY ALL;
----
row	106
sub	10
sub	10
val	6
val	6

query I
SELECT id FROM bc ORDER BY id;
----
1
7

# The sequence a body names through a variable is the one it depends on, whatever the firing statement passes
statement ok
SET VARIABLE sq = 'bs1';

statement ok
CREATE SEQUENCE bs1;

statement ok
CREATE SEQUENCE bs2;

statement ok
CREATE TABLE bn(v VARCHAR);

statement ok
CREATE TRIGGER b_seq AFTER INSERT ON bn FOR EACH STATEMENT INSERT INTO bl SELECT 'seq', nextval($sq);

query II
FROM trigger_deps('b_seq');
----
bl	n
bn	a
bs1	n

statement ok
PREPARE bnp AS INSERT INTO bn VALUES ($sq);

statement ok
EXECUTE bnp(sq := 'bs2');

query TI
SELECT sequence_name, last_value IS NOT NULL FROM duckdb_sequences() WHERE sequence_name IN ('bs1', 'bs2') ORDER BY ALL;
----
bs1	true
bs2	false

query T
FROM bn;
----
bs2

# Without the variable the firing fails as an unprepared one does
statement ok
RESET VARIABLE bv;

statement error
EXECUTE bp;
----
Values were not provided for the following parameters: bv

statement error
INSERT INTO bc VALUES (3);
----
Values were not provided for the following parameters: bv

query I
SELECT count(*) FROM bc;
----
2

# A row body with RETURNING into a table with a statement trigger is refused at CREATE instead of failing to schedule
statement ok
CREATE TABLE er(id INTEGER);

statement ok
CREATE TABLE etgt(id INTEGER);

statement ok
CREATE TABLE elog(id INTEGER);

statement ok
CREATE TRIGGER est AFTER INSERT ON etgt FOR EACH STATEMENT INSERT INTO elog VALUES (1);

statement error
CREATE TRIGGER err AFTER INSERT ON er FOR EACH ROW INSERT INTO etgt VALUES (NEW.id) RETURNING id * 9;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "err" on table "er")

statement ok
CREATE TRIGGER err AFTER INSERT ON er FOR EACH ROW INSERT INTO etgt VALUES (NEW.id);

statement error
CREATE OR REPLACE TRIGGER err AFTER INSERT ON er FOR EACH ROW INSERT INTO etgt VALUES (NEW.id) RETURNING id * 9;
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "err" on table "er")

statement ok
INSERT INTO er VALUES (1), (2);

query I
SELECT id FROM etgt ORDER BY id;
----
1
2

query I
SELECT DISTINCT id FROM elog;
----
1

# nextval and error() in a RETURNING list, whose evaluation depended on the plan, are refused in both body kinds
statement ok
CREATE SEQUENCE es;

statement ok
CREATE TABLE est_src(id INTEGER);

statement error
CREATE TRIGGER e_seq_row AFTER INSERT ON er FOR EACH ROW INSERT INTO elog VALUES (NEW.id) RETURNING nextval('es');
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "e_seq_row" on table "er")

statement error
CREATE TRIGGER e_err_row AFTER INSERT ON er FOR EACH ROW INSERT INTO elog VALUES (NEW.id) RETURNING error('boom');
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "e_err_row" on table "er")

statement error
CREATE TRIGGER e_seq_st AFTER INSERT ON est_src FOR EACH STATEMENT INSERT INTO elog VALUES (0) RETURNING nextval('es');
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "e_seq_st" on table "est_src")

statement error
CREATE TRIGGER e_seq_before BEFORE INSERT ON est_src FOR EACH STATEMENT UPDATE elog SET id = id RETURNING nextval('es');
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "e_seq_before" on table "est_src")

statement error
CREATE TRIGGER e_err_st AFTER INSERT ON est_src FOR EACH STATEMENT INSERT INTO elog VALUES (0) RETURNING error('boom');
----
Binder Error: RETURNING is not allowed in a trigger body (trigger "e_err_st" on table "est_src")

statement ok
INSERT INTO est_src VALUES (1);

statement ok
INSERT INTO er VALUES (3);

query I
SELECT count(*) FROM duckdb_sequences() WHERE sequence_name = 'es' AND last_value IS NULL;
----
1

query I
SELECT trigger_name FROM duckdb_triggers() WHERE trigger_name LIKE 'e%' ORDER BY ALL;
----
err
est
