# name: test/sql/trigger/trigger_body_search_path.test
# description: A trigger body resolves its names in the trigger's schema, whatever the search path of the session that fires it
# group: [trigger]

require noforcestorage

statement ok
CREATE SCHEMA s;

statement ok
CREATE TABLE main.log(v VARCHAR);

statement ok
CREATE TABLE s.log(v VARCHAR);

# Statement triggers created under the search path s, fired from the default path and from s
statement ok
CREATE TABLE s.t1(id INTEGER);

statement ok
SET search_path = 's';

statement ok
CREATE TRIGGER t1_after AFTER INSERT ON t1 FOR EACH STATEMENT INSERT INTO log VALUES ('t1 after');

statement ok
CREATE TRIGGER t1_before BEFORE INSERT ON t1 FOR EACH STATEMENT INSERT INTO log VALUES ('t1 before');

statement ok
RESET search_path;

statement ok
INSERT INTO s.t1 VALUES (1);

statement ok
SET search_path = 's';

statement ok
INSERT INTO t1 VALUES (2);

statement ok
RESET search_path;

query T
SELECT v FROM s.log ORDER BY v;
----
t1 after
t1 after
t1 before
t1 before

query I
SELECT count(*) FROM main.log;
----
0

# The written table exists only in s
statement ok
CREATE TABLE s.only_s(v VARCHAR);

statement ok
CREATE TABLE s.t2(id INTEGER);

statement ok
SET search_path = 's';

statement ok
CREATE TRIGGER t2_after AFTER INSERT ON t2 FOR EACH STATEMENT INSERT INTO only_s VALUES ('t2 after');

statement ok
RESET search_path;

statement ok
INSERT INTO s.t2 VALUES (1);

query T
SELECT v FROM s.only_s;
----
t2 after

# Row triggers created under the search path s, INSERT with NEW and DELETE with OLD
statement ok
DELETE FROM s.log;

statement ok
CREATE TABLE s.r1(id INTEGER);

statement ok
SET search_path = 's';

statement ok
CREATE TRIGGER r1_insert AFTER INSERT ON r1 FOR EACH ROW INSERT INTO log VALUES ('r1 insert ' || NEW.id);

statement ok
CREATE TRIGGER r1_delete AFTER DELETE ON r1 FOR EACH ROW INSERT INTO log VALUES ('r1 delete ' || OLD.id);

statement ok
RESET search_path;

statement ok
INSERT INTO s.r1 VALUES (1), (2);

statement ok
DELETE FROM s.r1 WHERE id = 1;

query T
SELECT v FROM s.log ORDER BY v;
----
r1 delete 1
r1 insert 1
r1 insert 2

query I
SELECT count(*) FROM main.log;
----
0

# A view, a scalar macro, a table macro and a sequence by bare name, each present in both schemas
statement ok
DELETE FROM s.log;

statement ok
CREATE TABLE main.src(v VARCHAR);

statement ok
INSERT INTO main.src VALUES ('main.src');

statement ok
CREATE TABLE s.src(v VARCHAR);

statement ok
INSERT INTO s.src VALUES ('s.src');

statement ok
CREATE VIEW main.vw AS SELECT 'main.vw' AS v;

statement ok
CREATE VIEW s.vw AS SELECT 's.vw' AS v;

statement ok
CREATE MACRO main.mac() AS 'main.mac';

statement ok
CREATE MACRO s.mac() AS 's.mac';

statement ok
CREATE MACRO main.tmac() AS TABLE SELECT 'main.tmac' AS v;

statement ok
CREATE MACRO s.tmac() AS TABLE SELECT 's.tmac' AS v;

statement ok
CREATE SEQUENCE main.seq START 100;

statement ok
CREATE SEQUENCE s.seq START 1;

statement ok
CREATE TABLE s.t3(id INTEGER);

statement ok
CREATE TABLE s.r3(id INTEGER);

statement ok
SET search_path = 's';

statement ok
CREATE TRIGGER t3_names AFTER INSERT ON t3 FOR EACH STATEMENT
INSERT INTO log
SELECT v FROM src
UNION ALL SELECT v FROM vw
UNION ALL SELECT mac()
UNION ALL SELECT v FROM tmac()
UNION ALL SELECT 'seq ' || nextval('seq');

statement ok
CREATE TRIGGER r3_names AFTER INSERT ON r3 FOR EACH ROW
INSERT INTO log SELECT vw.v || ' ' || mac() || ' ' || NEW.id FROM vw;

statement ok
RESET search_path;

statement ok
INSERT INTO s.t3 VALUES (1);

statement ok
INSERT INTO s.r3 VALUES (7);

query T
SELECT v FROM s.log ORDER BY v;
----
s.mac
s.src
s.tmac
s.vw
s.vw s.mac 7
seq 1

query I
SELECT count(*) FROM main.log;
----
0

query I
SELECT nextval('main.seq');
----
100

# The firing statement's own parts keep the session's search path
statement ok
DELETE FROM s.log;

statement ok
INSERT INTO s.t1 SELECT 10 FROM src WHERE v = 'main.src';

query T
INSERT INTO s.t1 VALUES (11) RETURNING mac();
----
main.mac

query IT
WITH c AS (SELECT v FROM src) INSERT INTO s.t1 SELECT 12 FROM c WHERE v = 'main.src' RETURNING id, mac();
----
12	main.mac

statement ok
INSERT INTO s.r1 SELECT 13 FROM src WHERE v = 'main.src';

query I
SELECT id FROM s.t1 WHERE id >= 10 ORDER BY id;
----
10
11
12

query T
SELECT v FROM s.log WHERE v LIKE 'r1%' ORDER BY v;
----
r1 insert 13

query I
SELECT count(*) FROM s.log WHERE v = 't1 after';
----
3

query I
SELECT count(*) FROM main.log;
----
0

query T
SELECT v FROM src;
----
main.src

