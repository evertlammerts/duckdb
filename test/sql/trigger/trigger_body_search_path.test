# Transition tables, and the OLD image recomputing a generated column
statement ok
DELETE FROM s.log;

statement ok
SET search_path = 's';

statement ok
CREATE TABLE t10(id INTEGER, g INTEGER GENERATED ALWAYS AS (id * 10));

statement ok
CREATE TRIGGER t10_update AFTER UPDATE ON t10 REFERENCING OLD TABLE AS o NEW TABLE AS n FOR EACH STATEMENT
INSERT INTO log SELECT 'old ' || o.g || ' new ' || n.g FROM o, n;

statement ok
RESET search_path;

statement ok
INSERT INTO s.t10 VALUES (1);

statement ok
UPDATE s.t10 SET id = 2;

query T
SELECT v FROM s.log;
----
old 10 new 20

query I
SELECT count(*) FROM main.log WHERE v LIKE 'old%';
----
0

