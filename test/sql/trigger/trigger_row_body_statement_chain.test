query TI
SELECT * FROM out ORDER BY ALL
----
after	2

statement ok
DROP TRIGGER s3 ON s

# Volatile AFTER statement bodies, one reading the transition table and one not, fire once

statement ok
CREATE SEQUENCE seq

statement ok
CREATE TRIGGER s6 AFTER INSERT ON s REFERENCING NEW TABLE AS n FOR EACH STATEMENT INSERT INTO out SELECT 'seq' || nextval('seq'), id FROM n

statement ok
CREATE TRIGGER s7 AFTER INSERT ON s FOR EACH STATEMENT INSERT INTO out SELECT 'rnd', (random() * 0)::INTEGER

statement ok
DELETE FROM out

statement ok
DELETE FROM s

statement ok
DELETE FROM r

statement ok
INSERT INTO r VALUES (1), (2)

query TI
SELECT * FROM out WHERE k = 'rnd'
----
rnd	0

query IIII
SELECT count(*), count(DISTINCT k), min(k), max(k) FROM out WHERE k LIKE 'seq%'
----
2	2	seq1	seq2

query I
SELECT v FROM out WHERE k LIKE 'seq%' ORDER BY ALL
----
101
102

statement ok
DROP TRIGGER s6 ON s

statement ok
DROP TRIGGER s7 ON s

