# name: test/sql/trigger/trigger_row_body_statement_chain.test
# description: The statement triggers fired by the writes of FOR EACH ROW bodies fire once per firing statement, over every row those bodies wrote, each once
# group: [trigger]

require noforcestorage

statement ok
CREATE TABLE out(k VARCHAR, v INTEGER)

statement ok
CREATE TABLE s(id INTEGER)

statement ok
CREATE TABLE r(id INTEGER)

# An AFTER statement trigger reading its transition table, fired by the write of a row body

statement ok
CREATE TRIGGER s1 AFTER INSERT ON s REFERENCING NEW TABLE AS n FOR EACH STATEMENT INSERT INTO out SELECT 'st', id FROM n

statement ok
CREATE TRIGGER r1 AFTER INSERT ON r FOR EACH ROW INSERT INTO s SELECT NEW.id + 100

statement ok
INSERT INTO r VALUES (1), (2)

query TI
SELECT * FROM out ORDER BY ALL
----
st	101
st	102

query I
SELECT id FROM s ORDER BY ALL
----
101
102

# No write's returned rows reach a cross product with the firing rows, through projections or filters alone, in the
# plan the flattener leaves

statement ok
SET explain_output='optimized_only'

statement ok
PRAGMA disable_optimizer

query II
EXPLAIN (FORMAT JSON) INSERT INTO r VALUES (1), (2)
----
logical_opt	<!REGEX>:.*"name": "CROSS_PRODUCT",\s*"children": \[\s*(\{\s*"name": "(PROJECTION|FILTER)",\s*"children": \[\s*)*\{\s*"name": "(INSERT|DELETE|UPDATE|MERGE_INTO)".*

statement ok
PRAGMA enable_optimizer

statement ok
RESET explain_output

# One firing row, then several, with duplicates and NULL

statement ok
DELETE FROM out

statement ok
DELETE FROM s

statement ok
INSERT INTO r VALUES (3)

statement ok
INSERT INTO r VALUES (4), (4), (NULL)

query TI
SELECT * FROM out ORDER BY ALL
----
st	103
st	104
st	104
st	NULL

query I
SELECT id FROM s ORDER BY ALL
----
103
104
104
NULL

# The statement trigger fires once for the firing statement and counts every row the bodies wrote

statement ok
CREATE TRIGGER s2 AFTER INSERT ON s REFERENCING NEW TABLE AS n FOR EACH STATEMENT INSERT INTO out SELECT 'cnt', count(*) FROM n

statement ok
DELETE FROM out

statement ok
DELETE FROM s

statement ok
DELETE FROM r

statement ok
INSERT INTO r VALUES (1), (2), (3)

query TI
SELECT * FROM out ORDER BY ALL
----
cnt	3
st	101
st	102
st	103

statement ok
DROP TRIGGER s2 ON s

# A body reading its transition table twice pairs the rows of one firing statement, and two firing statements in one transaction fire twice, each over its own rows

statement ok
CREATE TRIGGER s2 AFTER INSERT ON s REFERENCING NEW TABLE AS n FOR EACH STATEMENT INSERT INTO out SELECT 'pair', a.id * 1000 + b.id FROM n a, n b WHERE a.id < b.id

statement ok
DELETE FROM out

statement ok
DELETE FROM s

statement ok
DELETE FROM r

statement ok
BEGIN

statement ok
INSERT INTO r VALUES (1), (2)

statement ok
INSERT INTO r VALUES (3), (4), (5)

statement ok
COMMIT

query TI
SELECT * FROM out ORDER BY ALL
----
pair	101102
pair	103104
pair	103105
pair	104105
st	101
st	102
st	103
st	104
st	105

statement ok
DROP TRIGGER s2 ON s

# A body writing several rows per firing row

statement ok
DROP TRIGGER r1 ON r

statement ok
DELETE FROM out

statement ok
DELETE FROM s

statement ok
DELETE FROM r

statement ok
CREATE TRIGGER r1 AFTER INSERT ON r FOR EACH ROW INSERT INTO s SELECT NEW.id * 10 + range FROM range(2)

statement ok
INSERT INTO r VALUES (1), (2)

query TI
SELECT * FROM out ORDER BY ALL
----
st	10
st	11
st	20
st	21

# A row body with its own WITH clause

statement ok
DROP TRIGGER r1 ON r

statement ok
DELETE FROM out

statement ok
DELETE FROM s

statement ok
DELETE FROM r

statement ok
CREATE TRIGGER r1 AFTER INSERT ON r FOR EACH ROW WITH x AS (SELECT NEW.id + 400 AS v) INSERT INTO s SELECT v FROM x

statement ok
INSERT INTO r VALUES (1), (2)

query TI
SELECT * FROM out ORDER BY ALL
----
st	401
st	402

query I
SELECT id FROM s ORDER BY ALL
----
401
402

statement ok
SET explain_output='optimized_only'

statement ok
PRAGMA disable_optimizer

query II
EXPLAIN (FORMAT JSON) INSERT INTO r VALUES (1), (2)
----
logical_opt	<!REGEX>:.*"name": "CROSS_PRODUCT",\s*"children": \[\s*(\{\s*"name": "(PROJECTION|FILTER)",\s*"children": \[\s*)*\{\s*"name": "(INSERT|DELETE|UPDATE|MERGE_INTO)".*

statement ok
PRAGMA enable_optimizer

statement ok
RESET explain_output

# BEFORE statement triggers on the written table fire once and see the table before the bodies write, volatile ones too

statement ok
DROP TRIGGER r1 ON r

statement ok
DELETE FROM out

statement ok
DELETE FROM s

statement ok
DELETE FROM r

statement ok
CREATE TRIGGER r1 AFTER INSERT ON r FOR EACH ROW INSERT INTO s SELECT NEW.id + 100

statement ok
CREATE SEQUENCE bseq

statement ok
CREATE TRIGGER b0 BEFORE INSERT ON s FOR EACH STATEMENT INSERT INTO out SELECT 'before', count(*) FROM s

statement ok
CREATE TRIGGER b1 BEFORE INSERT ON s FOR EACH STATEMENT INSERT INTO out SELECT 'rnd', (random() * 0)::INTEGER

statement ok
CREATE TRIGGER b2 BEFORE INSERT ON s FOR EACH STATEMENT INSERT INTO out SELECT 'bseq', nextval('bseq')

statement ok
CREATE SEQUENCE bcteseq

statement ok
CREATE TRIGGER b3 BEFORE INSERT ON s FOR EACH STATEMENT WITH x AS MATERIALIZED (SELECT nextval('bcteseq') AS v) INSERT INTO out SELECT 'bcte', v FROM x

statement ok
INSERT INTO r VALUES (1), (2)

query TI
SELECT * FROM out ORDER BY ALL
----
bcte	1
before	0
bseq	1
rnd	0
st	101
st	102

query I
SELECT id FROM s ORDER BY ALL
----
101
102

statement ok
DROP TRIGGER b0 ON s

statement ok
DROP TRIGGER b1 ON s

statement ok
DROP TRIGGER b2 ON s

statement ok
DROP TRIGGER b3 ON s

