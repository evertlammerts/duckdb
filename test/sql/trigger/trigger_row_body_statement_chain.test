statement ok
DELETE FROM out

statement ok
DELETE FROM s

statement ok
DELETE FROM r

statement ok
INSERT INTO r VALUES (1), (2), (3)

statement ok
CREATE TRIGGER r3 AFTER DELETE ON r FOR EACH ROW INSERT INTO s SELECT OLD.id + 100

statement ok
DELETE FROM out

statement ok
DELETE FROM s

statement ok
DELETE FROM r WHERE id <= 2

