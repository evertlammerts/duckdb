102

# A DELETE row body into a table whose statement trigger reads OLD TABLE: each deleted row once, also when several firing rows delete the same row

statement ok
DROP TRIGGER r3 ON r

statement ok
DROP TRIGGER s1 ON s

statement ok
DELETE FROM out

statement ok
DELETE FROM r

statement ok
DELETE FROM s

statement ok
INSERT INTO s VALUES (101), (102), (103)

statement ok
CREATE TRIGGER s4 AFTER DELETE ON s REFERENCING OLD TABLE AS o FOR EACH STATEMENT INSERT INTO out SELECT 'del', id FROM o

statement ok
CREATE TRIGGER s9 AFTER DELETE ON s REFERENCING OLD TABLE AS o FOR EACH STATEMENT INSERT INTO out SELECT 'delcnt', count(*) FROM o

statement ok
CREATE TRIGGER r4 AFTER INSERT ON r FOR EACH ROW DELETE FROM s WHERE id = NEW.id + 100

statement ok
INSERT INTO r VALUES (1), (2), (2)

query TI
SELECT * FROM out ORDER BY ALL
----
del	101
del	102
delcnt	2

query I
SELECT id FROM s ORDER BY ALL
----
103

statement ok
DROP TRIGGER r4 ON r

statement ok
DROP TRIGGER s9 ON s

# UPDATE row bodies and UPDATE FOR EACH ROW triggers are refused, so no UPDATE write runs over the rows of a row trigger

statement ok
CREATE TRIGGER su AFTER UPDATE ON s REFERENCING NEW TABLE AS n FOR EACH STATEMENT INSERT INTO out SELECT 'upd', id FROM n

statement error
CREATE TRIGGER r7 AFTER INSERT ON r FOR EACH ROW UPDATE s SET id = id + 1000 WHERE id = NEW.id + 100
----
UPDATE trigger bodies in FOR EACH ROW triggers are not yet supported

statement error
CREATE TRIGGER r8 AFTER UPDATE ON r FOR EACH ROW INSERT INTO s SELECT NEW.id + 100
----
UPDATE FOR EACH ROW triggers are not yet supported

statement ok
DROP TRIGGER su ON s

# A row body writing a table with its own FOR EACH ROW trigger is still refused

statement ok
DROP TRIGGER s4 ON s

statement ok
CREATE TRIGGER s5 AFTER INSERT ON s FOR EACH ROW INSERT INTO out SELECT 'srow', NEW.id

statement error
CREATE TRIGGER r5 AFTER INSERT ON r FOR EACH ROW INSERT INTO s SELECT NEW.id + 100
----
cascading row triggers are not yet supported

