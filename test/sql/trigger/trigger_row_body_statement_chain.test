# A volatile generated column in the written table: the transition table holds each written row once, as when the
# same table is written in plain SQL

statement ok
CREATE TABLE gaudit(k VARCHAR, n BIGINT)

statement ok
CREATE TABLE gr(id INTEGER)

statement ok
CREATE TABLE gs(id INTEGER, stamp DOUBLE GENERATED ALWAYS AS (random()))

statement ok
CREATE TRIGGER gs_count AFTER INSERT ON gs REFERENCING NEW TABLE AS nt FOR EACH STATEMENT INSERT INTO gaudit SELECT 'cnt', count(*) FROM nt

statement ok
CREATE TRIGGER gs_ids AFTER INSERT ON gs REFERENCING NEW TABLE AS nt FOR EACH STATEMENT INSERT INTO gaudit SELECT 'id', id FROM nt

statement ok
CREATE TRIGGER gr_row AFTER INSERT ON gr FOR EACH ROW INSERT INTO gs VALUES (NEW.id)

statement ok
INSERT INTO gr VALUES (1), (2)

query TI
SELECT * FROM gaudit ORDER BY ALL
----
cnt	2
id	1
id	2

statement ok
DELETE FROM gaudit

statement ok
INSERT INTO gs VALUES (8), (9)

query TI
SELECT * FROM gaudit ORDER BY ALL
----
cnt	2
id	8
id	9

statement ok
CREATE TABLE gu(id INTEGER, u UUID GENERATED ALWAYS AS (gen_random_uuid()))

statement ok
CREATE TRIGGER gu_count AFTER INSERT ON gu REFERENCING NEW TABLE AS nt FOR EACH STATEMENT INSERT INTO gaudit SELECT 'ucnt', count(*) FROM nt

statement ok
CREATE TRIGGER gr_row_u AFTER INSERT ON gr FOR EACH ROW INSERT INTO gu VALUES (NEW.id)

statement ok
DELETE FROM gaudit

statement ok
INSERT INTO gr VALUES (1), (2), (3)

query TI
SELECT * FROM gaudit WHERE k = 'ucnt'
----
ucnt	3

query I
SELECT count(DISTINCT u) FROM gu
----
3
