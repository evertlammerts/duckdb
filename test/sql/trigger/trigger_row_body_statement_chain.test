# UPDATE row bodies and UPDATE FOR EACH ROW triggers are refused, so no UPDATE write runs over the rows of a row trigger

statement ok
CREATE TRIGGER su AFTER UPDATE ON s REFERENCING NEW TABLE AS n FOR EACH STATEMENT INSERT INTO out SELECT 'upd', id FROM n

statement error
CREATE TRIGGER r7 AFTER INSERT ON r FOR EACH ROW UPDATE s SET id = id + 1000 WHERE id = NEW.id + 100
----
UPDATE trigger bodies in FOR EACH ROW triggers are not yet supported

statement error
CREATE TRIGGER r8 AFTER UPDATE ON r FOR EACH ROW INSERT INTO s SELECT NEW.id + 100
----
UPDATE FOR EACH ROW triggers are not yet supported

statement ok
DROP TRIGGER su ON s

# A row body writing a table with its own FOR EACH ROW trigger is still refused

statement ok
DROP TRIGGER s4 ON s

statement ok
CREATE TRIGGER s5 AFTER INSERT ON s FOR EACH ROW INSERT INTO out SELECT 'srow', NEW.id

statement error
CREATE TRIGGER r5 AFTER INSERT ON r FOR EACH ROW INSERT INTO s SELECT NEW.id + 100
----
cascading row triggers are not yet supported

