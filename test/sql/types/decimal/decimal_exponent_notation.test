# the value of each id in each type, from an exact decimal reference rounding half away from zero
statement ok
CREATE TABLE expected(id INTEGER, "DECIMAL(2,1)" VARCHAR, "DECIMAL(3,0)" VARCHAR, "DECIMAL(4,0)" VARCHAR, "DECIMAL(4,1)" VARCHAR, "DECIMAL(4,2)" VARCHAR, "DECIMAL(4,4)" VARCHAR, "DECIMAL(7,7)" VARCHAR, "DECIMAL(8,7)" VARCHAR, "DECIMAL(9,9)" VARCHAR, "DECIMAL(18,3)" VARCHAR, "DECIMAL(18,18)" VARCHAR, "DECIMAL(20,20)" VARCHAR, "DECIMAL(38,0)" VARCHAR, "DECIMAL(38,20)" VARCHAR, "DECIMAL(38,37)" VARCHAR, "DECIMAL(38,38)" VARCHAR);

