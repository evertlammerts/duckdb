# name: test/sql/types/decimal/decimal_exponent_notation.test
# description: Casting VARCHAR to DECIMAL gives the same result for every notation of a value
# group: [decimal]

# a scale equal to the width leaves no digit before the point, whatever the notation
query IIIIIIIIIIII
SELECT '1E-7'::DECIMAL(7,7)::VARCHAR, '1e-7'::DECIMAL(7,7)::VARCHAR, '1E-07'::DECIMAL(7,7)::VARCHAR,
	'10E-8'::DECIMAL(7,7)::VARCHAR, '100E-9'::DECIMAL(7,7)::VARCHAR, '0001E-7'::DECIMAL(7,7)::VARCHAR,
	'1.0E-7'::DECIMAL(7,7)::VARCHAR, '0.1E-6'::DECIMAL(7,7)::VARCHAR, '+1E-7'::DECIMAL(7,7)::VARCHAR,
	' 1E-7 '::DECIMAL(7,7)::VARCHAR, '1_0E-8'::DECIMAL(7,7)::VARCHAR, '0.0000001'::DECIMAL(7,7)::VARCHAR
----
.0000001	.0000001	.0000001	.0000001	.0000001	.0000001	.0000001	.0000001	.0000001	.0000001	.0000001	.0000001

query IIIII
SELECT '-1E-7'::DECIMAL(7,7)::VARCHAR, '-10E-8'::DECIMAL(7,7)::VARCHAR, '-.1E-6'::DECIMAL(7,7)::VARCHAR,
	'-0.0000001'::DECIMAL(7,7)::VARCHAR, '1E-7'::DECIMAL(8,7)::VARCHAR
----
-.0000001	-.0000001	-.0000001	-.0000001	0.0000001

# each id is one value written in several notations
statement ok
CREATE TABLE notations(id INTEGER, txt VARCHAR);

statement ok
INSERT INTO notations VALUES
	(1, '0.0000001'), (1, '.0000001'), (1, '1E-7'), (1, '1e-7'), (1, '10E-8'), (1, '100E-9'), (1, '0.1E-6'),
	(1, '0001E-7'), (1, '+1E-7'), (1, ' 1E-7 '), (1, '1_0E-8'),
	(2, '-0.0000001'), (2, '-1E-7'), (2, '-10E-8'), (2, '-.1E-6'),
	(3, '1.5'), (3, '15E-1'), (3, '0.15E1'), (3, '150E-2'), (3, '1.5E0'), (3, '.015E2'),
	(4, '1500'), (4, '1.5E3'), (4, '15E2'), (4, '0.0015E6'), (4, '150000E-2'),
	(5, '100'), (5, '1E2'), (5, '0.1E3'), (5, '10000E-2'), (5, '1.00E2'),
	(6, '0.12345'), (6, '12345E-5'), (6, '1.2345E-1'), (6, '0.0012345E2'),
	(7, '0.00000015'), (7, '1.5E-7'), (7, '15E-8'), (7, '0.15E-6'),
	(8, '-0.00000015'), (8, '-1.5E-7'), (8, '-15E-8'),
	(9, '0.99999995'), (9, '9.9999995E-1'), (9, '99999995E-8'),
	(10, '0.99999994'), (10, '9.9999994E-1'), (10, '99999994E-8'),
	(11, '1'), (11, '1E0'), (11, '1.0'), (11, '10E-1'), (11, '0.1E1'),
	(12, '0'), (12, '-0'), (12, '0E5'), (12, '-0E-7'), (12, '0.000'), (12, '-0.0E3'), (12, '00000E10'),
	(12, '0E32767'), (12, '0E-32768'),
	(13, '12.345'), (13, '123.45E-1'), (13, '12345E-3'), (13, '0.012345E3'),
	(14, '1.23456789'), (14, '123456789E-8'), (14, '0.000123456789E4'),
	(15, '0.1'), (15, '0.000001E5'), (15, '0.00000000000000000000000000000000000000001E40'),
	(16, '10'), (16, '0.01E3'),
	(17, '1234.5'), (17, '1.2345E3'), (17, '12345E-1'),
	(18, '-1234.5'), (18, '-1.2345E3'), (18, '-12345E-1'),
	(19, '0.99995'), (19, '99995E-5'), (19, '9.9995E-1'),
	(20, '9999.5'), (20, '9.9995E3'), (20, '99995E-1'),
	(21, '0.9999999995'), (21, '9999999995E-10'),
	(22, '0.9999999999999999995'), (22, '9999999999999999995E-19'),
	(23, '0.99999999999999999999999999999999999999'), (23, '99999999999999999999999999999999999999E-38'),
	(23, '9.9999999999999999999999999999999999999E-1'),
	(24, '0.999999999999999999999999999999999999999'), (24, '999999999999999999999999999999999999999E-39'),
	(25, '99999999999999999999999999999999999999'), (25, '9.9999999999999999999999999999999999999E37'),
	(25, '0.99999999999999999999999999999999999999E38'),
	(26, '100000000000000000000000000000000000000'), (26, '1E38'),
	(27, '0.00000000000000000000000000000000000001'), (27, '1E-38'),
	(28, '0.000000000000000000000000000000000000005'), (28, '5E-39'),
	(29, '0.000000000000000000000000000000000000004'), (29, '4E-39'),
	(30, '1'), (30, '100000000000000000000000000000000000000000000000000E-50'),
	(31, '0'), (31, '1E-32768'), (31, '-1E-32768');

foreach type DECIMAL(2,1) DECIMAL(3,0) DECIMAL(4,0) DECIMAL(4,1) DECIMAL(4,2) DECIMAL(4,4) DECIMAL(7,7) DECIMAL(8,7) DECIMAL(9,9) DECIMAL(18,3) DECIMAL(18,18) DECIMAL(38,0) DECIMAL(38,20) DECIMAL(38,37) DECIMAL(38,38)

query II
SELECT id, list(DISTINCT coalesce(TRY_CAST(txt AS {type})::VARCHAR, 'NULL') ORDER BY 1)
FROM notations
GROUP BY id
HAVING count(DISTINCT coalesce(TRY_CAST(txt AS {type})::VARCHAR, 'NULL')) > 1
ORDER BY id
----

endloop

# digits that an exponent moves across the point, in both directions
query IIIIIIII
SELECT '1.5E3'::DECIMAL(4,0), TRY_CAST('1.5E3' AS DECIMAL(3,0)), TRY_CAST('1.5E3' AS DECIMAL(4,1)),
	'15E-1'::DECIMAL(2,1), '15E-1'::DECIMAL(3,0), '1E2'::DECIMAL(3,0), '1E2'::DECIMAL(4,1), TRY_CAST('1E2' AS DECIMAL(3,1))
----
1500	NULL	NULL	1.5	2	100	100.0	NULL

# rounding half away from zero at the scale, as for fixed point text
query IIIIII
SELECT '1.5E-7'::DECIMAL(7,7)::VARCHAR, '-1.5E-7'::DECIMAL(7,7)::VARCHAR, '1.25E-7'::DECIMAL(8,8)::VARCHAR,
	'1.2345E-1'::DECIMAL(4,4)::VARCHAR, '1.2345E3'::DECIMAL(4,0)::VARCHAR, '-1.2345E3'::DECIMAL(4,0)::VARCHAR
----
.0000002	-.0000002	.00000013	.1235	1235	-1235

# digits beyond the storage type's digit count still round the result
query IIIIII
SELECT '123.45E-1'::DECIMAL(4,2), '123456789E-8'::DECIMAL(4,1), '9.9994E3'::DECIMAL(4,0),
	TRY_CAST('9.9995E3' AS DECIMAL(4,0)), TRY_CAST('99995E-5' AS DECIMAL(4,4)), '99995E-5'::DECIMAL(5,4)
----
12.35	1.2	9999	NULL	NULL	1.0000

# leading zeros after the point do not use up the digits of the storage type
query III
SELECT '0.000001E5'::DECIMAL(4,1), '0.01e3'::DECIMAL(4,2), '0.00000000000000000000000000000000000000001E40'::DECIMAL(4,1)
----
0.1	10.00	0.1

# rounding up to the width overflows, for every notation
query IIIIII
SELECT TRY_CAST('9.9999995E-1' AS DECIMAL(7,7)), TRY_CAST('0.99999995' AS DECIMAL(7,7)),
	'9.9999994E-1'::DECIMAL(7,7)::VARCHAR, TRY_CAST('1E0' AS DECIMAL(7,7)), TRY_CAST('1' AS DECIMAL(7,7)),
	'9.9999995E-1'::DECIMAL(8,7)
----
NULL	NULL	.9999999	NULL	NULL	1.0000000

# negative zero
query IIII
SELECT '-0E-7'::DECIMAL(7,7)::VARCHAR, '-0.00000004'::DECIMAL(7,7)::VARCHAR, '-4E-8'::DECIMAL(7,7)::VARCHAR,
	'-0.0E3'::DECIMAL(3,0)
----
.0000000	.0000000	.0000000	0

# the widest types
query IIIII
SELECT '1E-38'::DECIMAL(38,38)::VARCHAR, '5E-39'::DECIMAL(38,38)::VARCHAR, '4E-39'::DECIMAL(38,38)::VARCHAR,
	'99999999999999999999999999999999999999E-38'::DECIMAL(38,38)::VARCHAR,
	TRY_CAST('999999999999999999999999999999999999999E-39' AS DECIMAL(38,38))
----
.00000000000000000000000000000000000001	.00000000000000000000000000000000000001	.00000000000000000000000000000000000000	.99999999999999999999999999999999999999	NULL

query IIIII
SELECT '9.9999999999999999999999999999999999999E37'::DECIMAL(38,0), '1E37'::DECIMAL(38,0),
	TRY_CAST('1E38' AS DECIMAL(38,0)), '999999999999999999999999999999999999999E-39'::DECIMAL(38,0),
	'99999999999999999999999999999999999999E-38'::DECIMAL(38,20)
----
99999999999999999999999999999999999999	10000000000000000000000000000000000000	NULL	1	1.00000000000000000000

query III
SELECT TRY_CAST('-99999999999999999999999999999999999999.5' AS DECIMAL(38,0)),
	'-12345678901234567890123456789012345678.5'::DECIMAL(38,0),
	'-1.23456789012345678901234567890123456785E-1'::DECIMAL(38,38)::VARCHAR
----
NULL	-12345678901234567890123456789012345679	-.12345678901234567890123456789012345679

query II
SELECT '100000000000000000000000000000000000000000000000000E-50'::DECIMAL(2,1), '1E-32768'::DECIMAL(38,38)::VARCHAR
----
1.0	.00000000000000000000000000000000000000

# the first digit beyond the storage type's digit count rounds at the full width of every storage type
query IIII
SELECT '9999999994E-1'::DECIMAL(9,0), TRY_CAST('9999999995E-1' AS DECIMAL(9,0)),
	'-9999999999999999994E-1'::DECIMAL(18,0), TRY_CAST('-9999999999999999995E-1' AS DECIMAL(18,0))
----
999999999	NULL	-999999999999999999	NULL

# every significant digit removed by the scale
query IIII
SELECT '4E-5'::DECIMAL(4,4)::VARCHAR, '5E-5'::DECIMAL(4,4)::VARCHAR, '-4E-19'::DECIMAL(18,18)::VARCHAR,
	'5E-19'::DECIMAL(18,18)::VARCHAR
----
.0000	.0001	.000000000000000000	.000000000000000001

# leading zeros after the point do not hide an overflow
query II
SELECT TRY_CAST('0.00000000000000000000000000000000000000000000000001234567890123456789012345678901234567890123456789E50' AS DECIMAL(38,38)),
	'0.00000000000000000000000000000000000000000000000001234567890123456789012345678901234567890123456789E50'::DECIMAL(38,0)
----
NULL	1

# CAST raises where TRY_CAST gives NULL
statement error
SELECT '1E0'::DECIMAL(7,7)
----
Could not convert string "1E0" to DECIMAL(7,7)

statement error
SELECT '9.9999995E-1'::DECIMAL(7,7)
----
Could not convert string "9.9999995E-1" to DECIMAL(7,7)

statement error
SELECT '-9.9999995E-1'::DECIMAL(7,7)
----
Could not convert string "-9.9999995E-1" to DECIMAL(7,7)

statement error
SELECT '9.9995E3'::DECIMAL(4,0)
----
Could not convert string "9.9995E3" to DECIMAL(4,0)

statement error
SELECT '1E32767'::DECIMAL(38,0)
----
Could not convert string "1E32767" to DECIMAL(38,0)

# read_csv reads exponent text into a declared DECIMAL column like the cast
statement ok
COPY (SELECT * FROM (VALUES ('1E-7', 1), ('0.0000001', 2), ('10E-8', 3), ('-1.5E-7', 4), ('9.9999994E-1', 5)) t(a, b))
TO '{TEST_DIR}/decimal_exponent_notation.csv' (HEADER);

query II
SELECT a, b FROM read_csv('{TEST_DIR}/decimal_exponent_notation.csv', columns = {'a': 'DECIMAL(7,7)', 'b': 'INTEGER'}, header = true)
ORDER BY b
----
.0000001	1
.0000001	2
.0000001	3
-.0000002	4
.9999999	5

query II
SELECT a, b FROM read_csv('{TEST_DIR}/decimal_exponent_notation.csv', types = {'a': 'DECIMAL(7,7)'})
ORDER BY b
----
.0000001	1
.0000001	2
.0000001	3
-.0000002	4
.9999999	5

statement ok
COPY (SELECT * FROM (VALUES ('1E-7', 1), ('0,0000001', 2), ('-1,5E-7', 3)) t(a, b))
TO '{TEST_DIR}/decimal_exponent_notation_comma.csv' (HEADER, DELIMITER ';');

query II
SELECT a, b FROM read_csv('{TEST_DIR}/decimal_exponent_notation_comma.csv', columns = {'a': 'DECIMAL(7,7)', 'b': 'INTEGER'}, header = true, delim = ';', decimal_separator = ',')
ORDER BY b
----
.0000001	1
.0000001	2
-.0000002	3

# the sniffer tests a DECIMAL candidate with the same cast
query II
SELECT typeof(a), a FROM read_csv('{TEST_DIR}/decimal_exponent_notation.csv', auto_type_candidates = ['DECIMAL(7,7)', 'VARCHAR'])
ORDER BY b
----
DECIMAL(7,7)	.0000001
DECIMAL(7,7)	.0000001
DECIMAL(7,7)	.0000001
DECIMAL(7,7)	-.0000002
DECIMAL(7,7)	.9999999

query II
SELECT typeof(a), a FROM read_csv('{TEST_DIR}/decimal_exponent_notation_comma.csv', auto_type_candidates = ['DECIMAL(7,7)', 'VARCHAR'], delim = ';', decimal_separator = ',')
ORDER BY b
----
DECIMAL(7,7)	.0000001
DECIMAL(7,7)	.0000001
DECIMAL(7,7)	-.0000002
