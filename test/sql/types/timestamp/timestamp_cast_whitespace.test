# name: test/sql/types/timestamp/timestamp_cast_whitespace.test
# description: The TIMESTAMP casts accept the whitespace around a date or a time that the DATE and TIME casts accept
# group: [timestamp]

query II
SELECT CAST('2024-01-01 ' AS DATE), CAST('2024-01-01 ' AS TIMESTAMP)
----
2024-01-01	2024-01-01 00:00:00

query I
SELECT TIMESTAMP '2024-01-01 '
----
2024-01-01 00:00:00

statement ok
CREATE TABLE ts(t TIMESTAMP)

statement ok
INSERT INTO ts VALUES ('2024-01-01 '), ('2024-01-02' || chr(9)), ('2024-01-03 12:00:00' || chr(10)), (NULL)

query I
SELECT t FROM ts ORDER BY t NULLS LAST
----
2024-01-01 00:00:00
2024-01-02 00:00:00
2024-01-03 12:00:00
NULL

statement ok
CREATE TABLE forms(name VARCHAR, s VARCHAR)

statement ok
INSERT INTO forms VALUES
	('date space', '2024-01-01 '),
	('date two spaces', '2024-01-01  '),
	('space date space', ' 2024-01-01 '),
	('date tab', '2024-01-01' || chr(9)),
	('date newline', '2024-01-01' || chr(10)),
	('date cr', '2024-01-01' || chr(13)),
	('date crlf', '2024-01-01' || chr(13) || chr(10)),
	('date vt', '2024-01-01' || chr(11)),
	('date ff', '2024-01-01' || chr(12)),
