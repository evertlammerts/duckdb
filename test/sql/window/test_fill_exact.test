query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, 340282366920938463463374607431768211453::UHUGEINT), (1, 340282366920938463463374607431768211454), (2, NULL), (3, NULL)) t(k, v) ORDER BY k
