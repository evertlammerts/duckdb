# NULL runs at both edges of a partition, and several partitions
query III
SELECT p, k, fill(v) OVER (PARTITION BY p ORDER BY k) FROM (VALUES
	(1, 0, NULL), (1, 1, NULL), (1, 2, -9223372036854775805), (1, 3, -9223372036854775804), (1, 4, NULL), (1, 5, NULL),
	(2, 0, NULL), (2, 1, 9223372036854775806), (2, 2, NULL), (2, 3, 9223372036854775807), (2, 4, NULL)) t(p, k, v)
ORDER BY p, k
----
1	0	-9223372036854775807
1	1	-9223372036854775806
1	2	-9223372036854775805
1	3	-9223372036854775804
1	4	-9223372036854775803
1	5	-9223372036854775802
2	0	9223372036854775806
2	1	9223372036854775806
2	2	9223372036854775806
2	3	9223372036854775807
2	4	NULL
