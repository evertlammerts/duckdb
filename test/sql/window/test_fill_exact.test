# name: test/sql/window/test_fill_exact.test
# description: fill() interpolates integer backed values exactly and rounds once, ties to even
# group: [window]

# gaps near the bounds of BIGINT keep every low bit
query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, -9223372036854775808), (1, NULL), (2, NULL), (3, NULL), (4, -9223372036854774808)) t(k, v) ORDER BY k
----
0	-9223372036854775808
1	-9223372036854775558
2	-9223372036854775308
3	-9223372036854775058
4	-9223372036854774808

query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, 9223372036854774807), (1, NULL), (2, NULL), (3, NULL), (4, 9223372036854775807)) t(k, v) ORDER BY k
----
0	9223372036854774807
1	9223372036854775057
2	9223372036854775307
3	9223372036854775557
4	9223372036854775807

query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, 1000000000000000001), (1, NULL), (2, NULL), (3, 1000000000000000007)) t(k, v) ORDER BY k
----
0	1000000000000000001
1	1000000000000000003
2	1000000000000000005
3	1000000000000000007

# the same gap with a descending ordering
query II
SELECT k, fill(v) OVER (ORDER BY k DESC) FROM (VALUES (0, 1000000000000000001), (1, NULL), (2, NULL), (3, 1000000000000000007)) t(k, v) ORDER BY k
----
0	1000000000000000001
1	1000000000000000003
2	1000000000000000005
3	1000000000000000007

# the same gap through an argument ordering
query II
SELECT k, fill(v ORDER BY k) OVER (ORDER BY -k) FROM (VALUES (0, 1000000000000000001), (1, NULL), (2, NULL), (3, 1000000000000000007)) t(k, v) ORDER BY k
----
0	1000000000000000001
1	1000000000000000003
2	1000000000000000005
3	1000000000000000007

query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, 2147483000), (1, NULL), (3, 2147483647)) t(k, v) ORDER BY k
----
0	2147483000
1	2147483216
3	2147483647

query II
SELECT k, fill(v::SMALLINT) OVER (ORDER BY k) FROM (VALUES (0, -32768), (1, NULL), (2, NULL), (3, -32765)) t(k, v) ORDER BY k
----
0	-32768
1	-32767
2	-32766
3	-32765

query II
SELECT k, fill(v::UBIGINT) OVER (ORDER BY k) FROM (VALUES (0, 18446744073709551000), (1, NULL), (2, NULL), (3, 18446744073709551615)) t(k, v) ORDER BY k
----
0	18446744073709551000
1	18446744073709551205
2	18446744073709551410
3	18446744073709551615

# the HUGEINT and UHUGEINT bounds
query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, (-170141183460469231731687303715884105728)::HUGEINT), (1, NULL), (2, NULL), (3, (-170141183460469231731687303715884105725)::HUGEINT)) t(k, v) ORDER BY k
----
0	-170141183460469231731687303715884105728
1	-170141183460469231731687303715884105727
2	-170141183460469231731687303715884105726
3	-170141183460469231731687303715884105725

query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, 340282366920938463463374607431768211452::UHUGEINT), (1, NULL), (2, NULL), (3, 340282366920938463463374607431768211455::UHUGEINT)) t(k, v) ORDER BY k
----
0	340282366920938463463374607431768211452
1	340282366920938463463374607431768211453
2	340282366920938463463374607431768211454
3	340282366920938463463374607431768211455

# a difference of values and of ordering keys that needs 128 bits, and their 256 bit product
query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES
	((-170141183460469231731687303715884105728)::HUGEINT, (-170141183460469231731687303715884105728)::HUGEINT),
	(-1, NULL), (0, NULL), (1, NULL),
	(170141183460469231731687303715884105727, 170141183460469231731687303715884105727)) t(k, v)
ORDER BY k
----
-170141183460469231731687303715884105728	-170141183460469231731687303715884105728
-1	-1
0	0
1	1
170141183460469231731687303715884105727	170141183460469231731687303715884105727

query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES
	((-170141183460469231731687303715884105728)::HUGEINT, 0),
	(0, NULL),
	(170141183460469231731687303715884105727, 1000)) t(k, v)
ORDER BY k
----
-170141183460469231731687303715884105728	0
0	500
170141183460469231731687303715884105727	1000

# a difference of values beyond 64 bits over small ordering steps
query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, 0::HUGEINT), (1, NULL), (2, NULL), (3, 1000000000000000000000000000000)) t(k, v) ORDER BY k
----
0	0
1	333333333333333333333333333333
2	666666666666666666666666666667
3	1000000000000000000000000000000

# a product beyond 64 bits over an ordering step beyond 32 bits
query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (TIMESTAMP '2020-01-01', 0), (TIMESTAMP '2020-01-02', NULL), (TIMESTAMP '2020-01-03 00:00:00.000001', 9000000000000000000)) t(k, v) ORDER BY k
----
2020-01-01 00:00:00	0
2020-01-02 00:00:00	4499999999973958333
2020-01-03 00:00:00.000001	9000000000000000000

# rounding to the nearest integer, ties to even
query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, 1), (1, NULL), (2, 2), (3, NULL), (4, 3), (5, NULL), (6, 4)) t(k, v) ORDER BY k
----
0	1
1	2
2	2
3	2
4	3
5	4
6	4

query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, -1), (1, NULL), (2, -2), (3, NULL), (4, -3)) t(k, v) ORDER BY k
----
0	-1
1	-2
2	-2
3	-2
4	-3

query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, 0), (1, NULL), (2, NULL), (3, 1), (4, NULL), (5, NULL), (6, -1)) t(k, v) ORDER BY k
----
0	0
1	0
2	1
3	1
4	0
5	0
6	-1

query II
SELECT k, fill(v::TINYINT) OVER (ORDER BY k) FROM (VALUES (0, -128), (1, NULL), (2, 127)) t(k, v) ORDER BY k
----
0	-128
1	0
2	127

query II
SELECT k, fill(v::UBIGINT) OVER (ORDER BY k) FROM (VALUES (0, 18446744073709551614), (1, NULL), (2, 18446744073709551615)) t(k, v) ORDER BY k
----
0	18446744073709551614
1	18446744073709551614
2	18446744073709551615

# DECIMAL values round on their scaled integer
query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, 1.0::DECIMAL(4,1)), (1, NULL), (2, 1.1), (3, NULL), (4, 1.2)) t(k, v) ORDER BY k
----
0	1.0
1	1.0
2	1.1
3	1.2
4	1.2

query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, 9999999999999999.97::DECIMAL(18,2)), (1, NULL), (2, 9999999999999999.99)) t(k, v) ORDER BY k
----
0	9999999999999999.97
1	9999999999999999.98
2	9999999999999999.99

query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, -99999999999999999999999999999.000000001::DECIMAL(38,9)), (1, NULL), (2, NULL), (3, -99999999999999999999999999999.000000007)) t(k, v) ORDER BY k
----
0	-99999999999999999999999999999.000000001
1	-99999999999999999999999999999.000000003
2	-99999999999999999999999999999.000000005
3	-99999999999999999999999999999.000000007

# DATE and TIMESTAMP values interpolate their day and microsecond counts
query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, DATE '2020-01-01'), (1, NULL), (2, NULL), (3, DATE '2020-01-04'), (4, NULL), (5, DATE '2020-01-05'), (6, NULL), (7, DATE '2020-01-06')) t(k, v) ORDER BY k
----
0	2020-01-01
1	2020-01-02
2	2020-01-03
3	2020-01-04
4	2020-01-05
5	2020-01-05
6	2020-01-05
7	2020-01-06

query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, TIMESTAMP '290000-01-01 00:00:00.000001'), (1, NULL), (2, TIMESTAMP '290000-01-01 00:00:00.000005')) t(k, v) ORDER BY k
----
0	290000-01-01 00:00:00.000001
1	290000-01-01 00:00:00.000003
2	290000-01-01 00:00:00.000005

query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, TIMESTAMP_NS '2200-01-01 00:00:00.000000001'), (1, NULL), (2, TIMESTAMP_NS '2200-01-01 00:00:00.000000003')) t(k, v) ORDER BY k
----
0	2200-01-01 00:00:00.000000001
1	2200-01-01 00:00:00.000000002
2	2200-01-01 00:00:00.000000003

# a TIMESTAMP ordering of BIGINT values
query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (TIMESTAMP '2020-01-01', 1000000000000000001), (TIMESTAMP '2020-01-02', NULL), (TIMESTAMP '2020-01-04', 1000000000000000007)) t(k, v) ORDER BY k
----
2020-01-01 00:00:00	1000000000000000001
2020-01-02 00:00:00	1000000000000000003
2020-01-04 00:00:00	1000000000000000007

# a floating ordering gives a double position, which is applied exactly
query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0.0::DOUBLE, 1000000000000000001), (0.5, NULL), (1.0, 1000000000000000003), (1.5, NULL)) t(k, v) ORDER BY k
----
0.0	1000000000000000001
0.5	1000000000000000002
1.0	1000000000000000003
1.5	1000000000000000004

query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES
	(0.0::DOUBLE, (-170141183460469231731687303715884105728)::HUGEINT),
	(1e-30, NULL),
	(1.0, 170141183460469231731687303715884105727)) t(k, v)
ORDER BY k
----
0.0	-170141183460469231731687303715884105728
1e-30	-170141183460469231731687303715543823361
1.0	170141183460469231731687303715884105727

# a floating position beyond the double mantissa, and one that overflows the double range
query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0.0::DOUBLE, 0::HUGEINT), (1.0, 1), (1e20, NULL)) t(k, v) ORDER BY k
----
0.0	0
1.0	1
1e+20	100000000000000000000

query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0.0::DOUBLE, 0), (1.0, 1), (1e20, NULL)) t(k, v) ORDER BY k
----
0.0	0
1.0	1
1e+20	NULL

query II
SELECT k, fill(w) OVER (ORDER BY k) FROM (VALUES (-1.7e308::DOUBLE, 7), (-1.6e308, 7), (1.7e308, NULL)) t(k, w) ORDER BY k
----
-1.7e+308	7
-1.6e+308	7
1.7e+308	7

query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0.0::DOUBLE, 0::BIGINT), (1.0, 3), (4503599627370497.0, NULL)) t(k, v) ORDER BY k
----
0.0	0
1.0	3
4503599627370497.0	13510798882111491

query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0.0::FLOAT, 1000000000000000001), (0.5, NULL), (1.0, 1000000000000000003)) t(k, v) ORDER BY k
----
0.0	1000000000000000001
0.5	1000000000000000002
1.0	1000000000000000003

# extrapolation is exact and NULL one step past the range of the type
query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, NULL::BIGINT), (1, -9223372036854775807), (2, -9223372036854775806), (3, NULL)) t(k, v) ORDER BY k
----
0	-9223372036854775808
1	-9223372036854775807
2	-9223372036854775806
3	-9223372036854775805

query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (-1, NULL::BIGINT), (0, NULL), (1, -9223372036854775807), (2, -9223372036854775805)) t(k, v) ORDER BY k
----
-1	NULL
0	NULL
1	-9223372036854775807
2	-9223372036854775805

query II
SELECT k, fill(v) OVER (ORDER BY k) FROM (VALUES (0, 9223372036854775805), (1, 9223372036854775806), (2, NULL), (3, NULL)) t(k, v) ORDER BY k
----
0	9223372036854775805
1	9223372036854775806
2	9223372036854775807
3	NULL

